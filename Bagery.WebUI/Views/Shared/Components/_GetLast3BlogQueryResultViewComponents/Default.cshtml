@model List<GetBlogLast4QueryResult>

<div class="sidebar-widget post-widget">
    <div class="widget-title">
        <h3>Son Yazılar</h3>
    </div>
    <div class="post-inner">
        @foreach (var item in Model)
        {
            <div class="post">
                <figure class="post-thumb">
                    <a href="/Blog/Detail/@item.Id">
                        <img src="@item.ImageUrl1" alt="@item.Title"
                             onerror="this.src='/images/default-image.png'">
                    </a>
                </figure>
                <h5><a href="/Blog/Detail/@item.Id">@item.Title</a></h5>
                <p>@item.CreatedAt.ToString("dd MMM yyyy")</p>
            </div>
        }
    </div>
</div>

<style>
    .post-widget .post h5 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
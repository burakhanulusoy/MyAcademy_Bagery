@using Bagery.WebUI.Models.PanelModels
@model PanelSidebarModel
@functions {
    // "/Writer/Blog/Index" ile "/Writer/Blog" aynı sayfa sayılsın
    static string Normalize(string path)
    {
        var p = path.TrimEnd('/');
        return p.EndsWith("/Index", StringComparison.OrdinalIgnoreCase) ? p[..^6] : p;
    }

    // "Burak Han Ulusoy" -> "BH"
    static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2)
                          .Select(p => char.ToUpper(p[0], new System.Globalization.CultureInfo("tr-TR"))));
}
@{
    var current = Normalize(Context.Request.Path.Value ?? "");
}

<aside class="pn-sidebar" aria-label="Panel menüsü">

    @* Logo da siteyi yeni sekmede açar *@
    <a class="pn-brand" href="/Default/Index" target="_blank" rel="noopener" aria-label="Siteyi yeni sekmede aç">
        <img src="~/Bagery Pack/Bagery/assets/images/logo-4.png" alt="Bagery">
    </a>

    <div class="pn-profile">
        <span class="pn-avatar">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="">
            }
            else
            {
                @Initials(Model.FullName)
            }
        </span>
        <div style="min-width: 0">
            <span class="pn-profile-name">@Model.FullName</span>
            <span class="pn-role">@Model.RoleLabel</span>
        </div>
    </div>

    <nav class="pn-nav">
        @foreach (var section in Model.Sections)
        {
            <div>
                <p class="pn-nav-title">@@section.Title</p>
                <ul>
                    @foreach (var item in section.Items)
                    {
                        var isActive = !item.NewTab && string.Equals(Normalize(item.Url), current, StringComparison.OrdinalIgnoreCase);
                        <li>
                            @* target/rel null ise Razor bu attribute'ları hiç yazmaz *@
                            <a href="@item.Url"
                               class="@(isActive ? "is-active" : "")"
                               aria-current="@(isActive ? "page" : null)"
                               target="@(item.NewTab ? "_blank" : null)"
                               rel="@(item.NewTab ? "noopener" : null)">
                                <i class='bx @item.Icon'></i> @item.Label
                                @if (item.NewTab)
                                {
                                    <i class='bx bx-link-external pn-ext' aria-label="yeni sekmede açılır"></i>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>

    <a class="pn-logout" href="/User/Logout"><i class='bx bx-log-out'></i> Çıkış yap</a>
</aside>
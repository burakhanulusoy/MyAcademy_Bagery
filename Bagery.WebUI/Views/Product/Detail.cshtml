                                    @foreach (var variant in availableVariants)
                                    {
                                        <label>
                                            <input type="radio" name="variantId" value="@variant.Id"
                                                   data-extra-price="@variant.AdditionalPrice.ToString(CultureInfo.InvariantCulture)">
                                            @variant.OptionName
                                            @if (variant.AdditionalPrice > 0)
                                            {
                                                <text>(+@variant.AdditionalPrice.ToString("N2") ₺)</text>
                                            }
                                        </label>
                                    }
                                </div>
                            </div>

@section Scripts {
    <script>
        (function () {
            const btn = document.getElementById('addToCartBtn');
            const qtyInput = document.getElementById('quantity');
            const priceEl = document.getElementById('productPrice');
            const basePrice = parseFloat(priceEl.dataset.basePrice);

            // Seçenek değişince ekrandaki fiyatı güncelle.
            // Bu SADECE görüntü; sepete eklenen fiyatı sunucu kendi hesaplıyor (Adım 4).
            document.querySelectorAll('input[name="variantId"]').forEach(radio => {
                radio.addEventListener('change', function () {
                    const total = basePrice + parseFloat(this.dataset.extraPrice || '0');
                    priceEl.textContent = total.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                });
            });

            btn.addEventListener('click', async function () {
                const quantity = parseInt(qtyInput.value, 10);
                if (!Number.isInteger(quantity) || quantity < 1) {
                    BageryCart.toast('Geçerli bir adet girin.', false);
                    return;
                }

                const selected = document.querySelector('input[name="variantId"]:checked');
                const variantId = selected ? selected.value : null; // seçenek yoksa null

                btn.disabled = true; // çift tıklamada ürün iki kez eklenmesin
                const result = await BageryCart.add(btn.dataset.productId, quantity, variantId);
                btn.disabled = false;

                // Başarılıysa mesajın yanında "Sepete git" linki çıkar
                BageryCart.toast(result.message, result.success,
                    result.success ? { href: '/Cart/Index', text: 'Sepete git' } : null);

                if (result.success) qtyInput.value = 1;
            });
        })();
    </script>
}
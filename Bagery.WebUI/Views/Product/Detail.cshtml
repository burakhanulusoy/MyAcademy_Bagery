<style>
    .single-product .product-image .image {
        margin: 0;
        background: #fff;
    }

        .single-product .product-image .image img {
            width: 100%;
            height: 520px;
            object-fit: cover;
            object-position: center;
            display: block;
        }

    .single-product .slider-pager .thumb-box li {
        margin-bottom: 20px;
    }

        .single-product .slider-pager .thumb-box li figure {
            margin: 0;
            background: #fff;
        }

        .single-product .slider-pager .thumb-box li img {
            width: 100px;
            height: 100px;
            object-fit: cover;
            object-position: center;
            display: block;
        }

    .single-product .tags.list li {

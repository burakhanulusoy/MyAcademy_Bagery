@model ShopPageResult
@{
    ViewData["Title"] = "Ürünlerimiz";
    Layout = "~/Views/Shared/_WebUILayout.cshtml";
}

<!--Page Title-->
<section class="page-title centred"
         style="background-image: url('@Url.Content("~/Bagery Pack/Bagery/assets/images/background/shop detail arka plan.png")');">
    <div class="auto-container">
        <div class="content-box">
            <div class="title">
                <h1>Ürünlerimiz</h1>
            </div>
            <ul class="bread-crumb clearfix">
                <li><a href="/">Anasayfa</a></li>
                <li>Ürünler</li>
            </ul>
        </div>
    </div>
</section>
<!--End Page Title-->
<!-- shop-page-section -->
<section class="shop-page-section shop-page-1">
    <div class="auto-container">
        <div class="row clearfix">

            <!-- SIDEBAR -->
            <div class="col-lg-3 col-md-12 col-sm-12 sidebar-side">
                <div class="shop-sidebar default-sidebar">

                    <!-- Arama -->
                    <div class="sidebar-widget sidebar-search">
                        <form action="/Product/Shop" method="get" class="search-form">
                            <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                            <input type="hidden" name="min" value="@Model.Min" />
                            <input type="hidden" name="max" value="@Model.Max" />
                            <div class="form-group">
                                <input type="search" name="search" value="@Model.Search" placeholder="Ürün ara...">
                                <button type="submit"><i class="icon-Search"></i></button>
                            </div>
                        </form>
                    </div>

                    <!-- Kategoriler -->
                    <div class="sidebar-widget sidebar-categories">
                        <div class="widget-title">
                            <h3>Kategoriler</h3>
                        </div>
                        <div class="widget-content">
                            <ul class="categories-list clearfix">
                                <li>
                                    <a href="@Url.Action("Shop", "Product", new { search = Model.Search, min = Model.Min, max = Model.Max })"
                                       class="@(Model.CategoryId == null ? "active-cat" : "")">
                                        Tüm Ürünler
                                    </a>
                                </li>
                                @foreach (var category in Model.Categories)
                                {
                                    <li>
                                        <a href="@Url.Action("Shop", "Product", new { categoryId = category.Id, search = Model.Search, min = Model.Min, max = Model.Max })"
                                           class="@(Model.CategoryId == category.Id ? "active-cat" : "")">
                                            @category.CategoryName
                                            <span class="cat-count">(@(category.Products?.Count ?? 0))</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Fiyat Filtresi -->
                    <div class="sidebar-widget price-filter">
                        <div class="widget-title">
                            <h3>Fiyata Göre Filtrele</h3>
                        </div>
                        <div class="widget-content">
                            <form action="/Product/Shop" method="get">
                                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                                <input type="hidden" name="search" value="@Model.Search" />

                                <div class="price-inputs">
                                    <input type="number" name="min" min="0" value="@Model.Min" placeholder="En az" />
                                    <span class="price-sep">—</span>
                                    <input type="number" name="max" min="0" value="@Model.Max" placeholder="En çok" />
                                </div>

                                <button type="submit" class="theme-btn-two filter-submit">Filtrele</button>

                                @if (Model.Min.HasValue || Model.Max.HasValue)
                                {
                                    <a href="@Url.Action("Shop", "Product", new { categoryId = Model.CategoryId, search = Model.Search })"
                                       class="clear-filter">Fiyat filtresini temizle</a>
                                }
                            </form>
                        </div>
                    </div>

                    @* En çok sipariş edilen 4 ürün *@
                    @await Component.InvokeAsync("_GetTopSellingProductsForShopViewComponents")

                </div>
            </div>

            <!-- İÇERİK -->
            <div class="col-lg-9 col-md-12 col-sm-12 content-side">
                <div class="our-shop">

                    @* DEĞİŞTİ: çalışmayan sıralama kutusu kaldırıldı, yerine gerçek bilgi *@
                    <div class="shop-topbar">
                        <p>
                            @if (Model.Products.Any())
                            {
                                <text>@Model.Products.Count ürün gösteriliyor</text>
                                @if (Model.TotalPages > 1)
                                {
                                    <text> · sayfa @Model.Page / @Model.TotalPages</text>
                                }
                            }
                        </p>
                        <a href="/Cart/Index" class="shop-cart-link"><i class="fas fa-shopping-bag"></i> Sepetim <span class="cart-count"></span></a>
                    </div>

                    @if (!Model.Products.Any())
                    {
                        <div class="empty-shop">
                            <h4>Aradığınız kriterlere uygun ürün bulunamadı.</h4>
                            <p>Filtreleri değiştirerek tekrar deneyebilirsiniz.</p>
                            <a href="/Product/Shop" class="theme-btn-two">Tüm Ürünleri Göster</a>
                        </div>
                    }
                    else
                    {
                        @* DEĞİŞTİ: kartlar eşit boyda, listeden sepete ekleme var *@
                        <div class="row clearfix shop-grid" id="shopGrid">
                            @foreach (var product in Model.Products)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-12 shop-block">
                                    <div class="shop-card">
                                        <a class="shop-card-image" href="/Product/Detail/@product.Id">
                                            <img src="@product.MainImageUrl" alt="@product.ProductName" loading="lazy">
                                        </a>

                                        <div class="shop-card-body">
                                            @if (product.Category is not null)
                                            {
                                                <span class="shop-card-cat">@product.Category.CategoryName</span>
                                            }

                                            <h3><a href="/Product/Detail/@product.Id">@product.ProductName</a></h3>
                                            <span class="shop-card-price">@product.Price.ToString("N2") ₺</span>

                                            <div class="shop-card-actions">
                                                @* Standart haliyle sepete ekler; seçenek isteyen ürün sayfasına gider *@
                                                <button type="button" class="theme-btn-one shop-add" data-product="@product.Id">
                                                    <i class="fas fa-shopping-bag"></i> Sepete ekle
                                                </button>
                                                <a href="/Product/Detail/@product.Id" class="shop-card-link">Seçenekler</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (Model.TotalPages > 1)
                        {
                            <div class="pagination-wrapper centred">
                                <ul class="pagination">
                                    @if (Model.Page > 1)
                                    {
                                        <li>
                                            <a href="@Url.Action("Shop", "Product", new { categoryId = Model.CategoryId, search = Model.Search, min = Model.Min, max = Model.Max, page = Model.Page - 1 })">Önceki</a>
                                        </li>
                                    }

                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        <li>
                                            <a href="@Url.Action("Shop", "Product", new { categoryId = Model.CategoryId, search = Model.Search, min = Model.Min, max = Model.Max, page = i })"
                                               class="@(i == Model.Page ? "active" : "")">@i</a>
                                        </li>
                                    }

                                    @if (Model.Page < Model.TotalPages)
                                    {
                                        <li>
                                            <a href="@Url.Action("Shop", "Product", new { categoryId = Model.CategoryId, search = Model.Search, min = Model.Min, max = Model.Max, page = Model.Page + 1 })">Sonraki</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    }

                </div>
            </div>

        </div>
    </div>
</section>
<!-- shop-page-section end -->

<style>
    /* ---------- Sidebar ---------- */
    .categories-list a.active-cat {
        font-weight: 700;
    }

    .cat-count {
        opacity: .55;
        font-size: 13px;
        margin-left: 4px;
    }

    .price-inputs {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .price-inputs input {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #e6e6e6;
            border-radius: 5px;
            font-size: 14px;
        }

    .price-sep {
        opacity: .5;
    }

    .filter-submit {
        width: 100%;
        margin-top: 14px;
    }

    .clear-filter {
        display: block;
        margin-top: 10px;
        font-size: 13px;
        text-decoration: underline;
    }

    .empty-shop {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-shop .theme-btn-two {
            margin-top: 16px;
        }

    /* ---------- Üst çubuk ---------- */
    .shop-topbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 26px;
    }

        .shop-topbar p {
            margin: 0;
            color: #848484;
            font-size: 15px;
        }

    .shop-cart-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border: 1px solid #e3a087;
        border-radius: 999px;
        color: #2b3c6b;
        font-weight: 700;
        font-size: 14px;
    }

        .shop-cart-link:hover {
            background: #e3a087;
            color: #fff;
        }

    /* ---------- Ürün kartı: hepsi aynı boyda ---------- */
    .shop-grid {
        display: flex;
        flex-wrap: wrap;
    }
    /* satırdaki kartlar eşit yükseklikte */
    .shop-block {
        display: flex;
        margin-bottom: 30px;
    }

    .shop-card {
        display: flex;
        flex-direction: column;
        width: 100%;
        overflow: hidden;
        border: 1px solid #efe7e3;
        border-radius: 16px;
        background: #fff;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .shop-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 34px rgba(43, 60, 107, .12);
        }

    /* Fotoğraflar: sabit oran, kırpılarak yerleşir -> hepsi aynı boyda */
    .shop-card-image {
        display: block;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: #fcf5f3;
    }

        .shop-card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .35s ease;
        }

    .shop-card:hover .shop-card-image img {
        transform: scale(1.05);
    }

    .shop-card-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 6px;
        padding: 18px 20px 20px;
    }

    .shop-card-cat {
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #e3a087;
    }

    .shop-card-body h3 {
        margin: 0;
        font-size: 19px;
        line-height: 1.35;
    }

        .shop-card-body h3 a {
            color: #2b3c6b;
        }

            .shop-card-body h3 a:hover {
                color: #cf7f62;
            }
        /* Uzun ürün adları iki satırda kesilir, kart boyu kaymaz */
        .shop-card-body h3 a {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

    .shop-card-price {
        font-size: 22px;
        font-weight: 700;
        color: #2b3c6b;
        font-variant-numeric: tabular-nums;
    }

    .shop-card-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: auto;
        padding-top: 14px;
    }

        .shop-card-actions .theme-btn-one {
            flex: 1;
            padding: 11px 16px;
            font-size: 14px;
            text-align: center;
            cursor: pointer;
            border: none;
        }

            .shop-card-actions .theme-btn-one i {
                margin-right: 6px;
            }

            .shop-card-actions .theme-btn-one[disabled] {
                opacity: .65;
                cursor: wait;
            }

    .shop-card-link {
        flex-shrink: 0;
        font-size: 13.5px;
        font-weight: 700;
        color: #848484;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

        .shop-card-link:hover {
            color: #2b3c6b;
        }

    @@media (prefers-reduced-motion: reduce) {
        .shop-card, .shop-card-image img {
            transition: none;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            const grid = document.getElementById('shopGrid');
            if (!grid) return;

            // Tek dinleyici: bütün kartların "Sepete ekle" butonları
            grid.addEventListener('click', async function (e) {
                const button = e.target.closest('.shop-add');
                if (!button) return;

                const original = button.innerHTML;
                button.disabled = true;                       // çift tıklamada iki kez eklenmesin
                button.textContent = 'Ekleniyor...';

                // Seçenek seçilmediği için standart hali eklenir (fiyatı sunucu hesaplar)
                const result = await BageryCart.add(button.dataset.product, 1, null);

                BageryCart.toast(result.message, result.success,
                    result.success ? { href: '/Cart/Index', text: 'Sepete git' } : null);

                button.disabled = false;
                button.innerHTML = original;
            });
        })();
    </script>
}
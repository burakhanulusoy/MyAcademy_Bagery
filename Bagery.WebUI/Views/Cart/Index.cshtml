<style>

    .bg-dialog {
        padding: 0;
        border: 0;
        background: transparent;
        width: min(900px, 94vw);
        max-width: 900px;
        margin: auto;
        overflow: visible;
    }


        .bg-dialog::backdrop {
            background: rgba(16, 22, 38, .72);
            backdrop-filter: blur(6px);
        }


        .bg-dialog[open] {
            display: grid;
            place-items: center;
        }



    /* ANA KART */

    .login-card {
        position: relative;
        width: 100%;
        min-height: 520px;
        display: grid;
        grid-template-columns: 42% 58%;
        overflow: hidden;
        border-radius: 26px;
        background: #fff;
        box-shadow: 0 40px 100px rgba(15, 24, 45, .32);
    }



    /* KAPAT */

    .login-close {
        position: absolute;
        top: 18px;
        right: 18px;
        z-index: 20;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: #f6f3f1;
        color: #777;
        cursor: pointer;
        transition: .25s;
    }


        .login-close:hover {
            background: #253A6B;
            color: #fff;
            transform: rotate(90deg);
        }



    /* ==================================
           PIXEL ART TARAFI
        ================================== */

    .login-art {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 38px 28px 28px;
        background: #F2BDA8;
        overflow: hidden;
    }


        /* PIXEL GRID */

        .login-art::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient( rgba(255,255,255,.08) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.08) 1px, transparent 1px );
            background-size: 12px 12px;
            pointer-events: none;
        }



    .pixel-logo {
        position: relative;
        z-index: 3;
        align-self: flex-start;
        padding: 8px 13px;
        margin-bottom: 2px;
        background: #253A6B;
        color: #fff;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 4px;
        box-shadow: 6px 6px 0 #CF7455;
    }



    .pixel-scene {
        position: relative;
        z-index: 2;
        display: block;
        width: 100%;
        max-width: 330px;
        margin: 0 auto;
        image-rendering: pixelated;
        filter: drop-shadow( 0 18px 22px rgba(92, 48, 32, .14) );
    }



    .pixel-copy {
        position: relative;
        z-index: 3;
        color: #253A6B;
        margin-top: 2px;
    }


        .pixel-copy strong {
            display: block;
            font-size: 20px;
            line-height: 1.35;
            margin-bottom: 5px;
        }


        .pixel-copy span {
            display: block;
            font-size: 13px;
            line-height: 1.6;
            opacity: .78;
        }



    /* ==================================
           SAĞ TARAF
        ================================== */

    .login-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 56px 58px 38px;
    }



    .login-kicker {
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 16px;
        color: #D37D5C;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }



    .login-content h2 {
        margin: 0 0 18px;
        color: #253A6B;
        font-size: 48px;
        font-weight: 800;
        line-height: 1.04;
    }



    .login-description {
        max-width: 430px;
        margin: 0 0 27px;
        color: #697591;
        font-size: 15px;
        line-height: 1.8;
    }



    /* AVANTAJLAR */

    .login-benefits {
        display: grid;
        gap: 14px;
        margin-bottom: 29px;
    }



    .login-benefit {
        display: flex;
        align-items: center;
        gap: 13px;
    }



    .benefit-icon {
        flex: 0 0 40px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #FFF1EB;
        color: #D37D5C;
        font-size: 13px;
    }



    .login-benefit strong {
        display: block;
        margin-bottom: 3px;
        color: #253A6B;
        font-size: 14px;
    }



    .login-benefit div > span {
        display: block;
        color: #8C95AA;
        font-size: 12px;
        line-height: 1.4;
    }



    /* GİRİŞ BUTONU */

    .login-primary {
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 22px;
        border-radius: 12px;
        background: #E59A7E;
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        box-shadow: 0 13px 30px rgba(229, 154, 126, .30);
        transition: .25s;
    }


        .login-primary:hover {
            color: #fff;
            background: #253A6B;
            transform: translateY(-2px);
        }


        .login-primary i {
            transition: .25s;
        }


        .login-primary:hover i {
            transform: translateX(5px);
        }



    /* KAYIT */

    .login-register {
        display: block;
        margin-top: 17px;
        text-align: center;
        color: #7C859A;
        font-size: 13px;
    }


        .login-register strong {
            margin-left: 3px;
            color: #253A6B;
        }


        .login-register:hover strong {
            color: #D37D5C;
        }



    /* GÜVENLİK */

    .login-security {
        margin-top: 27px;
        padding-top: 17px;
        border-top: 1px solid #ECEFF4;
        text-align: center;
        color: #9AA1B1;
        font-size: 11px;
    }


        .login-security i {
            margin-right: 6px;
            color: #3FA16A;
        }



    /* ==================================
           TABLET / MOBİL
        ================================== */

    @@media (max-width: 767px) {

        .bg-dialog {
            width: min(94vw, 520px);
        }


        .login-card {
            display: block;
            max-height: 92vh;
            overflow-y: auto;
            border-radius: 20px;
        }


        .login-art {
            min-height: 250px;
            padding: 25px 28px 18px;
        }


        .pixel-logo {
            margin-bottom: -10px;
        }


        .pixel-scene {
            max-width: 260px;
            margin: -10px auto -22px;
        }


        .pixel-copy {
            display: none;
        }


        .login-content {
            padding: 32px 25px 25px;
        }


            .login-content h2 {
                font-size: 36px;
            }


        .login-description {
            line-height: 1.65;
        }
    }

</style>



@section Scripts {

    <script>

        (function () {

            const cartApi =
                window.BageryCart;


            const fp =
                cartApi.formatPrice;


            const esc =
                cartApi.escapeHtml;


            const freeShippingLimit =
                @Cart.FreeShippingLimit.ToString(
                    CultureInfo.InvariantCulture
                        );



        /* ==================================
           SEPETİ EKRANA BAS
        ================================== */

        function render(cart) {

            const isEmpty =
                !cart ||
                cart.items.length === 0;


            document
                .getElementById('cartEmpty')
                .hidden = !isEmpty;


            document
                .getElementById('cartContent')
                .hidden = isEmpty;


            if (isEmpty)
                return;



            document
                .getElementById('itemCount')
                .textContent =
                cart.totalQuantity +
                ' ürün';



            /* ÜRÜNLER */

            document
                .getElementById('cartRows')
                .innerHTML =
                cart.items
                    .map(item => {


                        const key =
                            `data-product="${item.productId}"
                             data-variant="${item.variantId ?? ''}"`;


                        const variant =
                            item.variantName
                                ? `<span class="bg-item-variant">
                                       ${esc(item.variantName)}
                                   </span>`
                                : '';


                        return `

                            <article class="bg-item">

                                <a class="bg-item-img"
                                   href="/Product/Detail/${item.productId}">

                                    <img src="${esc(item.imageUrl)}"
                                         alt="">

                                </a>


                                <div class="bg-item-info">

                                    <a class="bg-item-name"
                                       href="/Product/Detail/${item.productId}">

                                        ${esc(item.productName)}

                                    </a>


                                    ${variant}


                                    <span class="bg-item-unit">

                                        ${fp(item.unitPrice)}
                                        / adet

                                    </span>

                                </div>


                                <div class="bg-qty">

                                    <button type="button"
                                            class="js-decrease"
                                            ${key}
                                            aria-label="Azalt">

                                        <i class="fas fa-minus"></i>

                                    </button>


                                    <span>
                                        ${item.quantity}
                                    </span>


                                    <button type="button"
                                            class="js-increase"
                                            ${key}
                                            aria-label="Artır">

                                        <i class="fas fa-plus"></i>

                                    </button>

                                </div>


                                <strong class="bg-item-total">

                                    ${fp(item.lineTotal)}

                                </strong>


                                <button type="button"
                                        class="bg-item-remove js-remove"
                                        ${key}
                                        aria-label="Sepetten çıkar">

                                    <i class="fas fa-times"></i>

                                </button>

                            </article>

                        `;

                    })
                    .join('');



            /* KARGO */

            const free =
                cart.shippingPrice === 0;


            const percent =
                Math.min(
                    cart.subTotal /
                    freeShippingLimit *
                    100,
                    100
                );


            document
                .getElementById('shipBox')
                .classList
                .toggle(
                    'is-free',
                    free
                );


            document
                .getElementById('shipBar')
                .style
                .width =
                (free ? 100 : percent) +
                '%';



            document
                .getElementById('shipText')
                .innerHTML =
                free
                    ? '<strong>Kargonuz ücretsiz.</strong>'
                    : `Ücretsiz kargo için
                       <strong>
                           ${fp(
                               Math.max(
                                   freeShippingLimit -
                                   cart.subTotal,
                                   0.01
                               )
                           )}
                       </strong>
                       daha ekleyin.`;



            /* FİYATLAR */

            document
                .getElementById('subTotal')
                .textContent =
                fp(cart.subTotal);


            document
                .getElementById('shipping')
                .textContent =
                free
                    ? 'Ücretsiz'
                    : fp(cart.shippingPrice);


            document
                .getElementById('paidPrice')
                .textContent =
                fp(cart.paidPrice);



            /* KUPON */

            const hasCoupon =
                !!cart.couponCode;


            document
                .getElementById('discountRow')
                .hidden =
                !hasCoupon;


            document
                .getElementById('discount')
                .textContent =
                '−' +
                fp(cart.couponDiscount);


            document
                .getElementById('couponForm')
                .hidden =
                hasCoupon;


            document
                .getElementById('couponApplied')
                .hidden =
                !hasCoupon;


            document
                .getElementById('couponCodeText')
                .textContent =
                cart.couponCode || '';

        }



        /* API */

        async function run(promise) {

            const result =
                await promise;


            if (
                result.success ===
                false
            ) {

                cartApi.toast(
                    result.message,
                    false
                );

                return;
            }


            if (result.message) {

                cartApi.toast(
                    result.message,
                    true
                );

            }


            render(result.cart);

        }



        /* ÜRÜN BUTONLARI */

        document
            .getElementById('cartRows')
            .addEventListener(
                'click',
                function (e) {

                    const btn =
                        e.target.closest(
                            'button[data-product]'
                        );


                    if (!btn)
                        return;


                    const productId =
                        btn.dataset.product;


                    const variantId =
                        btn.dataset.variant ||
                        null;



                    if (
                        btn.classList
                            .contains(
                                'js-increase'
                            )
                    ) {

                        run(
                            cartApi.add(
                                productId,
                                1,
                                variantId
                            )
                        );

                    }

                    else if (
                        btn.classList
                            .contains(
                                'js-decrease'
                            )
                    ) {

                        run(
                            cartApi.decrease(
                                productId,
                                variantId
                            )
                        );

                    }

                    else if (
                        btn.classList
                            .contains(
                                'js-remove'
                            )
                    ) {

                        run(
                            cartApi.remove(
                                productId,
                                variantId
                            )
                        );

                    }

                }
            );



        /* KUPON */

        const couponInput =
            document
                .getElementById(
                    'couponInput'
                );


        document
            .getElementById(
                'applyCouponBtn'
            )
            .addEventListener(
                'click',
                function () {

                    const code =
                        couponInput
                            .value
                            .trim();


                    if (!code) {

                        cartApi.toast(
                            'Kupon kodunu yazın.',
                            false
                        );

                        return;
                    }


                    run(
                        cartApi.applyCoupon(
                            code
                        )
                    );


                    couponInput.value =
                        '';

                }
            );



        couponInput
            .addEventListener(
                'keydown',
                function (e) {

                    if (
                        e.key ===
                        'Enter'
                    ) {

                        document
                            .getElementById(
                                'applyCouponBtn'
                            )
                            .click();

                    }

                }
            );



        document
            .getElementById(
                'removeCouponBtn'
            )
            .addEventListener(
                'click',
                function () {

                    run(
                        cartApi
                            .removeCoupon()
                    );

                }
            );



        /* ==================================
           LOGIN POPUP
        ================================== */

        const loginDialog =
            document
                .getElementById(
                    'loginDialog'
                );


        if (loginDialog) {

            document
                .getElementById(
                    'goCheckout'
                )
                .addEventListener(
                    'click',
                    function (e) {

                        e.preventDefault();

                        loginDialog
                            .showModal();

                    }
                );



            loginDialog
                .addEventListener(
                    'click',
                    function (e) {

                        if (
                            e.target ===
                            loginDialog ||
                            e.target.closest(
                                '[data-close]'
                            )
                        ) {

                            loginDialog
                                .close();

                        }

                    }
                );

        }



        /* İLK YÜKLEME */

        run(
            cartApi.get()
        );

    })();

</script>

}
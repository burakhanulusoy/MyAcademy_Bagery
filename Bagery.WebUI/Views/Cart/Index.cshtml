@using Bagery.WebUI.Models.CartModels
@using System.Globalization

@{
    ViewData["Title"] = "Sepetim";
    Layout = "~/Views/Shared/_WebUILayout.cshtml";
}


<!-- SAYFA BAŞLIĞI -->
<section class="page-title centred"
         style="background-image: url('@Url.Content("~/Bagery Pack/Bagery/assets/images/background/shop detail arka plan.png")');">

    <div class="auto-container">

        <div class="content-box">

            <div class="title">
                <h1>Sepetim</h1>
            </div>

        </div>

    </div>

</section>



<section class="bg-shop bg-cart">

    <div class="auto-container">


        <!-- ADIMLAR -->
        <ol class="bg-steps" aria-label="Sipariş adımları">

            <li class="is-current">
                <span class="num">1</span>
                <span>Sepet</span>
            </li>

            <li>
                <span class="num">2</span>
                <span>Ödeme</span>
            </li>

            <li>
                <span class="num">3</span>
                <span>Onay</span>
            </li>

        </ol>



        <!-- SEPET BOŞ -->
        <div id="cartEmpty" class="bg-empty" hidden>

            <div class="bg-empty-icon">
                <i class="fas fa-shopping-basket"></i>
            </div>

            <h2>Sepetiniz boş</h2>

            <p>
                Taze ürünlerimize göz atın,
                beğendiklerinizi sepete ekleyin.
            </p>

            <a href="/Product/Shop"
               class="bg-btn bg-btn-inline">

                Mağazaya git

            </a>

        </div>



        <!-- SEPET DOLU -->
        <div id="cartContent"
             class="bg-layout"
             hidden>


            <!-- ÜRÜNLER -->
            <div class="bg-panel">

                <div class="bg-panel-head">

                    <h2 class="bg-panel-title">
                        Sepetim
                    </h2>

                    <span class="bg-count"
                          id="itemCount">
                    </span>

                </div>


                <div id="cartRows"
                     class="bg-items">
                </div>


                <a href="/Product/Shop"
                   class="bg-link-back">

                    <i class="fas fa-arrow-left"></i>

                    Alışverişe devam et

                </a>

            </div>



            <!-- SİPARİŞ ÖZETİ -->
            <aside class="bg-panel bg-summary">

                <h2 class="bg-panel-title">
                    Sipariş özeti
                </h2>



                <!-- KARGO -->
                <div class="bg-ship"
                     id="shipBox">

                    <p id="shipText"></p>

                    <div class="bg-ship-track">
                        <span id="shipBar"></span>
                    </div>

                </div>



                <!-- KUPON -->
                <div class="bg-coupon">

                    <div class="bg-coupon-row"
                         id="couponForm">

                        <input type="text"
                               id="couponInput"
                               placeholder="Kupon kodu"
                               autocomplete="off"
                               aria-label="Kupon kodu">

                        <button type="button"
                                id="applyCouponBtn">
                            Uygula
                        </button>

                    </div>


                    <div class="bg-coupon-applied"
                         id="couponApplied"
                         hidden>

                        <span>

                            <i class="fas fa-tag"></i>

                            <strong id="couponCodeText"></strong>

                            uygulandı

                        </span>


                        <button type="button"
                                id="removeCouponBtn">

                            Kaldır

                        </button>

                    </div>


                    @await Component.InvokeAsync("_ActiveCouponsViewComponents")

                </div>



                <!-- FİYATLAR -->
                <dl class="bg-totals">

                    <div>
                        <dt>Ara toplam</dt>
                        <dd id="subTotal"></dd>
                    </div>


                    <div id="discountRow" hidden>

                        <dt>İndirim</dt>

                        <dd id="discount"
                            class="is-discount">
                        </dd>

                    </div>


                    <div>
                        <dt>Kargo</dt>
                        <dd id="shipping"></dd>
                    </div>


                    <div class="bg-grand">

                        <dt>Toplam</dt>

                        <dd id="paidPrice"></dd>

                    </div>

                </dl>



                <!-- ÖDEME -->
                <a href="/Payment/Checkout"
                   id="goCheckout"
                   class="bg-btn">

                    Ödemeye geç

                    <i class="fas fa-arrow-right"></i>

                </a>


                <p class="bg-trust">

                    <i class="fas fa-lock"></i>

                    Ödemeler PayTR altyapısıyla,
                    3D Secure doğrulamasıyla alınır.

                </p>


            </aside>

        </div>

    </div>




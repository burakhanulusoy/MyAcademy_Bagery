@model GetBlogByIdQueryResult
@{
    ViewData["Title"] = @Model.Title;
    Layout = "~/Views/Shared/_WebUILayout.cshtml";
}


<!-- blog-post -->
<section class="blog-post centred" style="background-image: url('@Model.BackgroundImageUrl');">
    <div class="post-inner">
        <span class="category">Blog</span>
        <h2>@Model.Title</h2>
        <ul class="post-info clearfix">
            <li>@Model.CreatedAt.ToString("dd MMMM yyyy")</li>
            <li>/</li>
            <li><a href="javascript:;">@(Model.AppUser?.FullName ?? "Editör")</a></li>
        </ul>
    </div>
</section>
<!-- blog-post end -->
<!-- sidebar-page-container -->
<section class="sidebar-page-container sec-pad-2 blog-details">
    <div class="auto-container">
        <div class="row clearfix">
            <div class="col-lg-8 col-md-12 col-sm-12 content-side">
                <div class="blog-details-content">
                    <div class="inner-box">
                        <div class="text">
                            <p>@Model.MainDescription</p>
                        </div>
                        <blockquote>
                            <i class="icon-Quote"></i>
                            <p>@Model.ShortDescription</p>
                        </blockquote>
                        <div class="two-column">
                            <div class="row clearfix">
                                <div class="col-lg-6 col-md-6 col-sm-12 text-column">
                                    <div class="text">
                                        <h3>@Model.LongTitle</h3>
                                        <p class="pre-line">@Model.LongDescription</p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 image-column">
                                    <figure class="image">
                                        <img src="@Model.ImageUrl1" alt="@Model.Title">
                                    </figure>
                                </div>
                            </div>
                        </div>
                        <div class="text">
                            <h3>@Model.LastDescriptionTitle</h3>
                            <p>@Model.LastDescription</p>
                        </div>
                    </div>
                    <div class="post-share-option clearfix">
                        <div class="text pull-left"><h3>We Are Social On:</h3></div>
                        <ul class="social-links pull-right clearfix">
                            @if (!string.IsNullOrWhiteSpace(Model.AppUser?.FacebookUrl))
                            {
                                <li>
                                    <a href="@Model.AppUser.FacebookUrl" target="_blank" rel="noopener">
                                        <i class="fab fa-facebook-f"></i>
                                    </a>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.AppUser?.TwitterUrl))
                            {
                                <li>
                                    <a href="@Model.AppUser.TwitterUrl" target="_blank" rel="noopener">
                                        <i class="fab fa-twitter"></i>
                                    </a>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.AppUser?.InstagramUrl))
                            {
                                <li>
                                    <a href="@Model.AppUser.InstagramUrl" target="_blank" rel="noopener">
                                        <i class="fab fa-instagram"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>


                    @await Component.InvokeAsync("_GetCommentsByBlogIdViewComponents", new { blogId = Model.Id })
                    @await Component.InvokeAsync("_CreateCommentViewComponents", new { blogId = Model.Id })
                </div>
            </div>


            <div class="col-lg-4 col-md-12 col-sm-12 sidebar-side">
                <div class="blog-sidebar default-sidebar">
                    <div class="sidebar-widget search-widget">
                        <div class="widget-title">
                            <h3>Search</h3>
                        </div>
                        <div class="widget-content">
                            <form action="blog-details.html" method="post" class="search-form">
                                <div class="form-group">
                                    <input type="search" name="search-field" placeholder="Search" required="">
                                    <button type="submit"><i class="fas fa-search"></i></button>
                                </div>
                            </form>
                        </div>
                    </div>
                    @await Component.InvokeAsync("_GetCategoriesWithProductCountQueryResultViewComponets")
                    @await Component.InvokeAsync("_GetLast3BlogQueryResultViewComponents")
                   
                </div>
            </div>
        </div>
    </div>
</section>
<!-- sidebar-page-container end -->

<style>
    .pre-line {
        white-space: pre-line;
    }

    .blog-details .two-column .image-column .image img {
        width: 100%;
        height: 100%;
        max-height: 460px;
        object-fit: cover;
    }
</style>
        <span class="bs-sr" id="bsAnnouncement" role="status" aria-live="polite"></span>
    </main>
    <script>
        (() => {
            'use strict';

            const root = document.getElementById('bagerySense');
            if (!root) return;

            const $ = id => document.getElementById(id);
            const form = $('aiForm');
            const input = $('aiInput');
            const chat = $('chat');
            const conversation = $('bsConversation');
            const welcome = $('welcome');
            const send = $('sendButton');
            const reset = $('newChatButton');
            const scene = $('bsScene');
            const motionButton = $('bsMotion');
            const announcement = $('bsAnnouncement');
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            const money = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' });
            const guidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
            const offTopicMessage = "Ben Bagery'nin dijital baristasıyım. Yalnızca Bagery, ürünlerimiz ve kafe deneyimin hakkında yardımcı olabilirim.";

            let busy = false;
            let requestId = 0;
            let activeController = null;
            let idleTimer = null;
            let motionEnabled = !reducedMotion.matches;
            let pointerFrame = null;
            let followLatest = true;

            // Mevcut sözleşme korunur: POST /BageryAi/Ask, { message }.
            const endpoint = root.dataset.endpoint;
            const productEndpoint = root.dataset.productUrl;
            const baseUrl = new URL(root.dataset.baseUrl, document.baseURI);

            const states = {
                idle: ['Tanışalım mı?', 'Bir fincan iyi fikir.'],
                listening: ['Tercihini anlatabilirsin.', 'Ben buradayım.'],
                thinking: ['Önerin hazırlanıyor…', 'Biraz kahve, biraz düşünce.'],
                success: ['Seçimlerin hazır.', 'Tam sana göre.'],
                answered: ['Yanıtın hazır.', 'Güzel bir soru.'],
                guard: ['Bagery hakkında devam edelim.', 'Kahveye dönelim mi?'],
                error: ['Bağlantı kurulamadı.', 'Birazdan yeniden deneyelim.']
            };

            function element(tag, className = '', text = '') {
                const result = document.createElement(tag);
                if (className) result.className = className;
                if (text) result.textContent = text;
                return result;
            }

            function icon(name) {
                const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
                svg.setAttribute('class', 'bs-icon');
                svg.setAttribute('aria-hidden', 'true');
                use.setAttribute('href', '#bs-i-' + name);
                svg.append(use);
                return svg;
            }

            function setState(state) {
                clearTimeout(idleTimer);
                const texts = states[state] || states.idle;
                root.dataset.state = state;
                $('bsStudioStatus').textContent = texts[0];
                $('bsBubble').textContent = texts[1];
            }

            function settleLater() {
                idleTimer = setTimeout(() => {
                    if (!busy) setState(input.value.trim() ? 'listening' : 'idle');
                }, 4800);
            }

            function setMotion(enabled) {
                motionEnabled = enabled && !reducedMotion.matches;
                root.dataset.motion = motionEnabled ? 'on' : 'off';
                motionButton.setAttribute('aria-pressed', String(!motionEnabled));
                const label = motionEnabled ? 'Animasyonları duraklat' :
                    (reducedMotion.matches ? 'Cihazının azaltılmış hareket tercihi etkin' : 'Animasyonları başlat');
                motionButton.setAttribute('aria-label', label);
                motionButton.title = label;
                motionButton.replaceChildren(icon(motionEnabled ? 'pause' : 'play'));
                if (!motionEnabled) resetLook();
            }

            function resetLook() {
                ['--head-x', '--head-y', '--head-r', '--eye-x', '--eye-y'].forEach(name => root.style.removeProperty(name));
            }

            function scrollBottom(force = false) {
                if (!force && !followLatest) return;
                requestAnimationFrame(() => chat.scrollTo({ top: chat.scrollHeight, behavior: motionEnabled ? 'smooth' : 'auto' }));
            }

            function resizeInput() {
                input.style.height = '44px';
                input.style.height = Math.min(input.scrollHeight, 120) + 'px';
                send.disabled = !busy && !input.value.trim();
            }

            function setBusy(value) {
                busy = value;
                input.readOnly = value;
                input.setAttribute('aria-busy', String(value));
                send.replaceChildren(icon(value ? 'stop' : 'send'));
                const label = value ? 'Yanıtı beklemeyi durdur' : 'Mesajı gönder';
                send.setAttribute('aria-label', label);
                send.title = label;
                root.querySelectorAll('[data-prompt], [data-retry]').forEach(button => { button.disabled = value; });
                resizeInput();
            }

            // AI/ürün metni HTML olarak çalıştırılmaz; yalnızca düğümler ve metin eklenir.
            function appendInline(parent, text) {
                const parts = text.split(/(\*\*[^*]+\*\*)/g);
                parts.forEach(part => {
                    if (part.startsWith('**') && part.endsWith('**') && part.length > 4) {
                        parent.append(element('strong', '', part.slice(2, -2)));
                    } else {
                        parent.append(document.createTextNode(part));
                    }
                });
            }

            function formatMessage(parent, text) {
                let list = null;
                text.replace(/\r\n/g, '\n').split('\n').forEach(line => {
                    const trimmed = line.trim();
                    if (!trimmed) { list = null; return; }
                    const item = trimmed.match(/^(?:[-*•]\s+|\d+[.)]\s+)(.+)$/);
                    if (item) {
                        const tag = /^\d/.test(trimmed) ? 'ol' : 'ul';
                        if (!list || list.tagName.toLowerCase() !== tag) {
                            list = element(tag);
                            parent.append(list);
                        }
                        const li = element('li');
                        appendInline(li, item[1]);
                        list.append(li);
                        return;
                    }
                    list = null;
                    const heading = trimmed.match(/^#{1,4}\s+(.+)$/);
                    const block = element(heading ? 'h4' : 'p');
                    appendInline(block, heading ? heading[1] : trimmed);
                    parent.append(block);
                });
            }

            function addUserMessage(message) {
                const row = element('div', 'bs-turn bs-turn-user');
                row.append(element('div', 'bs-user-message', message));
                conversation.append(row);
                scrollBottom(true);
            }

            function addAnswer(message, kind = '') {
                const row = element('div', 'bs-turn bs-turn-ai');
                const meta = element('div', 'bs-answer-meta');
                meta.append(icon('spark'), document.createTextNode('Bagery Sense'));
                const body = element('div', 'bs-answer-text' + (kind ? ' bs-' + kind + '-note' : ''));
                formatMessage(body, message);
                row.append(meta, body);
                conversation.append(row);
                return row;
            }

            function addThinking() {
                const row = element('div', 'bs-turn bs-thinking');
                const dots = element('span', 'bs-thinking-dots');
                dots.setAttribute('aria-hidden', 'true');
                dots.append(element('i'), element('i'), element('i'));
                row.append(dots, element('span', '', 'Sana uygun seçimleri buluyorum…'));
                conversation.append(row);
                announcement.textContent = 'Bagery Sense yanıt hazırlıyor.';
                scrollBottom(true);
                return row;
            }

            function productText(value) {
                if (typeof value !== 'string') return '';
                return value.replace(/<\/(?:p|div|li)>/gi, '\n').replace(/<[^>]*>/g, '')
                    .replace(/&nbsp;/gi, ' ').replace(/&amp;/gi, '&').replace(/&quot;/gi, '"')
                    .replace(/&#39;/gi, "'").replace(/&lt;/gi, '<').replace(/&gt;/gi, '>').trim();
            }

            function safeImageUrl(value) {
                if (typeof value !== 'string' || !value.trim()) return null;
                try {
                    const raw = value.trim().replace(/\\/g, '/');
                    const url = new URL(raw.startsWith('~/') ? raw.slice(2) : raw, baseUrl);
                    return ['http:', 'https:'].includes(url.protocol) ? url.href : null;
                } catch { return null; }
            }

            function renderProducts(products, parent) {
                const selected = products.filter(p => p && typeof p.productName === 'string' && guidPattern.test(p.id));
                if (!selected.length) return false;
                const grid = element('div', 'bs-products');
                selected.forEach((product, index) => {
                    const card = element('article', 'bs-product');
                    card.style.animationDelay = Math.min(index * 80, 640) + 'ms';
                    const visual = element('div', 'bs-product-visual');
                    visual.append(icon('cup'));
                    const url = safeImageUrl(product.mainImageUrl);
                    if (url) {
                        const image = element('img');
                        image.alt = product.productName;
                        image.loading = 'lazy';
                        image.decoding = 'async';
                        image.addEventListener('error', () => image.remove(), { once: true });
                        image.src = url;
                        visual.append(image);
                    }
                    visual.append(element('span', 'bs-product-no', String(index + 1).padStart(2, '0')));
                    const info = element('div', 'bs-product-info');
                    info.append(element('span', 'bs-product-category', product.category?.categoryName || 'Bagery'));
                    info.append(element('h3', 'bs-product-name', product.productName));
                    const description = productText(product.description);
                    if (description) info.append(element('p', 'bs-product-description', description));
                    const bottom = element('div', 'bs-product-bottom');
                    const hasPrice = product.price !== null && product.price !== undefined && product.price !== '' &&
                        Number.isFinite(Number(product.price)) && Number(product.price) >= 0;
                    bottom.append(element('span', 'bs-product-price', hasPrice ? money.format(Number(product.price)) : 'Fiyatı incele'));
                    const link = element('a', 'bs-product-link', 'İncele');
                    const detailUrl = new URL(productEndpoint, document.baseURI);
                    detailUrl.searchParams.set('id', product.id);
                    link.href = detailUrl.href;
                    link.setAttribute('aria-label', product.productName + ' ürününü incele');
                    link.append(icon('up-right'));
                    bottom.append(link);
                    info.append(bottom);
                    const preparation = productText(product.preperationDescription);
                    if (preparation) {
                        const details = element('details', 'bs-product-detail');
                        details.append(element('summary', '', 'Nasıl hazırlanıyor?'), element('p', '', preparation));
                        details.addEventListener('toggle', () => scrollBottom());
                        info.append(details);
                    }
                    card.append(visual, info);
                    grid.append(card);
                });
                parent.append(grid);
                return true;
            }

            function addScopeSuggestions(parent) {
                const actions = element('div', 'bs-inline-actions');
                [
                    ['Kahve öner', 'Bagery ürünlerinden bir kahve öner.'],
                    ['Tatlı seç', 'Bagery ürünlerinden bir tatlı öner.']
                ].forEach(([label, prompt]) => {
                    const button = element('button', 'bs-followup', label);
                    button.type = 'button';
                    button.dataset.prompt = prompt;
                    actions.append(button);
                });
                parent.append(actions);
            }

            function errorMessage(status) {
                if (status === 429) return 'Biraz yoğunluk var. Kısa bir süre sonra yeniden deneyelim.';
                if (status === 401 || status === 403) return 'Bu isteğe şu anda erişilemiyor. Sayfayı yenileyip tekrar deneyebilirsin.';
                return 'Şu anda yanıt hazırlayamıyorum. Yazdığın mesajı aşağıdaki düğmeyle tekrar gönderebilirsin.';
            }

            async function sendMessage(value) {
                if (busy) return;
                const message = String(value ?? input.value).trim();
                if (!message || message.length > input.maxLength) return;

                const id = ++requestId;
                const controller = new AbortController();
                activeController = controller;
                let timedOut = false;
                const timer = setTimeout(() => { timedOut = true; controller.abort(); }, 60000);
                root.dataset.started = 'true';
                welcome.hidden = true;
                addUserMessage(message);
                input.value = '';
                setBusy(true);
                setState('thinking');
                const thinking = addThinking();

                try {
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ message }),
                        signal: controller.signal
                    });
                    if (!response.ok) throw Object.assign(new Error('İstek başarısız'), { status: response.status });
                    const result = await response.json();
                    if (id !== requestId) return;
                    if (!result || typeof result.inScope !== 'boolean' || typeof result.message !== 'string' ||
                        (result.inScope && !result.message.trim())) throw new Error('Beklenmeyen yanıt biçimi');

                    thinking.remove();
                    const inScope = result.inScope;
                    const row = addAnswer(inScope ? result.message : offTopicMessage, inScope ? '' : 'guard');
                    const hasProducts = inScope && Array.isArray(result.products) && renderProducts(result.products, row);
                    if (!inScope) addScopeSuggestions(row);
                    setState(inScope ? (hasProducts ? 'success' : 'answered') : 'guard');
                    announcement.textContent = 'Yanıt hazır.';
                    scrollBottom();
                    settleLater();
                } catch (error) {
                    if (id !== requestId) return;
                    thinking.remove();
                    if (controller.signal.aborted && !timedOut) {
                        addAnswer('İsteği durdurdum. Yeni bir şey sorabilirsin.');
                        setState('idle');
                    } else {
                        const text = timedOut ? 'Yanıt beklenenden uzun sürdü. Yeniden deneyelim mi?' : errorMessage(error.status);
                        const row = addAnswer(text, 'error');
                        const retry = element('button', 'bs-retry', 'Tekrar dene');
                        retry.type = 'button';
                        retry.dataset.retry = message;
                        const actions = element('div', 'bs-inline-actions');
                        actions.append(retry);
                        row.append(actions);
                        setState('error');
                        console.warn('Bagery Sense isteği tamamlanamadı.', error.status || error.name);
                    }
                    scrollBottom();
                    announcement.textContent = 'İstek tamamlanamadı.';
                } finally {
                    clearTimeout(timer);
                    thinking.remove();
                    if (id === requestId) {
                        activeController = null;
                        setBusy(false);
                        if (window.matchMedia('(pointer: fine)').matches) input.focus({ preventScroll: true });
                    }
                }
            }

            function resetConversation() {
                ++requestId; // Eski yanıtın temizlenen konuşmaya eklenmesini önler.
                activeController?.abort();
                activeController = null;
                clearTimeout(idleTimer);
                conversation.replaceChildren();
                welcome.hidden = false;
                root.dataset.started = 'false';
                input.value = '';
                setBusy(false);
                setState('idle');
                followLatest = true;
                chat.scrollTop = 0;
                announcement.textContent = 'Yeni konuşma başlatıldı.';
                if (window.matchMedia('(pointer: fine)').matches) input.focus({ preventScroll: true });
            }

            form.addEventListener('submit', event => {
                event.preventDefault();
                if (busy) activeController?.abort();
                else sendMessage();
            });
            input.addEventListener('input', () => {
                resizeInput();
                if (!busy) setState(input.value.trim() ? 'listening' : 'idle');
            });
            input.addEventListener('keydown', event => {
                if (event.key === 'Enter' && !event.shiftKey && !event.isComposing && !busy) {
                    event.preventDefault();
                    sendMessage();
                }
            });
            root.addEventListener('click', event => {
                const button = event.target.closest('button[data-prompt], button[data-retry]');
                if (button && !button.disabled) sendMessage(button.dataset.prompt || button.dataset.retry);
            });
            reset.addEventListener('click', resetConversation);
            chat.addEventListener('scroll', () => {
                followLatest = chat.scrollHeight - chat.scrollTop - chat.clientHeight < 130;
            }, { passive: true });
            motionButton.addEventListener('click', () => setMotion(!motionEnabled));
            reducedMotion.addEventListener('change', () => setMotion(!reducedMotion.matches));

            // Gözler fareyi takip eder; bu hareket herhangi bir AI çağrısı yapmaz.
            root.addEventListener('pointermove', event => {
                if (!motionEnabled || event.pointerType !== 'mouse' || busy || document.hidden) return;
                if (pointerFrame) cancelAnimationFrame(pointerFrame);
                const x = event.clientX;
                const y = event.clientY;
                pointerFrame = requestAnimationFrame(() => {
                    const rect = scene.getBoundingClientRect();
                    const dx = Math.max(-1, Math.min(1, (x - rect.left - rect.width / 2) / 500));
                    const dy = Math.max(-1, Math.min(1, (y - rect.top - rect.height / 2) / 400));
                    root.style.setProperty('--head-x', (dx * 3).toFixed(1) + 'px');
                    root.style.setProperty('--head-y', (dy * 2).toFixed(1) + 'px');
                    root.style.setProperty('--head-r', (dx * 4).toFixed(1) + 'deg');
                    root.style.setProperty('--eye-x', (dx * 3).toFixed(1) + 'px');
                    root.style.setProperty('--eye-y', (dy * 2).toFixed(1) + 'px');
                    pointerFrame = null;
                });
            }, { passive: true });
            root.addEventListener('pointerleave', resetLook);
            window.addEventListener('pagehide', () => activeController?.abort());
            setMotion(motionEnabled);
            setState('idle');
            resizeInput();
        })();

    </script>
</body>
</html>

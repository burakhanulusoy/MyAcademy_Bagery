@using Bagery.WebUI.MediatorPattern.Results.OrderResults
@model GetMyOrderQueryResult
@{
    ViewData["Title"] = "Ödeme Başarısız";
    Layout = "~/Views/Shared/_WebUILayout.cshtml";
    var failMessage = ViewBag.FailMessage as string; // controller'dan gelen sebep (boş olabilir)
}

<section class="page-title centred"
         style="background-image: url('@Url.Content("~/Bagery Pack/Bagery/assets/images/background/shop detail arka plan.png")');">
    <div class="auto-container">
        <div class="content-box">
            <div class="title"><h1>Ödeme başarısız</h1></div>
        </div>
    </div>
</section>

<section class="payment-result">
    <div class="auto-container">
        <div class="result-box">
            <div class="result-icon is-error"><i class="fas fa-times"></i></div>
            <h2>Ödeme tamamlanamadı</h2>
            <p>Ödeme alınmadı. Sepetiniz duruyor, bilgileri kontrol edip tekrar deneyebilirsiniz.</p>

            @if (!string.IsNullOrWhiteSpace(failMessage))
            {
                <div class="payment-error">@failMessage</div>
            }

            @if (Model is not null)
            {
                <p>Sipariş no: @Model.OrderNo</p>
            }

            <div class="btn-row">
                <a href="/Payment/Checkout" class="theme-btn-one">Tekrar dene</a>
                <a href="/Cart/Index" class="theme-btn-two">Sepete dön</a>
            </div>
        </div>
    </div>
</section>
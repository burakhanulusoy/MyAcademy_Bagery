@using Bagery.WebUI.MediatorPattern.Results.CheckoutResults
@using Microsoft.Extensions.Hosting
@model GetCheckoutQueryResult
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Ödeme";
    Layout = "~/Views/Shared/_WebUILayout.cshtml";
}

<section class="page-title centred"
         style="background-image: url('@Url.Content("~/Bagery Pack/Bagery/assets/images/background/shop detail arka plan.png")');">
    <div class="auto-container">
        <div class="content-box">
            <div class="title"><h1>Ödeme</h1></div>
        </div>
    </div>
</section>

<section class="bg-shop bg-checkout">
    <div class="auto-container">

        <ol class="bg-steps" aria-label="Sipariş adımları">
            @* Tamamlanan adım tıklanınca sepete döner *@
            <li class="is-done"><a href="/Cart/Index"><span class="num"><i class="fas fa-check" aria-hidden="true"></i></span><span>Sepet</span></a></li>
            <li class="is-current"><span class="num">2</span><span>Ödeme</span></li>
            <li><span class="num">3</span><span>Onay</span></li>
        </ol>

        @* Tek form: sol ve sağ kolonun tamamı; "name"i olan her alan ödemeyle gönderilir *@
        <form id="paymentForm" class="bg-layout" novalidate>

            <div class="bg-stack">

                @* 1) TESLİMAT *@
                <div class="bg-panel">
                    <h2 class="bg-panel-title"><span class="step-no">1</span> Teslimat bilgileri</h2>
                    <div class="bg-grid-2">
                        <div class="bg-field bg-span-2">
                            <label for="FullName">Ad soyad</label>
                            <input type="text" id="FullName" name="FullName" value="@Model.FullName" autocomplete="name">
                        </div>
                        <div class="bg-field">
                            <label for="Email">E-posta</label>
                            @* name yok: e-posta formdan alınmaz, handler AppUser'dan okur *@
                            <input type="email" id="Email" value="@Model.Email" readonly>
                        </div>
                        <div class="bg-field">
                            <label for="PhoneNumber">Telefon</label>
                            <input type="text" id="PhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber"
                                   inputmode="tel" autocomplete="tel" placeholder="0555 555 55 55">
                        </div>
                        <div class="bg-field bg-span-2">
                            <label for="Address">Teslimat adresi</label>
                            <textarea id="Address" name="Address" rows="3" autocomplete="street-address">@Model.Address</textarea>
                        </div>
                        <div class="bg-field bg-span-2">
                            <label for="Note">Sipariş notu <span class="optional">(isteğe bağlı)</span></label>
                            <textarea id="Note" name="Note" rows="2" placeholder="Ör. zile basmayın, kapıya bırakın"></textarea>
                        </div>
                    </div>
                </div>

                @* 2) KART *@
                <div class="bg-panel">
                    <h2 class="bg-panel-title"><span class="step-no">2</span> Kart bilgileri</h2>

                    @* Yazdıkça güncellenen kart önizlemesi (sadece görüntü, hiçbir yere gönderilmez) *@
                    <div class="bg-card-wrap">
                        <div class="bg-card" aria-hidden="true">
                            <div class="bg-card-top">
                                <span class="bg-card-chip"></span>
                                <span class="bg-card-type">KREDİ / BANKA KARTI</span>
                            </div>
                            <div class="bg-card-number" id="cpNumber">•••• •••• •••• ••••</div>
                            <div class="bg-card-bottom">
                                <div><small>KART SAHİBİ</small><span id="cpName">AD SOYAD</span></div>
                                <div><small>SKT</small><span id="cpExpiry">AA/YY</span></div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-grid-2">
                        <div class="bg-field bg-span-2">
                            <label for="CardOwner">Kart üzerindeki isim</label>
                            <input type="text" id="CardOwner" name="CardOwner" autocomplete="cc-name">
                        </div>
                        <div class="bg-field bg-span-2">
                            <label for="CardNumber">Kart numarası</label>
                            <input type="text" id="CardNumber" name="CardNumber" inputmode="numeric"
                                   autocomplete="cc-number" placeholder="0000 0000 0000 0000" maxlength="23">
                        </div>
                        <div class="bg-span-2 bg-grid-3">
                            <div class="bg-field">
                                <label for="ExpiryMonth">Ay</label>
                                <input type="text" id="ExpiryMonth" name="ExpiryMonth" inputmode="numeric"
                                       autocomplete="cc-exp-month" placeholder="AA" maxlength="2">
                            </div>
                            <div class="bg-field">
                                <label for="ExpiryYear">Yıl</label>
                                <input type="text" id="ExpiryYear" name="ExpiryYear" inputmode="numeric"
                                       autocomplete="cc-exp-year" placeholder="YY" maxlength="2">
                            </div>
                            <div class="bg-field">
                                <label for="Cvv">CVV</label>
                                <input type="text" id="Cvv" name="Cvv" inputmode="numeric"
                                       autocomplete="cc-csc" maxlength="4">
                            </div>
                        </div>
                    </div>

                    @* Kart numarasının ilk 8 hanesi yazılınca görünür *@
                    <div id="installmentBox" class="bg-inst" hidden>
                        <p class="bg-label">Taksit seçenekleri</p>
                        <div class="installment-list" id="installmentList"></div>
                    </div>
                </div>
            </div>

            @* SAĞ: özet + kupon + ödeme butonu (kaydırırken sabit kalır) *@
            <aside class="bg-panel bg-summary">
                <h2 class="bg-panel-title">Siparişiniz</h2>

                <ul class="bg-mini-items" id="orderItems"></ul> @* JS dolduruyor *@

                <div class="bg-coupon">
                    <div class="bg-coupon-row" id="couponForm">
                        @* name yok: ödeme formuyla birlikte gönderilmez *@
                        <input type="text" id="couponInput" placeholder="Kupon kodu" autocomplete="off" aria-label="Kupon kodu">
                        <button type="button" id="applyCouponBtn">Uygula</button>
                    </div>
                    <div class="bg-coupon-applied" id="couponApplied" hidden>
                        <span><i class="fas fa-tag" aria-hidden="true"></i> <strong id="couponCodeText"></strong> uygulandı</span>
                        <button type="button" id="removeCouponBtn">Kaldır</button>
                    </div>
                    @await Component.InvokeAsync("_ActiveCouponsViewComponents")
                </div>

                <dl class="bg-totals">
                    <div><dt>Ara toplam</dt><dd id="sumSubTotal"></dd></div>
                    <div id="sumDiscountRow" hidden><dt>İndirim</dt><dd id="sumDiscount" class="is-discount"></dd></div>
                    <div><dt>Kargo</dt><dd id="sumShipping"></dd></div>
                    <div class="bg-grand"><dt>Toplam</dt><dd id="sumPaid"></dd></div>
                </dl>

                @* Form içinde olduğu için type="submit" ödeme formunu gönderir *@
                <button type="submit" id="payBtn" class="bg-btn">Ödemeyi tamamla</button>
                <div id="paymentError" class="bg-alert" role="alert" hidden></div>

                <p class="bg-trust"><i class="fas fa-lock" aria-hidden="true"></i> Kart bilgileriniz PayTR'ye iletilir, ödeme 3D Secure ile doğrulanır.</p>

                @if (Env.IsDevelopment())
                {
                    @* PayTR test kartı; canlıda görünmez *@
                    <p class="bg-test-hint">Test kartı: 9792 0303 9444 0796, 12 / 30, CVV 000</p>
                }
            </aside>

        </form>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const cartApi = window.BageryCart;
            const fp = cartApi.formatPrice;
            const esc = cartApi.escapeHtml;
            const form = document.getElementById('paymentForm');
            const payBtn = document.getElementById('payBtn');
            const errorBox = document.getElementById('paymentError');
            const cardNumberInput = document.getElementById('CardNumber');
            const installmentBox = document.getElementById('installmentBox');
            const installmentList = document.getElementById('installmentList');
            const couponInput = document.getElementById('couponInput');
            let lastBin = ''; // aynı 8 hane için PayTR'ye tekrar tekrar sorulmasın

            function showError(message) {
                errorBox.textContent = message || '';
                errorBox.hidden = !message;
            }

            // ---------- 1) Sipariş özeti ----------
            async function loadSummary() {
                const result = await cartApi.get();
                if (!result.success) { showError(result.message); return; }

                const cart = result.cart;
                if (cart.items.length === 0) { window.location.href = '/Cart/Index'; return; }

                // Küçük ürün listesi: resmin köşesinde adet rozeti
                document.getElementById('orderItems').innerHTML = cart.items.map(item => `
                    <li>
                        <span class="bg-mini-img"><img src="${esc(item.imageUrl)}" alt=""><em>${item.quantity}</em></span>
                        <span class="bg-mini-name">${esc(item.productName)}${item.variantName ? `<small>${esc(item.variantName)}</small>` : ''}</span>
                        <span class="bg-mini-price">${fp(item.lineTotal)}</span>
                    </li>`).join('');

                document.getElementById('sumSubTotal').textContent = fp(cart.subTotal);
                document.getElementById('sumDiscountRow').hidden = !cart.couponCode;
                document.getElementById('sumDiscount').textContent = '−' + fp(cart.couponDiscount);
                document.getElementById('sumShipping').textContent = cart.shippingPrice === 0 ? 'Ücretsiz' : fp(cart.shippingPrice);
                document.getElementById('sumPaid').textContent = fp(cart.paidPrice);

                renderCouponState(cart);
            }

            // ---------- 2) Kart numarası: 4'erli boşluk + ilk 8 hanede taksitleri getir ----------
            cardNumberInput.addEventListener('input', function () {
                const digits = this.value.replace(/\D/g, '').slice(0, 19);
                this.value = digits.replace(/(.{4})/g, '$1 ').trim();

                const bin = digits.slice(0, 8);
                if (bin.length < 8) {
                    lastBin = '';
                    installmentBox.hidden = true;
                    installmentList.innerHTML = ''; // seçim kalmazsa InstallmentCount=0 (tek çekim) gider
                    return;
                }
                if (bin !== lastBin) {
                    lastBin = bin;
                    loadInstallments(bin);
                }
            });

            async function loadInstallments(bin) {
                installmentBox.hidden = false;
                installmentList.innerHTML = '<p class="installment-hint">Taksit seçenekleri yükleniyor...</p>';

                const result = await cartApi.post('/Payment/Installments', { binNumber: bin });

                if (bin !== lastBin) return; // bu sırada kart numarası değiştiyse eski cevabı gösterme

                if (!result.success) {
                    installmentList.innerHTML = `<p class="installment-hint">${esc(result.message)}</p>`;
                    return;
                }

                installmentList.innerHTML = result.installments.map((x, i) => `
                    <label>
                        <span>
                            <input type="radio" name="InstallmentCount" value="${x.installmentCount}" ${i === 0 ? 'checked' : ''}>
                            ${x.installmentCount === 0 ? 'Tek çekim' : x.installmentCount + ' taksit'}
                        </span>
                        <span>${x.installmentCount === 0
                            ? fp(x.totalPrice)
                            : x.installmentCount + ' x ' + fp(x.monthlyPrice) + ' = ' + fp(x.totalPrice)}</span>
                    </label>`).join('');
            }

            // ---------- 3) Ödemeyi tamamla ----------
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                showError('');

                payBtn.disabled = true; // çift tıklamada iki ödeme başlatılmasın
                payBtn.textContent = 'İşleniyor...';

                const data = Object.fromEntries(new FormData(form));
                data.CardNumber = (data.CardNumber || '').replace(/\s/g, '');

                const result = await cartApi.post('/Payment/Create', data);

                if (result.success) {
                    // PayTR'nin 3D Secure sayfasını ekrana bas
                    document.open();
                    document.write(result.redirectHtml);
                    document.close();
                    return;
                }

                payBtn.disabled = false;
                payBtn.textContent = 'Ödemeyi tamamla';
                showError(result.message);
                loadSummary(); // fiyat değiştiği için hata geldiyse özet de güncellensin
            });

            // ---------- 4) Kupon ----------
            function renderCouponState(cart) {
                const hasCoupon = !!cart.couponCode;
                document.getElementById('couponForm').hidden = hasCoupon;   // uygulanınca giriş kutusu gizlenir
                document.getElementById('couponApplied').hidden = !hasCoupon;
                document.getElementById('couponCodeText').textContent = cart.couponCode || '';
            }

            // Kupon değişince tutar değişir: özet ve (kart yazıldıysa) taksit tablosu yenilensin
            async function couponAction(promise) {
                const result = await promise;
                cartApi.toast(result.message, result.success);
                if (!result.success) return;

                couponInput.value = '';
                await loadSummary();
                if (lastBin) loadInstallments(lastBin);
            }

            document.getElementById('applyCouponBtn').addEventListener('click', function () {
                const code = couponInput.value.trim();
                if (!code) { cartApi.toast('Kupon kodunu yazın.', false); return; }
                couponAction(cartApi.applyCoupon(code));
            });

            // Kutu ödeme formunun içinde: Enter ÖDEMEYİ değil kuponu tetiklesin
            couponInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    document.getElementById('applyCouponBtn').click();
                }
            });

            document.getElementById('removeCouponBtn').addEventListener('click', function () {
                couponAction(cartApi.removeCoupon());
            });

            // ---------- 5) YENİ: kart önizlemesi ----------
            const cpNumber = document.getElementById('cpNumber');
            const cpName = document.getElementById('cpName');
            const cpExpiry = document.getElementById('cpExpiry');

            function updateCardPreview() {
                // Yazılan rakamlar + kalanı nokta: "9792 03•• •••• ••••"
                const digits = cardNumberInput.value.replace(/\D/g, '');
                const padded = (digits + '•'.repeat(16)).slice(0, Math.max(16, digits.length));
                cpNumber.textContent = padded.replace(/(.{4})/g, '$1 ').trim();

                const owner = document.getElementById('CardOwner').value.trim();
                cpName.textContent = owner ? owner.toLocaleUpperCase('tr-TR') : 'AD SOYAD'; // Türkçe büyük harf (i → İ)

                const mm = document.getElementById('ExpiryMonth').value || 'AA';
                const yy = document.getElementById('ExpiryYear').value || 'YY';
                cpExpiry.textContent = `${mm}/${yy}`;
            }

            ['CardOwner', 'CardNumber', 'ExpiryMonth', 'ExpiryYear'].forEach(id =>
                document.getElementById(id).addEventListener('input', updateCardPreview));

            loadSummary(); // sayfa açılınca sipariş özetini getir
        })();
    </script>
}
@using Bagery.WebUI.Enums
@using Bagery.WebUI.MediatorPattern.Results.OrderResults
@model GetMyOrderQueryResult
@{
    ViewData["Title"] = "Sipariş Durumu";
    Layout = "~/Views/Shared/_WebUILayout.cshtml";
}
@functions {
    // ---------- Pixel motokurye sprite'ı: her harf bir renk, '.' boş ----------
    static readonly string[] Courier =
    {
        ".............................KKKKK..................",
        "............................KAAAAAKKKKK.............",
        "............................KAAAAAKLLLLK............",
        ".KKKKKKKKKKKKK.............KHHHHHHHLLLLK............",
        "KDDDDDDDDDDDDDK...........KHHHHHVVVVLLLK............",
        "KDDDDDDDDDDDDDK...........KHHHHHVWWVLLLK............",
        "KAAAAAAAAAAAAAK...........KHHHHHVVVVLLLK............",
        "KAAWWWWWWWWWAAK............KHHHHVVVVLLLK............",
        "KAAWWWWWWWWWAAK..........KKKKHHHHHGGGGGK............",
        "KAAWWWWWWWWWAAK.........KJJJJJHHHGGGGGGK............",
        "KAAWWWWWWWWWAAK........KJJJJJJJJJGGGSSKKKK..........",
        "KAAWWWWWWWWWAAKKKKKKKKKKJJJJJJJJJKCCSSYYYYK.........",
        "KAAWWWWWWWWWAAGGGGGGGGGGJJJJJJKKKKCCSSYYYYK.........",
        "KAAAAAAAAAAAAAGGGGGGGGGJJJJJJK...KCCSSYYYYK.........",
        "KAAAAAAAAAAAAAGGGGGGGGJJJJJJJK...KCCSSYYYYK.........",
        "KAAAAAAAAAAAGGGGKKKKKKJJJJJJJK...KCCSSKKKK..........",
        ".KKCCCCCCCCCGGGGCCCCCCJJJJJJK....KCCSSK.............",
        "..KAACCCCCCCCCCCCCCCCJJJJJJJKK...KCCSSK.............",
        "..KAACCCCCCCCCCCCCCCCCKKPPPPPPK..KCCSSK.............",
        "..KAACCCCCCCCCCCCCCCCCKKPPPPPPPKKKCCSSKKKKKKK.......",
        "...KCCCCCCCCCCCCCCCCCCKKKPPPPPPPPCCCCCCCCCCCCK......",
        "...KSSSSSSSSSSSSSSSSSSSSSSSSPGGGGGGCCCCCCCCCCK......",
        "...KSSSSSSSSSSSSSSSSSSSSSSSSSGGGGGGCCCCCCCCCCK......",
        "...KSSSSSSSSSSSSSSSSSSSSSSSSSGGGGGGCCCCCCCCCCK......",
        "....KTTRRRRRRRTTKKKKKKKKKKKKKKKKKKKTTRRRRRRRTTK.....",
        "....KTTRRRRRRRTTK.................KTTRRRRRRRTTK.....",
        "....KTTRRRRRRRTTK.................KTTRRRRRRRTTK.....",
        ".....KTTRRRRRTTK...................KTTRRRRRTTK......",
        ".....KTTTRRRTTTK...................KTTTRRRTTTK......",
        "......KTTTTTTTK.....................KTTTTTTTK.......",
        ".......KKTTTKK.......................KKTTTKK........",
        ".........KKK...........................KKK.........."
    };

    // Şehir silüeti: (x, y, genişlik, yükseklik)
    static readonly (int X, int Y, int W, int H)[] Buildings =
    {
        (0, 44, 14, 26), (16, 38, 10, 32), (28, 48, 18, 22), (48, 34, 12, 36), (62, 46, 16, 24),
        (80, 40, 10, 30), (92, 50, 20, 20), (114, 36, 12, 34), (128, 46, 14, 24), (144, 42, 16, 28)
    };

    static readonly (int X, int Y)[] Stars =
    {
        (8, 10), (26, 6), (44, 14), (70, 8), (96, 12), (118, 6), (150, 16), (60, 20), (136, 24)
    };

    // Haritayı yan yana aynı renkteki karelerden tek dikdörtgen yaparak çizer (daha az etiket)
    static IEnumerable<(int X, int Y, int Width, char Color)> Runs(string[] map)
    {
        for (var y = 0; y < map.Length; y++)
        {
            var row = map[y];
            var x = 0;
            while (x < row.Length)
            {
                var color = row[x];
                var start = x;
                while (x < row.Length && row[x] == color) x++;
                if (color != '.') yield return (start, y, x - start, color);
            }
        }
    }
}

<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
<link href="~/css/bagery-pixel-moto.css" rel="stylesheet">

<section class="page-title centred"
         style="background-image: url('@Url.Content("~/Bagery Pack/Bagery/assets/images/background/shop detail arka plan.png")');">
    <div class="auto-container">
        <div class="content-box">
            <div class="title"><h1>Sipariş durumu</h1></div>
        </div>
    </div>
</section>

<section class="bg-shop bg-result">
    <div class="auto-container">

        <ol class="bg-steps" aria-label="Sipariş adımları">
            <li class="is-done"><span class="num"><i class="fas fa-check" aria-hidden="true"></i></span><span>Sepet</span></li>
            <li class="is-done"><span class="num"><i class="fas fa-check" aria-hidden="true"></i></span><span>Ödeme</span></li>
            <li class="is-current"><span class="num">3</span><span>Onay</span></li>
        </ol>

        @if (Model is null)
        {
            @* Yanlış numara ya da başka kullanıcının siparişi *@
            <div class="bg-hero">
                <div class="bg-state-icon is-error"><i class="fas fa-times" aria-hidden="true"></i></div>
                <h2>Sipariş bulunamadı</h2>
                <p>Bu sipariş hesabınıza ait değil ya da bağlantı hatalı.</p>
            </div>
        }
        else if (Model.Status == OrderStatus.Paid)
        {
            // Tahmini varış: ödeme saati + 30-40 dk
            var etaFrom = (Model.PaidAt ?? Model.CreatedAt).ToLocalTime().AddMinutes(30);
            var etaTo = etaFrom.AddMinutes(10);

            // Başlık, açıklama ve bilgi metni gerçek teslimat durumuna göre
            var (heading, subText, noteText) = Model.DeliveryStatus switch
            {
                DeliveryStatus.OnTheWay => (
                "Siparişiniz yola çıktı",
                $"Kuryemiz {Model.DispatchedAt?.ToLocalTime().ToString("HH:mm")} itibarıyla yolda, birazdan kapınızda.",
                "Teslimat durumunu panelinizdeki Siparişlerim sayfasından takip edebilirsiniz."),
                DeliveryStatus.Delivered => (
                "Siparişiniz teslim edildi",
                "Afiyet olsun! Bizi tercih ettiğiniz için teşekkürler.",
                "Fişinizi ve faturanızı panelinizdeki Siparişlerim sayfasından görebilirsiniz."),
                _ => (
                "Siparişiniz alındı",
                "Siparişiniz hazırlanıyor. Yaklaşık 30–40 dakika içinde kapınızda.",
                "Detayını ve teslimat durumunu panelinizdeki Siparişlerim sayfasından takip edebilirsiniz.")
            };

            <div class="bg-hero">

                @* ---------- PIXEL MOTOKURYE SAHNESİ ---------- *@
                <div class="px-scene">
                    <svg class="px-scene-svg" viewBox="0 0 160 90" shape-rendering="crispEdges"
                         role="img" aria-label="Pixel motokurye siparişinizi getiriyor">

                        <rect class="s-sky" width="160" height="90" />

                        @* Yıldızlar *@
                        <g class="px-twinkle">
                            @foreach (var star in Stars)
                            {
                                <rect class="s-star" x="@star.X" y="@star.Y" width="1" height="1" />
                            }
                        </g>

                        @* Ay *@
                        <rect class="s-moon" x="127" y="8" width="10" height="10" />
                        <rect class="s-moon" x="125" y="10" width="2" height="6" />
                        <rect class="s-moon" x="137" y="10" width="2" height="6" />
                        <rect class="s-crater" x="129" y="10" width="2" height="2" />
                        <rect class="s-crater" x="132" y="14" width="3" height="2" />

                        @* Şehir: iki kopya yan yana, 160 birim kayınca başa döner (kesintisiz) *@
                        <g class="px-city">
                            @for (var copy = 0; copy < 2; copy++)
                            {
                                var offset = copy * 160;
                                foreach (var b in Buildings)
                                {
                                    <rect class="s-building" x="@(b.X + offset)" y="@b.Y" width="@b.W" height="@b.H" />

                                    @* Yanan pencereler *@
                                    for (var wy = b.Y + 3; wy < b.Y + b.H - 3; wy += 6)
                                    {
                                        for (var wx = b.X + offset + 2; wx < b.X + offset + b.W - 2; wx += 5)
                                        {
                                            <rect class="s-window @((wx + wy) % 3 == 0 ? "is-warm" : "")" x="@wx" y="@wy" width="2" height="2" />
                                        }
                                    }
                                }
                            }
                        </g>

                        @* Yol *@
                        <rect class="s-curb" x="0" y="62" width="160" height="2" />
                        <rect class="s-road" x="0" y="64" width="160" height="26" />
                        <g class="px-dashes">
                            @for (var x = 0; x <= 176; x += 16)
                            {
                                <rect class="s-dash" x="@x" y="82" width="8" height="2" />
                            }
                        </g>

                        @* Hız çizgileri *@
                        <g class="px-speed">
                            <rect class="s-speed" x="28" y="56" width="14" height="1" />
                            <rect class="s-speed" x="20" y="64" width="10" height="1" />
                            <rect class="s-speed" x="34" y="72" width="12" height="1" />
                        </g>

                        @* Egzoz dumanı *@
                        <g class="px-smoke">
                            <rect class="s-smoke" x="50" y="74" width="2" height="2" />
                            <rect class="s-smoke" x="46" y="72" width="3" height="3" />
                            <rect class="s-smoke" x="41" y="70" width="4" height="4" />
                        </g>

                        @* Kurye: dış grup soldan getirir, iç grup kare kare titretir *@
                        <g class="px-drive">
                            <g class="px-bob">
                                <g transform="translate(54 47)">
                                    @foreach (var run in Runs(Courier))
                                    {
                                        <rect class="p-@run.Color" x="@run.X" y="@run.Y" width="@run.Width" height="1" />
                                    }
                                </g>

                                @* Jantlar: iki kare sırayla görünür, tekerlek dönüyormuş gibi *@
                                <g class="px-spokes-a">
                                    @foreach (var cx in new[] { 64, 94 })
                                    {
                                        <rect class="s-spoke" x="@(cx - 3)" y="72" width="7" height="1" />
                                        <rect class="s-spoke" x="@cx" y="69" width="1" height="7" />
                                    }
                                </g>
                                <g class="px-spokes-b">
                                    @foreach (var cx in new[] { 64, 94 })
                                    {
                                        <rect class="s-spoke" x="@(cx - 2)" y="70" width="1" height="1" />
                                        <rect class="s-spoke" x="@(cx - 1)" y="71" width="1" height="1" />
                                        <rect class="s-spoke" x="@cx" y="72" width="1" height="1" />
                                        <rect class="s-spoke" x="@(cx + 1)" y="73" width="1" height="1" />
                                        <rect class="s-spoke" x="@(cx + 2)" y="74" width="1" height="1" />
                                        <rect class="s-spoke" x="@(cx + 2)" y="70" width="1" height="1" />
                                        <rect class="s-spoke" x="@(cx + 1)" y="71" width="1" height="1" />
                                        <rect class="s-spoke" x="@(cx - 1)" y="73" width="1" height="1" />
                                        <rect class="s-spoke" x="@(cx - 2)" y="74" width="1" height="1" />
                                    }
                                </g>
                            </g>
                        </g>
                    </svg>

                    @* Sahnenin sol üstündeki kart *@
                    <div class="px-eta">
                        <span class="px-eta-icon"><i class="fas fa-motorcycle" aria-hidden="true"></i></span>
                        <div>
                            @if (Model.DeliveryStatus == DeliveryStatus.Delivered && Model.DeliveredAt is DateTime deliveredAt)
                            {
                                <small>TESLİM EDİLDİ</small>
                                <strong>@deliveredAt.ToLocalTime().ToString("HH:mm")</strong>
                            }
                            else
                            {
                                <small>TAHMİNİ VARIŞ</small>
                                <strong>@etaFrom.ToString("HH:mm") – @etaTo.ToString("HH:mm")</strong>
                            }
                        </div>
                    </div>
                </div>

                <span class="bg-paid-badge"><i class="fas fa-check-circle" aria-hidden="true"></i> Ödemeniz alındı</span>
                <h2>@heading</h2>
                <p>@subText</p>

                @* Adımlar gerçek teslimat durumundan *@
                <ol class="bg-track" aria-label="Sipariş durumu">
                    <li class="is-done">
                        <span class="dot"><i class="fas fa-check" aria-hidden="true"></i></span>Ödeme alındı
                    </li>
                    <li class="@(Model.DeliveryStatus == DeliveryStatus.Waiting ? "is-current" : "is-done")">
                        <span class="dot">
                            @if (Model.DeliveryStatus != DeliveryStatus.Waiting)
                            {
                                <i class="fas fa-check" aria-hidden="true"></i>
                            }
                        </span>Hazırlanıyor
                    </li>
                    <li class="@(Model.DeliveryStatus == DeliveryStatus.OnTheWay ? "is-current" : Model.DeliveryStatus == DeliveryStatus.Delivered ? "is-done" : "")">
                        <span class="dot">
                            @if (Model.DeliveryStatus == DeliveryStatus.Delivered)
                            {
                                <i class="fas fa-check" aria-hidden="true"></i>
                            }
                        </span>Yolda
                    </li>
                    <li class="@(Model.DeliveryStatus == DeliveryStatus.Delivered ? "is-done" : "")">
                        <span class="dot">
                            @if (Model.DeliveryStatus == DeliveryStatus.Delivered)
                            {
                                <i class="fas fa-check" aria-hidden="true"></i>
                            }
                        </span>Teslim
                    </li>
                </ol>

                <p class="bg-track-note">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    @noteText
                </p>
            </div>
        }
        else if (Model.Status == OrderStatus.Pending)
        {
            @* Tarayıcı callback'ten önce geldi; aşağıdaki script sayfayı birkaç kez yeniler *@
            <div class="bg-hero">
                <div class="bg-state-icon is-wait"><i class="fas fa-circle-notch" aria-hidden="true"></i></div>
                <h2>Ödemeniz onaylanıyor</h2>
                <p>Bankanızdan onay geldi, PayTR'nin bildirimi bekleniyor. Sayfa birkaç saniye içinde kendiliğinden güncellenecek.</p>
            </div>
        }
        else
        {
            @* Failed: callback önce gelip "başarısız" dedi *@
            <div class="bg-hero">
                <div class="bg-state-icon is-error"><i class="fas fa-times" aria-hidden="true"></i></div>
                <h2>Ödeme tamamlanamadı</h2>
                <p>@Model.StatusMessage</p>
            </div>
        }

        @* Fiş görünümünde sipariş özeti *@
        @if (Model is not null)
        {
            <div class="bg-panel bg-receipt">
                <div class="bg-receipt-head">
                    <h2 class="bg-panel-title">Sipariş özeti</h2>
                    <span class="bg-receipt-no">
                        No <code>@Model.OrderNo.Substring(0, 8).ToUpperInvariant()</code>,
                        @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>

                <ul class="bg-lines">
                    @foreach (var item in Model.OrderItems)
                    {
                        <li>
                            <span>
                                @item.ProductName<span class="qty">x @item.Quantity</span>
                                @if (item.VariantName is not null)
                                {
                                    <span class="variant">@item.VariantName</span>
                                }
                            </span>
                            <span>@item.LineTotal.ToString("N2") ₺</span>
                        </li>
                    }
                </ul>

                <dl class="bg-totals">
                    <div><dt>Ara toplam</dt><dd>@Model.TotalPrice.ToString("N2") ₺</dd></div>
                    @if (Model.CouponPrice > 0)
                    {
                        <div><dt>İndirim (@Model.CouponCode)</dt><dd class="is-discount">−@Model.CouponPrice.ToString("N2") ₺</dd></div>
                    }
                    <div><dt>Kargo</dt><dd>@(Model.ShippingPrice == 0 ? "Ücretsiz" : Model.ShippingPrice.ToString("N2") + " ₺")</dd></div>
                    @if (Model.InstallmentCount > 0)
                    {
                        <div><dt>Taksit</dt><dd>@Model.InstallmentCount taksit</dd></div>
                    }
                    <div class="bg-grand"><dt>Ödenen</dt><dd>@Model.PaidPrice.ToString("N2") ₺</dd></div>
                </dl>

                <div class="bg-address">
                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                    <span><strong>@Model.FullName</strong><br>@Model.Address</span>
                </div>
            </div>
        }

        <div class="bg-actions">
            @if (Model?.Status == OrderStatus.Paid)
            {
                @* Herkes kendi paneline: Admin, Writer ya da User *@
                var panelArea = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Writer") ? "Writer" : "User";
                <a href="/@panelArea/MyOrders/Detail?orderNo=@Model.OrderNo" class="bg-btn">Siparişimi görüntüle</a>
            }
            @if (Model?.Status == OrderStatus.Pending)
            {
                <button type="button" class="bg-btn" onclick="location.reload()">Durumu yenile</button>
            }
            @if (Model?.Status == OrderStatus.Failed)
            {
                <a href="/Payment/Checkout" class="bg-btn">Tekrar dene</a>
            }
            <a href="/Product/Shop" class="bg-btn bg-btn-outline">Alışverişe devam et</a>
        </div>

    </div>
</section>

@section Scripts {
    @if (Model?.Status == OrderStatus.Pending)
    {
        <script>
            // Callback birkaç saniye içinde gelir: 3 sn arayla en fazla 5 kez yenile, sonra butona bırak
            (function () {
                const key = 'pendingReload_' + '@Model.OrderNo';
                const count = parseInt(sessionStorage.getItem(key) || '0', 10);
                if (count < 5) {
                    sessionStorage.setItem(key, count + 1);
                    setTimeout(() => location.reload(), 3000);
                }
            })();
        </script>
    }
}
@model LoginUserCommand
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Giriş Yap · BAGERY</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400..700&family=Plus+Jakarta+Sans:wght@400..700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#442a22",
                        "primary-soft": "#77574d",
                        secondary: "#76574e",
                        surface: "#faf9f6",
                        "surface-field": "#f4f3f1",
                        "on-surface": "#1a1c1a",
                        "on-surface-variant": "#504441",
                        outline: "#b9aaa5",
                        "outline-variant": "#e2d9d6",
                        error: "#ba1a1a",
                        "error-container": "#ffe6e3",
                        "on-error-container": "#7a0007"
                    },
                    fontFamily: {
                        display: ["Literata", "serif"],
                        body: ["Plus Jakarta Sans", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-size: 20px;
            line-height: 1;
            display: inline-block;
            -webkit-font-smoothing: antialiased;
        }

        .validation-summary-valid {
            display: none !important;
        }

        .validation-summary-errors {
            display: block;
            animation: shake .35s ease-in-out;
        }

            .validation-summary-errors ul {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: .375rem;
            }

                .validation-summary-errors ul li {
                    font-size: .875rem;
                    font-weight: 500;
                    display: flex;
                    align-items: flex-start;
                    line-height: 1.45;
                }

                    .validation-summary-errors ul li::before {
                        content: "chevron_right";
                        font-family: "Material Symbols Outlined";
                        font-size: 1.05rem;
                        margin-right: .25rem;
                        color: #ba1a1a;
                        flex-shrink: 0;
                    }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-4px);
            }

            75% {
                transform: translateX(4px);
            }
        }

        .field {
            transition: border-color .18s, background-color .18s, box-shadow .18s;
        }

            .field:focus {
                outline: none;
                border-color: #442a22;
                background: #fff;
                box-shadow: 0 0 0 4px rgba(68,42,34,.08);
            }
    </style>
</head>
<body class="font-body bg-surface text-on-surface min-h-screen flex antialiased">

    <!-- Sol görsel -->
    <div class="hidden lg:flex lg:w-[45%] relative">
        <img class="absolute inset-0 w-full h-full object-cover"
             src="https://lh3.googleusercontent.com/aida-public/AB6AXuDGpClCL4ApT2C0yYVBQ8NpUJkR_CHMDGN0YnINskdfvRtmKdfOINDheV-EvSyLqrQhA__lTOmC2Mktf0Cbqs-6425FhMfUtlYYMohLGuotVZMggppoBWIRcKk7jSV2b3QO2F7nD0Djfb4w22XzOXDqnhinLALwZor3clWjU_3AQM6gEmiYTkPL8qDPICOHL2sTaRJBZGbCRPyk8NpoPndPOCfTCLTCh2I-ySKD81IfJiiVldANImUrXr7f3cY6_eOzPi1ph-I7Yr9i"
             alt="Bakery" />
        <div class="absolute inset-0 bg-gradient-to-t from-primary/85 via-primary/35 to-transparent"></div>
        <div class="relative z-10 mt-auto p-12 text-white">
            <span class="material-symbols-outlined text-[40px] mb-4 opacity-90" style="font-variation-settings:'FILL' 1;">bakery_dining</span>
            <h2 class="font-display text-[34px] leading-[1.2] font-bold mb-3">
                Her sabah taze,<br />her lokma el emeği.
            </h2>
            <p class="text-white/75 text-[15px] max-w-sm">
                Hesabınıza giriş yapın, siparişlerinizi takip edin ve size özel tariflere ulaşın.
            </p>
        </div>
    </div>

    <!-- Sağ form -->
    <div class="w-full lg:w-[55%] flex items-center justify-center px-5 py-10 sm:px-10">
        <div class="w-full max-w-[420px]">

            <div class="lg:hidden text-center mb-8">
                <span class="material-symbols-outlined text-primary text-[36px]" style="font-variation-settings:'FILL' 1;">bakery_dining</span>
            </div>

            <header class="mb-8">
                <p class="text-[12px] font-bold tracking-[.18em] uppercase text-secondary mb-2">BAGERY</p>
                <h1 class="font-display text-[34px] leading-tight font-bold text-primary mb-2">Tekrar hoş geldiniz</h1>
                <p class="text-[15px] text-on-surface-variant">Devam etmek için bilgilerinizi girin.</p>
            </header>

            @if (TempData["ResetPasswordSuccess"] != null)
            {
                <div class="flex items-start gap-2 mb-5 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">
                    <span class="material-symbols-outlined text-[20px] text-emerald-600">check_circle</span>
                    <span>@TempData["ResetPasswordSuccess"]</span>
                </div>
            }

            @if (TempData["LoginError"] != null)
            {
                <div class="flex items-start gap-2 mb-5 p-3.5 rounded-xl bg-error-container border border-error/25 text-on-error-container text-sm">
                    <span class="material-symbols-outlined text-[20px] text-error">error</span>
                    <span>@TempData["LoginError"]</span>
                </div>
            }

            <div asp-validation-summary="All"
                 class="mb-5 p-4 rounded-xl bg-error-container border border-error/25 text-on-error-container"></div>

            <form method="post" class="space-y-5">

                <div>
                    <label asp-for="Email" class="block text-[13px] font-semibold text-on-surface-variant mb-1.5">E-posta</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none">mail</span>
                        <input asp-for="Email" type="email" required autocomplete="username"
                               placeholder="ornek@@email.com"
                               class="field w-full pl-11 pr-4 py-3 rounded-xl bg-surface-field border border-outline-variant text-[15px] placeholder-outline" />
                    </div>
                    <span asp-validation-for="Email" class="block mt-1.5 text-[13px] text-error"></span>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label asp-for="Password" class="text-[13px] font-semibold text-on-surface-variant">Şifre</label>
                        <a href="/User/ForgotPassword" class="text-[13px] font-semibold text-secondary hover:text-primary transition-colors">Şifremi unuttum</a>
                    </div>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none">lock</span>
                        <input asp-for="Password" type="password" id="passwordInput" required autocomplete="current-password"
                               placeholder="••••••••"
                               class="field w-full pl-11 pr-11 py-3 rounded-xl bg-surface-field border border-outline-variant text-[15px] placeholder-outline" />
                        <button type="button" id="togglePassword"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors">
                            <span class="material-symbols-outlined" id="toggleIcon">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="block mt-1.5 text-[13px] text-error"></span>
                </div>

                <label class="flex items-center gap-2.5 cursor-pointer select-none">
                    <input asp-for="RememberMe" type="checkbox"
                           class="w-[18px] h-[18px] rounded border-outline-variant text-primary focus:ring-2 focus:ring-primary/25 bg-surface-field cursor-pointer" />
                    <span class="text-[14px] text-on-surface-variant">Beni hatırla</span>
                </label>

                <button type="submit"
                        class="w-full py-3.5 rounded-xl bg-primary text-white font-bold text-[15px] shadow-[0_8px_24px_rgba(68,42,34,.22)] hover:bg-primary-soft active:scale-[.985] transition-all flex items-center justify-center gap-2 group">
                    Giriş Yap
                    <span class="material-symbols-outlined text-[19px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                </button>
            </form>

            <div class="relative my-7">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-outline-variant"></div></div>
                <div class="relative flex justify-center">
                    <span class="px-3 bg-surface text-[11px] font-bold tracking-widest uppercase text-outline">veya</span>
                </div>
            </div>

            <form asp-action="GoogleLogin" asp-controller="User" method="post">
                <button type="submit"
                        class="w-full py-3.5 rounded-xl border border-outline-variant bg-white font-semibold text-[15px] hover:bg-surface-field hover:border-outline transition-all flex items-center justify-center gap-2.5">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="" />
                    Google ile devam et
                </button>
            </form>

            <p class="mt-8 text-center text-[14px] text-on-surface-variant">
                Henüz hesabınız yok mu?
                <a href="/User/RegisterUser" class="font-bold text-primary hover:text-secondary underline decoration-dashed decoration-outline-variant underline-offset-4 ml-1 transition-colors">Kayıt olun</a>
            </p>
        </div>
    </div>

    <script>
        (function () {
            var btn = document.getElementById('togglePassword');
            var input = document.getElementById('passwordInput');
            var icon = document.getElementById('toggleIcon');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var isPwd = input.type === 'password';
                input.type = isPwd ? 'text' : 'password';
                icon.textContent = isPwd ? 'visibility_off' : 'visibility';
            });
        })();
    </script>
</body>
</html>
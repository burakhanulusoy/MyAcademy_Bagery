@model ResetPasswordCommand
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Yeni Şifre Belirle - BAKERY</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400..700&amp;family=Plus+Jakarta+Sans:wght@400..700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "on-error-container": "#93000a",
                      "surface-container-lowest": "#ffffff",
                      "on-surface-variant": "#504441",
                      "error": "#ba1a1a",
                      "error-container": "#ffdad6",
                      "outline-variant": "#d4c3be",
                      "surface": "#faf9f6",
                      "on-surface": "#1a1c1a",
                      "surface-container-low": "#f4f3f1",
                      "surface-container-high": "#e9e8e5",
                      "on-primary": "#ffffff",
                      "primary": "#442a22",
                      "background": "#faf9f6",
                      "outline": "#827470",
                      "secondary": "#76574e"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "margin-mobile": "16px",
                      "gutter": "24px"
              },
              "fontFamily": {
                      "body-md": ["Plus Jakarta Sans"],
                      "label-lg": ["Plus Jakarta Sans"],
                      "form-input": ["Plus Jakarta Sans"],
                      "display": ["Literata"]
              },
              "fontSize": {
                      "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                      "label-lg": ["14px", {"lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                      "form-input": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                      "display": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
              }
            }
          }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined', sans-serif;
            font-size: 24px;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            font-feature-settings: 'liga';
            -webkit-font-smoothing: antialiased;
        }

        .validation-summary-valid {
            display: none;
        }

        .validation-summary-errors {
            display: block;
        }
    </style>
</head>
<body class="bg-surface text-on-surface min-h-screen flex items-center justify-center antialiased p-margin-mobile">

    <div class="w-full max-w-md space-y-8 bg-surface-container-lowest p-8 rounded-xl shadow-[0_4px_20px_rgba(75,54,33,0.1)] border border-outline-variant/30 relative">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-secondary rounded-t-xl opacity-80"></div>

        <div class="text-center space-y-2">
            <span class="material-symbols-outlined text-primary text-4xl mb-2" style="font-variation-settings: 'FILL' 1;">key</span>
            <h1 class="font-display text-display text-primary tracking-tight">Yeni Şifre Belirle</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">
                Hesabınız için yeni bir şifre oluşturun.
            </p>
        </div>

        <form method="post" class="space-y-6">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div>
                <label class="block font-label-lg text-label-lg text-on-surface mb-2">Yeni Şifre</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">lock</span>
                    <input class="w-full pl-10 pr-4 py-3 bg-surface-container-low border-outline-variant rounded-lg font-form-input text-form-input text-on-surface focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all hover:bg-surface-container-high placeholder-outline"
                           asp-for="NewPassword" placeholder="••••••••" required="" type="password" />
                </div>
            </div>

            <div>
                <label class="block font-label-lg text-label-lg text-on-surface mb-2">Yeni Şifre (Tekrar)</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">lock_reset</span>
                    <input class="w-full pl-10 pr-4 py-3 bg-surface-container-low border-outline-variant rounded-lg font-form-input text-form-input text-on-surface focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all hover:bg-surface-container-high placeholder-outline"
                           asp-for="ConfirmPassword" placeholder="••••••••" required="" type="password" />
                </div>
            </div>

            <button type="submit" class="w-full flex justify-center items-center py-3 px-6 border border-transparent rounded-lg shadow-sm font-label-lg text-label-lg text-on-primary bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-all duration-200">
                Şifremi Güncelle
            </button>

            <div asp-validation-summary="All" class="mb-4 p-4 bg-error-container text-on-error-container border border-error/50 rounded-lg font-body-md text-sm [&>ul]:list-none [&>ul]:p-0 [&>ul]:m-0 [&>ul>li]:mt-1 [&>ul>li]:flex [&>ul>li]:items-center [&>ul>li]:before:content-['-'] [&>ul>li]:before:mr-2"></div>
        </form>

        <p class="text-center font-body-md text-body-md text-on-surface-variant">
            <a class="font-label-lg text-label-lg text-primary hover:text-secondary hover:underline decoration-dashed transition-all" href="/User/LoginUser">Giriş sayfasına dön</a>
        </p>
    </div>

</body>
</html>
@model RegisterUserCommand
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Kayıt Ol · BAGERY</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400..700&family=Plus+Jakarta+Sans:wght@400..700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#442a22",
                        "primary-soft": "#77574d",
                        secondary: "#76574e",
                        surface: "#faf9f6",
                        "surface-field": "#f4f3f1",
                        "on-surface": "#1a1c1a",
                        "on-surface-variant": "#504441",
                        outline: "#b9aaa5",
                        "outline-variant": "#e2d9d6",
                        error: "#ba1a1a",
                        "error-container": "#ffe6e3",
                        "on-error-container": "#7a0007"
                    },
                    fontFamily: {
                        display: ["Literata", "serif"],
                        body: ["Plus Jakarta Sans", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-size: 20px;
            line-height: 1;
            display: inline-block;
            -webkit-font-smoothing: antialiased;
        }

        .validation-summary-valid {
            display: none !important;
        }

        .validation-summary-errors {
            display: block;
            animation: shake .35s ease-in-out;
        }

            .validation-summary-errors ul {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: .375rem;
            }

                .validation-summary-errors ul li {
                    font-size: .875rem;
                    font-weight: 500;
                    display: flex;
                    align-items: flex-start;
                    line-height: 1.45;
                }

                    .validation-summary-errors ul li::before {
                        content: "chevron_right";
                        font-family: "Material Symbols Outlined";
                        font-size: 1.05rem;
                        margin-right: .25rem;
                        color: #ba1a1a;
                        flex-shrink: 0;
                    }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-4px);
            }

            75% {
                transform: translateX(4px);
            }
        }

        .field {
            transition: border-color .18s, background-color .18s, box-shadow .18s;
        }

            .field:focus {
                outline: none;
                border-color: #442a22;
                background: #fff;
                box-shadow: 0 0 0 4px rgba(68,42,34,.08);
            }
    </style>
</head>
<body class="font-body bg-surface text-on-surface min-h-screen flex antialiased">

    <!-- Sol görsel -->
    <div class="hidden lg:flex lg:w-[42%] relative">
        <img class="absolute inset-0 w-full h-full object-cover"
             src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQUVIDkpq9J_c2ZTalj7HXVIz8Y3U3rdO-Mk9n_Z5gB9sJP70K8Oe-VQVF7Gzc4pAfBoEqbV1XdbsItB2JzNF2ujx2eENWYUBYQWYgC1yP1K562SI42V69XENGZguVq8KRWBfU4rOoStXCaX4c8aKITl9wL1_nEdlUYjNGMDDHcIelwRzAt5VHW64X_7tBSo3kVeNuK0xxazYr6u2m5Hv-2a4BuCnUzFSG5gLqna97EgyMygofePARJxvf1i-Ta9OTZSW95ONvxuem"
             alt="Bakery" />
        <div class="absolute inset-0 bg-gradient-to-t from-primary/85 via-primary/35 to-transparent"></div>
        <div class="relative z-10 mt-auto p-12 text-white">
            <span class="material-symbols-outlined text-[40px] mb-4 opacity-90" style="font-variation-settings:'FILL' 1;">local_cafe</span>
            <h2 class="font-display text-[32px] leading-[1.2] font-bold mb-3">Aramıza katılın.</h2>
            <ul class="space-y-2.5 text-white/80 text-[15px]">
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">check</span> Siparişlerinizi tek yerden takip edin</li>
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">check</span> Size özel kampanyalardan haberdar olun</li>
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px]">check</span> Favori ürünlerinizi kaydedin</li>
            </ul>
        </div>
    </div>

    <!-- Sağ form -->
    <div class="w-full lg:w-[58%] flex items-center justify-center px-5 py-10 sm:px-10">
        <div class="w-full max-w-[520px]">

            <header class="mb-7">
                <p class="text-[12px] font-bold tracking-[.18em] uppercase text-secondary mb-2">BAGERY</p>
                <h1 class="font-display text-[34px] leading-tight font-bold text-primary mb-2">Hesap oluşturun</h1>
                <p class="text-[15px] text-on-surface-variant">Birkaç adımda tamamlayın, hemen başlayın.</p>
            </header>

            <div asp-validation-summary="All"
                 class="mb-5 p-4 rounded-xl bg-error-container border border-error/25 text-on-error-container">
                <div class="flex items-center gap-2 mb-2.5 pb-2 border-b border-error/15 font-bold text-error text-[14px]">
                    <span class="material-symbols-outlined text-[20px]">error</span>
                    Lütfen aşağıdaki hataları düzeltin
                </div>
            </div>

            <form asp-action="GoogleLogin" asp-controller="User" method="post">
                <button type="submit"
                        class="w-full py-3.5 rounded-xl border border-outline-variant bg-white font-semibold text-[15px] hover:bg-surface-field hover:border-outline transition-all flex items-center justify-center gap-2.5">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="" />
                    Google ile kayıt ol
                </button>
            </form>

            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-outline-variant"></div></div>
                <div class="relative flex justify-center">
                    <span class="px-3 bg-surface text-[11px] font-bold tracking-widest uppercase text-outline">veya e-posta ile</span>
                </div>
            </div>

            <form method="post" class="space-y-4">

                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="FullName" class="block text-[13px] font-semibold text-on-surface-variant mb-1.5">Ad Soyad</label>
                        <input asp-for="FullName" required placeholder="Ayşe Yılmaz"
                               class="field w-full px-4 py-3 rounded-xl bg-surface-field border border-outline-variant text-[15px] placeholder-outline" />
                        <span asp-validation-for="FullName" class="block mt-1.5 text-[13px] text-error"></span>
                    </div>
                    <div>
                        <label asp-for="UserName" class="block text-[13px] font-semibold text-on-surface-variant mb-1.5">Kullanıcı Adı</label>
                        <input asp-for="UserName" required placeholder="ayseyilmaz"
                               class="field w-full px-4 py-3 rounded-xl bg-surface-field border border-outline-variant text-[15px] placeholder-outline" />
                        <span asp-validation-for="UserName" class="block mt-1.5 text-[13px] text-error"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Email" class="block text-[13px] font-semibold text-on-surface-variant mb-1.5">E-posta</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none">mail</span>
                        <input asp-for="Email" type="email" required placeholder="merhaba@@ornek.com"
                               class="field w-full pl-11 pr-4 py-3 rounded-xl bg-surface-field border border-outline-variant text-[15px] placeholder-outline" />
                    </div>
                    <span asp-validation-for="Email" class="block mt-1.5 text-[13px] text-error"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="block text-[13px] font-semibold text-on-surface-variant mb-1.5">Telefon</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none">call</span>
                        <input asp-for="PhoneNumber" required placeholder="5xx xxx xx xx"
                               class="field w-full pl-11 pr-4 py-3 rounded-xl bg-surface-field border border-outline-variant text-[15px] placeholder-outline" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="block mt-1.5 text-[13px] text-error"></span>
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Password" class="block text-[13px] font-semibold text-on-surface-variant mb-1.5">Şifre</label>
                        <div class="relative">
                            <input asp-for="Password" type="password" id="pwd" required placeholder="••••••••"
                                   class="field w-full px-4 pr-11 py-3 rounded-xl bg-surface-field border border-outline-variant text-[15px] placeholder-outline" />
                            <button type="button" data-toggle="pwd"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                        <div class="mt-2 flex gap-1" id="strengthBar">
                            <span class="h-1 flex-1 rounded-full bg-outline-variant"></span>
                            <span class="h-1 flex-1 rounded-full bg-outline-variant"></span>
                            <span class="h-1 flex-1 rounded-full bg-outline-variant"></span>
                            <span class="h-1 flex-1 rounded-full bg-outline-variant"></span>
                        </div>
                        <span asp-validation-for="Password" class="block mt-1.5 text-[13px] text-error"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="block text-[13px] font-semibold text-on-surface-variant mb-1.5">Şifre Tekrarı</label>
                        <div class="relative">
                            <input asp-for="ConfirmPassword" type="password" id="pwd2" required placeholder="••••••••"
                                   class="field w-full px-4 pr-11 py-3 rounded-xl bg-surface-field border border-outline-variant text-[15px] placeholder-outline" />
                            <button type="button" data-toggle="pwd2"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="block mt-1.5 text-[13px] text-error"></span>
                        <span id="matchHint" class="hidden mt-1.5 text-[13px] text-error">Şifreler eşleşmiyor.</span>
                    </div>
                </div>

                <label class="flex items-start gap-3 pt-1 cursor-pointer select-none">
                    <input type="checkbox" required
                           class="mt-0.5 w-[18px] h-[18px] rounded border-outline-variant text-primary focus:ring-2 focus:ring-primary/25 bg-surface-field cursor-pointer" />
                    <span class="text-[14px] text-on-surface-variant leading-relaxed">
                        <span class="font-semibold text-secondary hover:underline decoration-dashed">Kullanım Koşulları</span>'nı ve
                        <span class="font-semibold text-secondary hover:underline decoration-dashed">Gizlilik Politikası</span>'nı okudum, kabul ediyorum.
                    </span>
                </label>

                <button type="submit"
                        class="w-full py-3.5 rounded-xl bg-primary text-white font-bold text-[15px] shadow-[0_8px_24px_rgba(68,42,34,.22)] hover:bg-primary-soft active:scale-[.985] transition-all flex items-center justify-center gap-2 group">
                    Kayıt Ol
                    <span class="material-symbols-outlined text-[19px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                </button>
            </form>

            <p class="mt-7 text-center text-[14px] text-on-surface-variant">
                Zaten bir hesabınız var mı?
                <a href="/User/Login" class="font-bold text-primary hover:text-secondary underline decoration-dashed decoration-outline-variant underline-offset-4 ml-1 transition-colors">Giriş yapın</a>
            </p>
        </div>
    </div>

    <script>
        document.querySelectorAll('[data-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.toggle);
                var icon = btn.querySelector('span');
                var isPwd = input.type === 'password';
                input.type = isPwd ? 'text' : 'password';
                icon.textContent = isPwd ? 'visibility_off' : 'visibility';
            });
        });

        (function () {
            var pwd = document.getElementById('pwd');
            var pwd2 = document.getElementById('pwd2');
            var bars = document.querySelectorAll('#strengthBar span');
            var hint = document.getElementById('matchHint');
            var colors = ['#ba1a1a', '#e08a1e', '#c9a227', '#2e7d32'];

            pwd.addEventListener('input', function () {
                var v = pwd.value, score = 0;
                if (v.length >= 8) score++;
                if (v.length >= 12) score++;
                if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
                if (/\d/.test(v) && /[^A-Za-z0-9]/.test(v)) score++;
                bars.forEach(function (b, i) {
                    b.style.backgroundColor = i < score ? colors[score - 1] : '#e2d9d6';
                });
            });

            pwd2.addEventListener('input', function () {
                hint.classList.toggle('hidden', !pwd2.value || pwd2.value === pwd.value);
            });
        })();
    </script>
</body>
</html>
@using Bagery.WebUI.MediatorPattern.Results.OrderResults
@model List<GetMyOrdersQueryResult>
@{
    ViewData["Title"] = "Siparişlerim";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var totalSpent = Model.Where(x => x.Status == OrderStatus.Paid).Sum(x => x.PaidPrice);
}

<div class="bo">

    <header class="bo-head">
        <div>
            <p class="bo-eyebrow">Alışveriş</p>
            <h1 class="bo-title">Siparişlerim</h1>
            @if (Model.Any())
            {
                <div class="bo-chips">
                    <span class="bo-chip"><i class='bx bx-receipt'></i> @Model.Count sipariş</span>
                    <span class="bo-chip is-dark"><i class='bx bx-wallet'></i> Toplam @totalSpent.ToString("N2") ₺</span>
                </div>
            }
        </div>
        <a href="/Product/Shop" class="bo-btn is-ghost"><i class='bx bx-store'></i> Alışverişe devam et</a>
    </header>

    @if (!Model.Any())
    {
        <div class="bo-card">
            <div class="bo-empty">
                <div class="icon"><i class='bx bx-shopping-bag'></i></div>
                <h3>Henüz siparişin yok</h3>
                <p>Verdiğin siparişler ve faturaları burada listelenir.</p>
                <a href="/Product/Shop" class="bo-btn">Mağazaya git</a>
            </div>
        </div>
    }
    else
    {
        <div class="bo-cards">
            @foreach (var order in Model)
            {
                var title = order.ProductLineCount > 1
                ? $"{order.FirstProductName} ve {order.ProductLineCount - 1} ürün daha"
                : order.FirstProductName;

                <article class="bo-order">
                    <div class="bo-order-top">
                        <span class="bo-code">#@order.OrderNo.Substring(0, 8).ToUpperInvariant()</span>
                        <span class="bo-pill is-@order.Status.ToString().ToLower()">@order.Status.ToTurkish()</span>
                    </div>

                    <h3 class="bo-order-title">@title</h3>
                    <span class="bo-order-date"><i class='bx bx-calendar'></i> @order.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</span>

                    <div class="bo-order-bottom">
                        <div>
                            <small>Tutar</small>
                            <div class="bo-order-price">@order.PaidPrice.ToString("N2") ₺</div>
                        </div>
                        <div class="bo-order-actions">
                            @if (order.Status == OrderStatus.Paid)
                            {
                                <a href="/Writer/MyOrders/Invoice?orderNo=@order.OrderNo&download=true" class="bo-btn is-sm is-ghost" title="PDF fatura indir">
                                    <i class='bx bx-download'></i> PDF
                                </a>
                            }
                            <a href="/Writer/MyOrders/Detail?orderNo=@order.OrderNo" class="bo-btn is-sm">
                                Detay <i class='bx bx-right-arrow-alt'></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

</div>
@using System.Globalization
@using Bagery.WebUI.MediatorPattern.Results.PanelResults
@model GetUserDashboardQueryResult
@{
    ViewData["Title"] = "İstatistiklerim";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    var tr = CultureInfo.GetCultureInfo("tr-TR");
    const int Rows = 10; // sütun grafiğinde en yüksek ay 10 kare

    var greeting = $"Merhaba, {Model.FullName.Split(' ')[0]}!";
    var xpCells = Model.LevelProgress * 20 / Model.XpPerLevel;
    var spentMax = Model.Months.Max(m => m.Spent);
    var topMax = Model.TopProducts.Count == 0 ? 0 : Model.TopProducts.Max(p => p.Quantity);
    var unlocked = Model.Badges.Count(b => b.Unlocked);
}
@functions {
    // Değeri 0..cells arası kare sayısına çevirir (0 değilse en az 1 kare görünsün)
    static int Cells(decimal value, decimal max, int cells) =>
        value <= 0 || max <= 0 ? 0 : Math.Max(1, (int)Math.Round(value * cells / max));

    // Pixel donut: her harf bir renk, '.' boş (ortadaki delik de boş)
    static readonly string[] Donut =
    {
        "....PPPPPP....",
        "..PPPYPPPPBP..",
        ".PPBPPPPPPPPP.",
        ".PPPPPGPPYPPP.",
        "PPYPPP..PPPBPP",
        "PPPPP....PPPPP",
        "PBPPD....DPPGP",
        "DPPPD....DPPPD",
        "DDPPPD..DPPPDD",
        ".DDGPPDDPPBPD.",
        ".DDDPPPPYPPDD.",
        "..DDDDDDDDDD..",
        "...DDDDDDDD...",
        "....DDDDDD...."
    };

    static readonly Dictionary<char, string> DonutColors = new()
    {
        ['P'] = "#f472b6", // pembe şekerleme
        ['Y'] = "#fde047", // sarı serpinti
        ['B'] = "#60a5fa", // mavi serpinti
        ['G'] = "#4ade80", // yeşil serpinti
        ['D'] = "#d97706"  // hamur
    };

    // Haritayı SVG karelerine çevirir; dolu karelerin etrafına 1 karelik siyah kontur ekler
    static IEnumerable<(int X, int Y, string Fill)> Pixels(string[] map, Dictionary<char, string> colors)
    {
        int height = map.Length, width = map[0].Length;
        bool Filled(int x, int y) => y >= 0 && y < height && x >= 0 && x < width && map[y][x] != '.';

        for (var y = -1; y <= height; y++)
            for (var x = -1; x <= width; x++)
                if (!Filled(x, y) && (Filled(x + 1, y) || Filled(x - 1, y) || Filled(x, y + 1) || Filled(x, y - 1)))
                    yield return (x + 1, y + 1, "#0b0b0c");

        for (var y = 0; y < height; y++)
            for (var x = 0; x < width; x++)
                if (map[y][x] != '.')
                    yield return (x + 1, y + 1, colors[map[y][x]]);
    }
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;700&family=VT323&display=swap" rel="stylesheet">
    <link href="~/css/bagery-pixel.css" rel="stylesheet">
}

@* ---------- HERO ---------- *@
<section class="px-hero">
    <div>
        <p class="px-kicker">ÜYE PANELİ · SEVİYE @Model.Level</p>
        <h2 class="px-type" style="--len: @greeting.Length">@greeting</h2>
        <p class="px-title"><i class='bx bxs-crown'></i> @Model.LevelTitle</p>

        <div class="px-xp-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@Model.XpPerLevel" aria-valuenow="@Model.LevelProgress" aria-label="Seviye ilerlemesi">
            @for (var i = 0; i < 20; i++)
            {
                <span class="@(i < xpCells ? "on" : "")" style="--i: @i"></span>
            }
        </div>
        <p class="px-xp-text">
            <span>@Model.Xp XP</span>
            <span>Sonraki seviyeye @(Model.XpPerLevel - Model.LevelProgress) XP</span>
        </p>
    </div>

    <div class="px-sprite" aria-hidden="true">
        <svg viewBox="0 0 16 16" shape-rendering="crispEdges">
            @foreach (var pixel in Pixels(Donut, DonutColors))
            {
                <rect x="@pixel.X" y="@pixel.Y" width="1" height="1" fill="@pixel.Fill" />
            }
        </svg>
        <span class="px-spark s1"></span>
        <span class="px-spark s2"></span>
        <span class="px-spark s3"></span>
        <div class="px-sprite-shadow"></div>
    </div>
</section>

@* ---------- SAYAÇLAR ---------- *@
<div class="px-stats">
    <div class="px-stat" style="--tone: #14b8a6">
        <i class='bx bx-receipt'></i>
        <strong data-count="@Model.PaidOrders">@Model.PaidOrders</strong>
        <span>Sipariş</span>
    </div>
    <div class="px-stat" style="--tone: #6366f1">
        <i class='bx bx-wallet'></i>
        <strong data-count="@Model.TotalSpent.ToString(CultureInfo.InvariantCulture)" data-money>@Model.TotalSpent.ToString("N2", tr) ₺</strong>
        <span>Harcama</span>
    </div>
    <div class="px-stat" style="--tone: #ff6b4a">
        <i class='bx bx-cake'></i>
        <strong data-count="@Model.ItemsBought">@Model.ItemsBought</strong>
        <span>Aldığın ürün</span>
    </div>
    <div class="px-stat" style="--tone: #f59e0b">
        <i class='bx bx-comment-dots'></i>
        <strong data-count="@Model.CommentsWritten">@Model.CommentsWritten</strong>
        <span>Yazdığın yorum</span>
    </div>
</div>

@* ---------- GRAFİKLER ---------- *@
<div class="px-grid">
    <section class="px-card">
        <div class="px-card-head">
            <h3 class="px-card-title">Son 6 ay harcaman</h3>
        </div>
        <div class="px-legend">
            <span class="is-d" style="--dot: var(--role)">Sütun: harcama, üstteki sayı: sipariş</span>
        </div>

        @if (spentMax == 0)
        {
            <p class="px-empty">HENÜZ SİPARİŞ YOK_</p>
        }
        else
        {
            <div class="px-chart">
                @foreach (var (month, monthIndex) in Model.Months.Select((m, i) => (m, i)))
                {
                    var filled = Cells(month.Spent, spentMax, Rows);
                    <div class="px-month" title="@month.Label: @month.Orders sipariş, @month.Spent.ToString("N2", tr) ₺">
                        <span class="px-col-top">@(month.Orders > 0 ? $"{month.Orders}×" : "")</span>
                        <div class="px-cols is-single">
                            <div class="px-col is-d">
                                @for (var r = 0; r < filled; r++)
                                {
                                    <span style="--i: @(monthIndex * 3 + r)"></span>
                                }
                            </div>
                        </div>
                        <small>@month.Label</small>
                    </div>
                }
            </div>
        }
    </section>

    <section class="px-card">
        <div class="px-card-head">
            <h3 class="px-card-title">En çok aldıkların</h3>
            <a href="/Product/Shop" target="_blank" rel="noopener" class="px-count" title="Mağaza">→</a>
        </div>

        @if (topMax == 0)
        {
            <p class="px-empty">İLK TATLINI SEÇ_</p>
        }
        else
        {
            <ol class="px-rows">
                @foreach (var (product, index) in Model.TopProducts.Select((p, i) => (p, i)))
                {
                    var filled = (int)Cells(product.Quantity, topMax, 20);
                    <li>
                        <div class="px-row-head">
                            <span>@product.Name</span>
                            <strong>@product.Quantity</strong>
                        </div>
                        <div class="px-track">
                            @for (var c = 0; c < 20; c++)
                            {
                                <span class="@(c < filled ? "on" : "")" style="--i: @(index * 5 + c)"></span>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </section>
</div>

@* ---------- SON SİPARİŞ + TATLI PROFİLİ ---------- *@
<div class="px-grid">
    <section class="px-card">
        <div class="px-card-head">
            <h3 class="px-card-title">Son siparişin</h3>
            <a href="/User/MyOrders/Index" class="px-count" title="Siparişlerim">→</a>
        </div>

        @if (Model.LastOrder is { } order)
        {
            <ul class="px-list">
                <li><span>Sipariş no</span><strong>#@order.OrderNo.Substring(0, 8).ToUpperInvariant()</strong></li>
                <li><span>Tarih</span><strong>@order.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm", tr)</strong></li>
                <li><span>Ürün</span><strong>@order.ItemCount adet</strong></li>
                <li><span>Tutar</span><strong>@order.PaidPrice.ToString("N2", tr) ₺</strong></li>
            </ul>
            <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap">
                <span class="px-status @(order.Status == OrderStatus.Pending ? "is-pending" : "")">@order.Status.ToTurkish()</span>
                <a href="/User/MyOrders/Detail?orderNo=@order.OrderNo" class="pn-btn is-sm"><i class='bx bx-show'></i> Detay</a>
            </div>
        }
        else
        {
            <p class="px-empty">SİPARİŞ BEKLENİYOR_</p>
        }
    </section>

    <section class="px-card">
        <div class="px-card-head">
            <h3 class="px-card-title">Tatlı profilin</h3>
        </div>
        <ul class="px-list">
            <li><span>En sevdiğin kategori</span><strong>@(Model.FavoriteCategory ?? "-")</strong></li>
            <li><span>En çok aldığın</span><strong>@(Model.TopProducts.FirstOrDefault()?.Name ?? "-")</strong></li>
            <li><span>Ortalama sepetin</span><strong>@Model.AverageBasket.ToString("N2", tr) ₺</strong></li>
            <li><span>Onay bekleyen</span><strong>@Model.PendingOrders</strong></li>
        </ul>
    </section>
</div>

@* ---------- ROZETLER ---------- *@
<section class="px-card">
    <div class="px-card-head">
        <h3 class="px-card-title">Rozetler</h3>
        <span class="px-count">@unlocked / @Model.Badges.Count</span>
    </div>
    <div class="px-badges">
        @foreach (var (badge, index) in Model.Badges.Select((b, i) => (b, i)))
        {
            <div class="px-badge @(badge.Unlocked ? "is-on" : "")" style="--i: @index">
                <span class="px-badge-icon"><i class='bx @(badge.Unlocked? badge.Icon: "bx-lock-alt")'></i></span>
                <strong>@badge.Title</strong>
                <small>@badge.Requirement</small>
            </div>
        }
    </div>
    <p class="px-note">XP nasıl kazanılır: her sipariş 50, aldığın her ürün 5, yazdığın her yorum 10 XP. Her 300 XP'de seviye atlarsın.</p>
</section>

@section Scripts {
    <script>
        (function () {
            // Sayılar sıfırdan hedefe doğru sayarak açılsın (hareket azaltma açıksa direkt son değer)
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const money = v => v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';

            document.querySelectorAll('[data-count]').forEach(function (el) {
                const target = parseFloat(el.dataset.count) || 0;
                const format = el.hasAttribute('data-money') ? money : v => Math.round(v).toLocaleString('tr-TR');

                if (reduceMotion || target === 0) { el.textContent = format(target); return; }

                const start = performance.now();
                const duration = 1200;
                function tick(now) {
                    const t = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - t, 3);
                    el.textContent = format(target * eased);
                    if (t < 1) requestAnimationFrame(tick);
                }
                el.textContent = format(0);
                requestAnimationFrame(tick);
            });
        })();
    </script>
}
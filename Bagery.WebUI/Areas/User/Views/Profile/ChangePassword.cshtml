@using Bagery.WebUI.MediatorPattern.Commands.UserCommands
@model ChangePasswordCommand
@{
    ViewData["Title"] = "Şifre değiştir";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";

    string FieldClass(string key) => ViewData.ModelState[key]?.Errors.Count > 0 ? "pn-field has-error" : "pn-field";
}

<div class="pn-narrow">

    <div class="pn-page-head">
        <div>
            <p class="pn-eyebrow">Hesabım</p>
            <h2>Şifre değiştir</h2>
        </div>
        <a href="/User/Profile/UpdateUser" class="pn-btn is-ghost"><i class='bx bx-user-circle'></i> Profilim</a>
    </div>

    <div asp-validation-summary="ModelOnly" class="pn-summary"></div>

    <form method="post" asp-action="ChangePassword">
        <section class="pn-section">

            <div class="pn-note">
                <i class='bx bx-shield-quarter'></i>
                <span>Şifreni değiştirdiğinde güvenliğin için oturumun kapanır. Yeni şifrenle tekrar giriş yaparsın.</span>
            </div>

            <div class="@FieldClass("NowPassword")">
                <label asp-for="NowPassword">Mevcut şifren</label>
                <div class="pn-password">
                    <input asp-for="NowPassword" type="password" autocomplete="current-password" />
                    <button type="button" data-toggle-password aria-label="Şifreyi göster"><i class='bx bx-show'></i></button>
                </div>
                <span asp-validation-for="NowPassword" class="pn-error"></span>
            </div>

            <div class="@FieldClass("NewPassword")">
                <label asp-for="NewPassword">Yeni şifre</label>
                <div class="pn-password">
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                    <button type="button" data-toggle-password aria-label="Şifreyi göster"><i class='bx bx-show'></i></button>
                </div>
                <div class="pn-strength" id="strength" data-level="0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                <ul class="pn-checks">
                    <li data-rule="length">En az 6 karakter</li>
                    <li data-rule="upper">Büyük harf</li>
                    <li data-rule="digit">Rakam</li>
                    <li data-rule="symbol">Sembol (!, ?, * ...)</li>
                </ul>
                <span asp-validation-for="NewPassword" class="pn-error"></span>
            </div>

            <div class="@FieldClass("NewConfirmPassword")">
                <label asp-for="NewConfirmPassword">Yeni şifre (tekrar)</label>
                <div class="pn-password">
                    <input asp-for="NewConfirmPassword" type="password" autocomplete="new-password" />
                    <button type="button" data-toggle-password aria-label="Şifreyi göster"><i class='bx bx-show'></i></button>
                </div>
                <div class="pn-field-foot">
                    <span asp-validation-for="NewConfirmPassword" class="pn-error"></span>
                    <span class="pn-match" id="match" aria-live="polite"></span>
                </div>
            </div>

            <button type="submit" class="pn-btn is-role"><i class='bx bx-lock-alt'></i> Şifremi değiştir</button>
        </section>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-toggle-password]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const input = button.parentElement.querySelector('input');
                    const show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    button.innerHTML = show ? "<i class='bx bx-hide'></i>" : "<i class='bx bx-show'></i>";
                    button.setAttribute('aria-label', show ? 'Şifreyi gizle' : 'Şifreyi göster');
                });
            });

            const password = document.getElementById('NewPassword');
            const confirm = document.getElementById('NewConfirmPassword');
            const meter = document.getElementById('strength');
            const match = document.getElementById('match');

            const rules = {
                length: v => v.length >= 6,
                upper: v => /[A-ZÇĞİÖŞÜ]/.test(v),
                digit: v => /\d/.test(v),
                symbol: v => /[^A-Za-z0-9ÇĞİÖŞÜçğıöşü]/.test(v)
            };

            function check() {
                const value = password.value;
                let score = 0;
                Object.entries(rules).forEach(function ([name, test]) {
                    const ok = test(value);
                    document.querySelector('[data-rule="' + name + '"]').classList.toggle('is-ok', ok);
                    if (ok) score++;
                });
                meter.dataset.level = value ? score : 0;

                if (!confirm.value) { match.textContent = ''; match.className = 'pn-match'; }
                else if (confirm.value === value) { match.textContent = 'Şifreler eşleşiyor'; match.className = 'pn-match is-ok'; }
                else { match.textContent = 'Şifreler eşleşmiyor'; match.className = 'pn-match is-bad'; }
            }

            password.addEventListener('input', check);
            confirm.addEventListener('input', check);
        })();
    </script>
}
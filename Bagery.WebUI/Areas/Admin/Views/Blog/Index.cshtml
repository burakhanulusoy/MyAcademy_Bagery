@model List<GetBlogsWithUserQueryResult>
@{
    ViewData["Title"] = "Bloglar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<div class="page-content-wrapper">
    <div class="page-content">

        <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-4">
            <div class="breadcrumb-title pe-3">Blog Yönetimi</div>
            <div class="ps-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 p-0 align-items-center">
                        <li class="breadcrumb-item">
                            <a href="javascript:;"><ion-icon name="home-outline"></ion-icon></a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Tüm Bloglar</li>
                    </ol>
                </nav>
            </div>
            <div class="ms-auto d-flex gap-2">
                <a href="/Admin/Blog/MyBlogs" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <i class="bx bx-user fs-5"></i> Benim Bloglarım
                </a>
                <a href="/Admin/Blog/CreateBlog" class="btn btn-primary d-flex align-items-center gap-2">
                    <i class="bx bx-plus-circle fs-5"></i> Yeni Blog Ekle
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-0 radius-10">
            <div class="card-body p-4">

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="mb-0 text-primary fw-bold">Sistemdeki Bloglar</h5>
                    <form class="position-relative w-25" onsubmit="return false;">
                        <div class="position-absolute top-50 translate-middle-y search-icon px-3">
                            <ion-icon name="search-sharp"></ion-icon>
                        </div>
                        <input class="form-control ps-5 rounded-pill" id="blogSearch" type="text" placeholder="Blog ara...">
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th width="5%">#</th>
                                <th width="32%">Blog</th>
                                <th width="20%">Yazar</th>
                                <th width="10%">Yorum</th>
                                <th width="15%">Tarih</th>
                                <th width="18%" class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody id="blogTableBody">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    count++;
                                    var commentCount = item.Comments?.Count ?? 0;

                                    <tr class="blog-row" data-search="@($"{item.Title} {item.AppUser?.FullName}".ToLower())">
                                        <td>
                                            <span class="badge bg-light text-dark border">@count</span>
                                        </td>

                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.ImageUrl1" alt="@item.Title"
                                                     class="rounded object-fit-cover" width="56" height="56"
                                                     onerror="this.src='/images/default-image.png'" />
                                                <div>
                                                    <h6 class="mb-1 fw-bold">@item.Title</h6>
                                                    <span class="text-secondary small d-block text-truncate" style="max-width: 280px;">
                                                        @item.ShortDescription
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="avatar-initial rounded-circle d-flex align-items-center justify-content-center fw-bold">
                                                    @(!string.IsNullOrWhiteSpace(item.AppUser?.FullName) ? item.AppUser.FullName.Substring(0, 1).ToUpper() : "U")
                                                </div>
                                                <span class="fw-semibold">@(item.AppUser?.FullName ?? "Bilinmiyor")</span>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="badge rounded-pill border text-secondary comment-badge">
                                                <i class="bx bx-message-rounded"></i> @commentCount
                                            </span>
                                        </td>

                                        <td>
                                            <span class="text-secondary">@item.CreatedAt.ToString("dd MMMM yyyy")</span>
                                        </td>

                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-secondary action-btn preview-btn"
                                                        title="İncele"
                                                        data-title="@item.Title"
                                                        data-author="@(item.AppUser?.FullName ?? "Bilinmiyor")"
                                                        data-date="@item.CreatedAt.ToString("dd MMMM yyyy")"
                                                        data-bg="@item.BackgroundImageUrl"
                                                        data-img="@item.ImageUrl1"
                                                        data-short="@item.ShortDescription"
                                                        data-main="@item.MainDescription"
                                                        data-longtitle="@item.LongTitle"
                                                        data-long="@item.LongDescription"
                                                        data-lasttitle="@item.LastDescriptionTitle"
                                                        data-last="@item.LastDescription"
                                                        data-target-comments="comments-@item.Id">
                                                    <i class="bx bx-show"></i>
                                                </button>
                                                <a href="/Admin/Blog/UpdateBlog/@item.Id"
                                                   class="btn btn-sm btn-outline-primary action-btn" title="Düzenle">
                                                    <i class="bx bx-edit"></i>
                                                </a>
                                                <button onclick="confirmDelete('/Admin/Blog/DeleteBlog/@item.Id')"
                                                        class="btn btn-sm btn-outline-danger action-btn" title="Sil">
                                                    <i class="bx bx-trash"></i>
                                                </button>
                                            </div>

                                            <!-- Modal için gizli yorum verisi -->
                                            <template id="comments-@item.Id">
                                                @if (commentCount > 0)
                                                {
                                                    foreach (var c in item.Comments.OrderByDescending(x => x.CreatedAt))
                                                    {
                                                        <div class="pv-comment">
                                                            <span class="pv-c-initial border text-secondary">
                                                                @(!string.IsNullOrWhiteSpace(c.AppUser?.FullName) ? c.AppUser.FullName.Substring(0, 1).ToUpper() : "U")
                                                            </span>
                                                            <div class="pv-c-body">
                                                                <div class="pv-c-head">
                                                                    <span class="pv-c-name">@(c.AppUser?.FullName ?? "Bilinmiyor")</span>
                                                                    <span class="pv-c-date text-secondary">@c.CreatedAt.ToString("dd MMM yyyy · HH:mm")</span>
                                                                </div>
                                                                <p class="pv-c-text text-secondary">@c.CommentContent</p>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <p class="text-secondary mb-0">Bu yazıya henüz yorum yapılmamış.</p>
                                                }
                                            </template>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-secondary">
                                        <div class="d-flex flex-column align-items-center">
                                            <i class="bx bx-news fs-1 mb-2 opacity-50 text-primary"></i>
                                            <h6 class="fw-semibold">Henüz blog eklenmemiş.</h6>
                                            <p class="mb-0 small">Yeni blog ekleyerek başlayabilirsiniz.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div id="noResult" class="text-center py-5 text-secondary d-none">
                        <p class="mb-0">Aramanızla eşleşen blog bulunamadı.</p>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>


<!-- ÖNİZLEME MODALI -->
<div class="modal fade" id="blogPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0">

            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title text-secondary">Blog Önizleme</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-0">

                <div class="preview-hero" id="pvHero">
                    <div class="preview-hero-overlay"></div>
                    <div class="preview-hero-content">
                        <h2 id="pvTitle"></h2>
                        <div class="preview-meta">
                            <span id="pvDate"></span>
                            <span class="mx-2">/</span>
                            <span id="pvAuthor"></span>
                        </div>
                    </div>
                </div>

                <div class="preview-body">

                    <p class="preview-short" id="pvShort"></p>

                    <p class="preview-text" id="pvMain"></p>

                    <div class="preview-split">
                        <div class="preview-split-text">
                            <h3 id="pvLongTitle"></h3>
                            <div class="preview-text" id="pvLong"></div>
                        </div>
                        <div class="preview-split-img">
                            <img id="pvImg" onerror="this.src='/images/default-image.png'" />
                        </div>
                    </div>

                    <div class="preview-last">
                        <h3 id="pvLastTitle"></h3>
                        <p class="preview-text" id="pvLast"></p>
                    </div>

                    <div class="preview-comments">
                        <h3><i class="bx bx-message-rounded-dots"></i> Yorumlar</h3>
                        <div id="pvComments"></div>
                    </div>

                </div>

            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>

        </div>
    </div>
</div>


<style>
    .avatar-initial {
        width: 34px;
        height: 34px;
        font-size: 14px;
        background: var(--bs-secondary-bg);
        color: var(--bs-body-color);
        flex-shrink: 0;
    }

    .comment-badge {
        font-size: 12px;
        font-weight: 600;
        padding: 6px 12px;
        background: transparent;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 16px;
        line-height: 1;
        transition: transform .2s ease;
    }

        .action-btn:hover {
            transform: scale(1.08);
        }

    /* --- Önizleme --- */
    .preview-hero {
        position: relative;
        min-height: 280px;
        background-size: cover;
        background-position: center;
        background-color: var(--bs-secondary-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .preview-hero-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, .5);
    }

    .preview-hero-content {
        position: relative;
        z-index: 2;
        padding: 40px 32px;
        max-width: 720px;
    }

        .preview-hero-content h2 {
            color: #fff;
            font-weight: 700;
            margin-bottom: 12px;
            line-height: 1.3;
        }

    .preview-meta {
        color: rgba(255, 255, 255, .85);
        font-size: 13px;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .preview-body {
        padding: 36px 40px 20px;
    }

    .preview-short {
        font-size: 17px;
        font-weight: 500;
        line-height: 1.7;
        margin-bottom: 22px;
        padding-left: 16px;
        border-left: 3px solid var(--bs-primary);
    }

    .preview-text {
        line-height: 1.85;
        color: var(--bs-secondary-color);
        white-space: pre-line;
        margin-bottom: 22px;
    }

    .preview-split {
        display: flex;
        gap: 28px;
        align-items: flex-start;
        margin: 32px 0;
    }

    .preview-split-text {
        flex: 1 1 55%;
    }

        .preview-split-text h3 {
            font-weight: 700;
            margin-bottom: 14px;
        }

    .preview-split-img {
        flex: 1 1 45%;
    }

        .preview-split-img img {
            width: 100%;
            border-radius: 10px;
            display: block;
        }

    .preview-last {
        border-top: 1px solid var(--bs-border-color);
        padding-top: 26px;
    }

        .preview-last h3 {
            font-weight: 700;
            margin-bottom: 14px;
        }

    /* --- Modal içi yorumlar --- */
    .preview-comments {
        border-top: 1px solid var(--bs-border-color);
        padding-top: 26px;
        margin-top: 10px;
    }

        .preview-comments h3 {
            font-weight: 700;
            margin-bottom: 18px;
            font-size: 20px;
        }

    .pv-comment {
        display: flex;
        gap: 12px;
        padding: 14px 0;
        border-bottom: 1px solid var(--bs-border-color);
    }

        .pv-comment:last-child {
            border-bottom: none;
        }

    .pv-c-initial {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
        background: transparent;
    }

    .pv-c-body {
        min-width: 0;
        flex: 1 1 auto;
    }

    .pv-c-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 4px;
    }

    .pv-c-name {
        font-weight: 600;
        font-size: 14px;
    }

    .pv-c-date {
        font-size: 12px;
    }

    .pv-c-text {
        margin: 0;
        line-height: 1.7;
        white-space: pre-line;
    }

    @@media (max-width: 768px) {
        .preview-split {
            flex-direction: column;
        }

        .preview-body {
            padding: 24px 20px 16px;
        }
    }
</style>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // --- Önizleme modalı ---
    document.querySelectorAll(".preview-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
            var d = this.dataset;

            document.getElementById("pvTitle").textContent = d.title;
            document.getElementById("pvAuthor").textContent = "YAZAR: " + d.author;
            document.getElementById("pvDate").textContent = d.date;
            document.getElementById("pvShort").textContent = d.short;
            document.getElementById("pvMain").textContent = d.main;
            document.getElementById("pvLongTitle").textContent = d.longtitle;
            document.getElementById("pvLong").textContent = d.long;
            document.getElementById("pvLastTitle").textContent = d.lasttitle;
            document.getElementById("pvLast").textContent = d.last;

            var hero = document.getElementById("pvHero");
            hero.style.backgroundImage = d.bg ? "url('" + d.bg + "')" : "none";

            document.getElementById("pvImg").src = d.img || "/images/default-image.png";

            // Yorumları template'ten kopyala
            var tpl = document.getElementById(d.targetComments);
            var box = document.getElementById("pvComments");
            box.innerHTML = "";
            if (tpl) {
                box.appendChild(tpl.content.cloneNode(true));
            }

            new bootstrap.Modal(document.getElementById("blogPreviewModal")).show();
        });
    });

    // --- Arama ---
    document.getElementById("blogSearch").addEventListener("keyup", function () {
        var term = this.value.trim().toLowerCase();
        var rows = document.querySelectorAll(".blog-row");
        var visible = 0;

        rows.forEach(function (row) {
            var match = row.dataset.search.includes(term);
            row.classList.toggle("d-none", !match);
            if (match) visible++;
        });

        document.getElementById("noResult").classList.toggle("d-none", visible > 0 || term === "");
    });

    // --- Silme ---
    function confirmDelete(deleteUrl) {
        Swal.fire({
            title: "Blogu silmek istiyor musunuz?",
            text: "Bu işlem geri alınamaz!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = deleteUrl;
            }
        });
    }
</script>
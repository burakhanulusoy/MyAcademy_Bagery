@using Bagery.WebUI.Enums
@model GetContactMessageByIdQueryResult
@{
    ViewData["Title"] = "Mesaj Detayı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@functions {
    string StatusColor(ContactMessageStatus status) => status.ToString() switch
    {
        "Pending" => "warning",
        "Read" => "info",
        "Answered" => "success",
        "Closed" => "secondary",
        _ => "secondary"
    };

    string StatusText(ContactMessageStatus status) => status.ToString() switch
    {
        "Pending" => "Beklemede",
        "Read" => "Okundu",
        "Answered" => "Cevaplandı",
        "Closed" => "Kapatıldı",
        _ => status.ToString()
    };
}

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="row">

            <div class="col-lg-8">
                <div class="card shadow-sm border-0 radius-10">
                    <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="mb-1 text-primary fw-bold">@Model.Subject</h5>
                                <p class="text-muted small mb-0">
                                    @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm") tarihinde gönderildi
                                </p>
                            </div>
                            <span class="badge bg-@StatusColor(Model.MessageStatus) fs-6">
                                @StatusText(Model.MessageStatus)
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="bg-light rounded p-4 mb-4" style="white-space: pre-wrap; line-height: 1.7;">@Model.Message</div>

                        <div class="d-flex gap-2">
                            <a href="mailto:@Model.Email?subject=RE: @Model.Subject"
                               class="btn btn-primary d-flex align-items-center gap-1">
                                <i class='bx bx-reply fs-5'></i> E-posta ile Yanıtla
                            </a>
                            <a href="tel:@Model.PhoneNumber"
                               class="btn btn-outline-secondary d-flex align-items-center gap-1">
                                <i class='bx bx-phone fs-5'></i> Ara
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 radius-10 mb-3">
                    <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                        <h6 class="mb-0 fw-bold">Gönderen Bilgileri</h6>
                    </div>
                    <div class="card-body p-4">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-3">
                                <span class="text-muted small d-block">Ad Soyad</span>
                                <span class="fw-semibold">@Model.NameSurname</span>
                            </li>
                            <li class="mb-3">
                                <span class="text-muted small d-block">E-posta</span>
                                <a href="mailto:@Model.Email" class="fw-semibold text-decoration-none">@Model.Email</a>
                            </li>
                            <li class="mb-0">
                                <span class="text-muted small d-block">Telefon</span>
                                <a href="tel:@Model.PhoneNumber" class="fw-semibold text-decoration-none">@Model.PhoneNumber</a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card shadow-sm border-0 radius-10">
                    <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                        <h6 class="mb-0 fw-bold">Durum Güncelle</h6>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-action="UpdateContactMessageStatus">
                            <input type="hidden" name="Id" value="@Model.Id" />

                            <select name="MessageStatus" class="form-select mb-3">
                                @foreach (var status in Enum.GetValues<ContactMessageStatus>())
                                {
                                    <option value="@((int)status)"
                                            selected="@(status.Equals(Model.MessageStatus) ? "selected" : null)">
                                        @StatusText(status)
                                    </option>
                                }
                            </select>

                            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-1">
                                <i class='bx bx-save fs-5'></i> Kaydet
                            </button>
                        </form>

                        <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2 d-flex align-items-center justify-content-center gap-1">
                            <i class='bx bx-arrow-back fs-5'></i> Listeye Dön
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
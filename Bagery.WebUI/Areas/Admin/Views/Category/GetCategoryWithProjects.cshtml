@model List<GetProductsByCategoryQueryResult>
@{
    ViewData["Title"] = "Kategori Ürünleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
    var categoryName = Model?.FirstOrDefault()?.Category?.CategoryName;
}

<style>
    .table thead th {
        background-color: rgba(255, 255, 255, 0.05);
        border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }
</style>

<div class="page-content-wrapper">
    <div class="page-content">

        <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
            <div class="breadcrumb-title pe-3">Kategori Ürünleri</div>
            <div class="ps-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 p-0 align-items-center">
                        <li class="breadcrumb-item">
                            <a href="/Admin/Category/Index">Kategorilerimiz</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            @(categoryName ?? "Ürün Listesi")
                        </li>
                    </ol>
                </nav>
            </div>
            <div class="ms-auto">
                <a href="/Admin/Category/Index" class="btn btn-outline-secondary px-4">
                    <i class="bx bx-arrow-back"></i> Geri Dön
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h5 class="mb-0">
                            @if (categoryName != null)
                            {
                                <span>@categoryName</span>
                                <span class="text-muted"> kategorisindeki ürünler</span>
                            }
                            else
                            {
                                <span>Ürünler</span>
                            }
                        </h5>
                        <p class="text-muted small mb-0 mt-1">Toplam @(Model?.Count ?? 0) ürün listeleniyor.</p>
                    </div>
                </div>

                @if (Model == null || !Model.Any())
                {
                    <div class="text-center p-5 border border-dashed rounded-3">
                        <i class="bx bx-package" style="font-size: 3rem; opacity: 0.4;"></i>
                        <h6 class="mt-3 mb-1">Bu kategoride ürün bulunmuyor</h6>
                        <p class="text-muted small mb-3">Ürün ekledikçe burada listelenecek.</p>
                        <a href="/Admin/Product/CreateProduct" class="btn btn-success px-4">
                            <i class="bx bx-plus"></i> Yeni Ürün Ekle
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Görsel</th>
                                    <th>Ürün Adı</th>
                                    <th>Açıklama</th>
                                    <th>Fiyat</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>
                                            <img src="@item.MainImageUrl" class="rounded shadow-sm"
                                                 style="width: 90px; height: 65px; object-fit: cover;" alt="">
                                        </td>
                                        <td class="fw-semibold">@item.ProductName</td>
                                        <td>
                                            <span class="text-muted small">
                                                @(item.Description?.Length > 80
                                                                                        ? item.Description.Substring(0, 80) + "..."
                                                                                        : item.Description)
                                    </span>
                                </td>
                                <td class="fw-bold">@item.Price.ToString("C")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <a href="/Admin/Product/UpdateProduct/@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bx bx-edit"></i> Güncelle
                                        </a>
                                        <a href="/Admin/Product/ProductDetail/@item.Id" class="btn btn-sm btn-outline-info">
                                            <i class="bx bx-detail"></i> Detay
                                        </a>
                                    </div>
                                </td>
                            </tr>
                                                        }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>

    </div>
</div>
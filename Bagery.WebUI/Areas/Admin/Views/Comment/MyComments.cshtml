@model List<GetCommentByUserIdQueryResult>
@{
    ViewData["Title"] = "Yorumlarım";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-content-wrapper">
    <div class="page-content">

        <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-4">
            <div class="breadcrumb-title pe-3">Yorum Yönetimi</div>
            <div class="ps-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 p-0 align-items-center">
                        <li class="breadcrumb-item">
                            <a href="javascript:;"><ion-icon name="home-outline"></ion-icon></a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Yorumlarım</li>
                    </ol>
                </nav>
            </div>
            <div class="ms-auto">
                <a href="/Admin/Comment/Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <i class="bx bx-list-ul fs-5"></i> Tüm Yorumlar
                </a>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="card shadow-sm border-0 radius-10 mb-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <span class="text-secondary small ps-2">Toplam @Model.Count yorum</span>
                        <div class="position-relative" style="min-width: 300px;">
                            <span class="position-absolute top-50 translate-middle-y ms-3 text-secondary">
                                <ion-icon name="search-sharp"></ion-icon>
                            </span>
                            <input class="form-control ps-5 rounded-pill" id="myCommentSearch" type="text"
                                   placeholder="Yorum veya blog ara...">
                        </div>
                    </div>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-lg-2 g-4" id="commentGrid">
                @foreach (var item in Model)
                {
                    <div class="col comment-item" data-search="@($"{item.CommentContent} {item.Blog?.Title} {item.Blog?.AppUser?.FullName}".ToLower())">
                        <div class="comment-card h-100">

                            <div class="comment-card-head">
                                <div class="d-flex align-items-center gap-2" style="min-width: 0;">
                                    <img src="@item.Blog?.ImageUrl1" alt="@item.Blog?.Title"
                                         class="rounded object-fit-cover" width="40" height="40"
                                         onerror="this.src='/images/default-image.png'" />
                                    <div style="min-width: 0;">
                                        <a href="/Blog/Detail/@item.BlogId" target="_blank" class="comment-blog d-block">
                                            @(item.Blog?.Title ?? "Blog")
                                        </a>
                                        <span class="comment-author">
                                            @(item.Blog?.AppUser?.FullName ?? "Bilinmiyor")
                                        </span>
                                    </div>
                                </div>
                                <span class="comment-date">@item.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>

                            <div class="comment-card-body">
                                <i class="bx bxs-quote-alt-left quote-icon"></i>
                                <p>@item.CommentContent</p>
                            </div>

                            <div class="comment-card-foot">
                                <a href="/Admin/Comment/UpdateComment/@item.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                                    <i class="bx bx-edit"></i> Düzenle
                                </a>
                                <button onclick="confirmDelete('/Admin/Comment/DeleteComment/@item.Id')"
                                        class="btn btn-sm btn-outline-danger action-btn" title="Sil">
                                    <i class="bx bx-trash"></i>
                                </button>
                            </div>

                        </div>
                    </div>
                }
            </div>

            <div id="noResult" class="text-center py-5 text-secondary d-none">
                <p class="mb-0">Aramanızla eşleşen yorum bulunamadı.</p>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 radius-10">
                <div class="card-body text-center py-5 text-secondary">
                    <i class="bx bx-message-square-dots fs-1 opacity-50 text-primary"></i>
                    <h6 class="fw-semibold mt-2">Henüz yorum yapmamışsınız.</h6>
                    <p class="small mb-3">Blog yazılarına yaptığınız yorumlar burada görünecek.</p>
                    <a href="/Admin/Blog/Index" class="btn btn-primary">Bloglara Göz At</a>
                </div>
            </div>
        }

    </div>
</div>

<style>
    .comment-card {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--bs-border-color);
        border-radius: 12px;
        background: var(--bs-body-bg);
        padding: 16px 18px;
        transition: border-color .2s ease;
    }

        .comment-card:hover {
            border-color: var(--bs-primary);
        }

    .comment-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--bs-border-color);
    }

    .comment-blog {
        font-size: 14px;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .comment-author {
        font-size: 12px;
        color: var(--bs-secondary-color);
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .comment-date {
        font-size: 12px;
        color: var(--bs-secondary-color);
        flex-shrink: 0;
    }

    .comment-card-body {
        position: relative;
        flex: 1 1 auto;
        padding: 16px 0 18px 26px;
    }

        .comment-card-body p {
            margin: 0;
            line-height: 1.7;
        }

    .quote-icon {
        position: absolute;
        left: 0;
        top: 14px;
        font-size: 18px;
        opacity: .35;
        color: var(--bs-primary);
    }

    .comment-card-foot {
        display: flex;
        gap: 8px;
        margin-top: auto;
    }

    .action-btn {
        width: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    var searchInput = document.getElementById("myCommentSearch");

    if (searchInput) {
        searchInput.addEventListener("keyup", function () {
            var term = this.value.trim().toLowerCase();
            var items = document.querySelectorAll(".comment-item");
            var visible = 0;

            items.forEach(function (el) {
                var match = el.dataset.search.includes(term);
                el.classList.toggle("d-none", !match);
                if (match) visible++;
            });

            document.getElementById("noResult").classList.toggle("d-none", visible > 0 || term === "");
        });
    }

    function confirmDelete(deleteUrl) {
        Swal.fire({
            title: "Yorumu silmek istiyor musunuz?",
            text: "Bu işlem geri alınamaz!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = deleteUrl;
            }
        });
    }
</script>
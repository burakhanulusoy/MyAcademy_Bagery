@model GetCommentByIdQueryResult
@{
    ViewData["Title"] = "Yorumu Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-content-wrapper">
    <div class="page-content">

        <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-4">
            <div class="breadcrumb-title pe-3">Yorum Yönetimi</div>
            <div class="ps-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 p-0 align-items-center">
                        <li class="breadcrumb-item"><a href="/Admin/Comment/MyComments">Yorumlarım</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Düzenle</li>
                    </ol>
                </nav>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card shadow-sm border-0 radius-10">
                    <div class="card-header bg-transparent border-bottom py-3">
                        <h6 class="mb-0 fw-bold">Yorumu Düzenle</h6>
                    </div>
                    <div class="card-body p-4">

                        <form method="post">
                            <input type="hidden" name="Id" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Yorum İçeriği</label>
                                <textarea class="form-control" name="CommentContent" rows="7"
                                          placeholder="Yorumunuzu yazınız..." required>@Model.CommentContent</textarea>
                            </div>

                            <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-0"></div>

                            <div class="d-flex gap-2 mt-4">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bx bx-save"></i> Kaydet
                                </button>
                                <a href="/Admin/Comment/MyComments" class="btn btn-outline-secondary px-4">
                                    İptal
                                </a>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 radius-10">
                    <div class="card-header bg-transparent border-bottom py-3">
                        <h6 class="mb-0 fw-bold">Yorum Bilgisi</h6>
                    </div>
                    <div class="card-body p-4">

                        <div class="mb-4">
                            <div class="small text-secondary mb-2">Yorum Yapılan Blog</div>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@Model.Blog?.ImageUrl1" alt="@Model.Blog?.Title"
                                     class="rounded object-fit-cover" width="48" height="48"
                                     onerror="this.src='/images/default-image.png'" />
                                <div style="min-width: 0;">
                                    <a href="/Blog/Detail/@Model.BlogId" target="_blank" class="fw-semibold d-block">
                                        @(Model.Blog?.Title ?? "Blog")
                                        <i class="bx bx-link-external"></i>
                                    </a>
                                    <span class="text-secondary small">
                                        @(Model.Blog?.AppUser?.FullName ?? "Bilinmiyor")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="info-row">
                            <span class="text-secondary small">Yorum Tarihi</span>
                            <span class="fw-semibold">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</span>
                        </div>

                        <div class="info-row">
                            <span class="text-secondary small">Yorum Sahibi</span>
                            <span class="fw-semibold">@(Model.AppUser?.FullName ?? "Bilinmiyor")</span>
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<style>
    .info-row {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 12px 0;
        border-top: 1px solid var(--bs-border-color);
    }

    .validation-summary-valid {
        display: none;
    }
</style>
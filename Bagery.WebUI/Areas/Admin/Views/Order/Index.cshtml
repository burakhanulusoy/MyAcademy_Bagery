@using Bagery.WebUI.Enums
@using Bagery.WebUI.MediatorPattern.Results.OrderResults
@model GetAdminOrdersQueryResult
@{
    ViewData["Title"] = "Siparişler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@functions {
    // "Burak Han Ulusoy" -> "BH"
    static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                          .Take(2)
                          .Select(p => char.ToUpper(p[0], new System.Globalization.CultureInfo("tr-TR"))));

    // Seçili filtre koyu görünsün
    string Active(OrderStatus? status) => Model.SelectedStatus == status ? "is-active" : "";
}

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="bo">

            <header class="bo-head">
                <div>
                    <p class="bo-eyebrow">Yönetim</p>
                    <h1 class="bo-title">Siparişler</h1>
                    <p class="bo-sub">Toplam @Model.TotalCount sipariş</p>
                </div>
            </header>

            @* Özet: ciro kartı büyük ve siyah, diğerleri çerçeveli *@
            <div class="bo-stats">
                <div class="bo-stat is-hero">
                    <div class="label"><i class='bx bx-wallet'></i> Toplam ciro</div>
                    <div class="value">@Model.PaidTotal.ToString("N2") <small>₺</small></div>
                    <div class="foot">Sadece ödemesi onaylanan siparişler</div>
                </div>
                <div class="bo-stat">
                    <div class="label"><i class='bx bx-check-circle'></i> Ödenen</div>
                    <div class="value">@Model.PaidCount</div>
                </div>
                <div class="bo-stat">
                    <div class="label"><i class='bx bx-time-five'></i> Bekleyen</div>
                    <div class="value">@Model.PendingCount</div>
                </div>
                <div class="bo-stat">
                    <div class="label"><i class='bx bx-x-circle'></i> Başarısız</div>
                    <div class="value">@Model.FailedCount</div>
                </div>
            </div>

            @if (Model.PendingCount > 0)
            {
                <div class="bo-notice">
                    <i class='bx bx-info-circle'></i>
                    <span><strong>@Model.PendingCount sipariş</strong> PayTR bildirimini bekliyor. Uzun süredir bekleyen varsa PayTR panelinde "Mağaza Bildirimleri"ni kontrol edin.</span>
                </div>
            }

            <div class="bo-toolbar">
                <nav class="bo-segment" aria-label="Durum filtresi">
                    <a href="/Admin/Order/Index" class="@Active(null)">Tümü <span class="count">@Model.TotalCount</span></a>
                    <a href="/Admin/Order/Index?status=Paid" class="@Active(OrderStatus.Paid)">Ödendi <span class="count">@Model.PaidCount</span></a>
                    <a href="/Admin/Order/Index?status=Pending" class="@Active(OrderStatus.Pending)">Bekliyor <span class="count">@Model.PendingCount</span></a>
                    <a href="/Admin/Order/Index?status=Failed" class="@Active(OrderStatus.Failed)">Başarısız <span class="count">@Model.FailedCount</span></a>
                </nav>
            </div>

            <div class="bo-card">
                @if (!Model.Orders.Any())
                {
                    <div class="bo-empty">
                        <div class="icon"><i class='bx bx-receipt'></i></div>
                        <h3>Bu durumda sipariş yok</h3>
                        <p>Başka bir filtre seçin ya da tüm siparişlere dönün.</p>
                        <a href="/Admin/Order/Index" class="bo-btn">Tüm siparişler</a>
                    </div>
                }
                else
                {
                    <div class="bo-table-wrap">
                        <table class="bo-table">
                            <thead>
                                <tr>
                                    <th>Sipariş</th>
                                    <th>Müşteri</th>
                                    <th>Tarih</th>
                                    <th class="num">Adet</th>
                                    <th class="num">Tutar</th>
                                    <th>Durum</th>
                                    <th>Teslimat</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders)
                                {
                                    var created = order.CreatedAt.ToLocalTime(); // veritabanında UTC

                                    <tr>
                                        <td><span class="bo-code" title="@order.OrderNo">#@order.OrderNo.Substring(0, 8).ToUpperInvariant()</span></td>
                                        <td>
                                            <div class="bo-person">
                                                <span class="bo-avatar">@Initials(order.FullName)</span>
                                                <div>
                                                    <strong>@order.FullName</strong>
                                                    <small>@order.Email</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="bo-date">
                                            @created.ToString("dd MMM yyyy")
                                            <small>@created.ToString("HH:mm")</small>
                                        </td>
                                        <td class="num">@order.ItemCount</td>
                                        <td class="num">
                                            <span class="bo-amount">@order.PaidPrice.ToString("N2") ₺</span>
                                            @if (order.InstallmentCount > 0)
                                            {
                                                <small>@order.InstallmentCount taksit</small>
                                            }
                                        </td>
                                        <td><span class="bo-pill is-@order.Status.ToString().ToLower()">@order.Status.ToTurkish()</span></td>
                                        <td>
                                            @if (order.Status == OrderStatus.Paid)
                                            {
                                                <span class="bo-pill is-@order.DeliveryStatus.ToString().ToLower()">@order.DeliveryStatus.ToTurkish()</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">-</span>
                                            }
                                        </td>
                                        <td class="num">
                                            <a href="/Admin/Order/Detail?orderNo=@order.OrderNo" class="bo-go" aria-label="Sipariş detayı"><i class='bx bx-right-arrow-alt'></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
@using Bagery.WebUI.Enums
@using Bagery.WebUI.MediatorPattern.Results.OrderResults
@model GetAdminOrderDetailQueryResult
@{
    ViewData["Title"] = "Sipariş Detayı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var installmentFee = Model.PaidPrice - (Model.TotalPrice + Model.ShippingPrice - Model.CouponPrice);

    // ---------- Kanıt çizelgesi: bütün olaylar zaman sırasıyla ----------
    var events = new List<(DateTime At, string Title, string? By, string Css)>
    {
        (Model.CreatedAt, "Sipariş oluşturuldu", null, "is-done")
    };

    if (Model.PaidAt is DateTime paidAt)
        events.Add((paidAt, "Ödeme onaylandı", "PayTR", "is-done"));

    if (Model.DeliveryLogs.Any())
    {
        // Kayıt tablosu: yola çıkış, teslim ve geri almalar (hiçbiri silinmez)
        events.AddRange(Model.DeliveryLogs.Select(log =>
            (log.CreatedAt, log.Action, (string?)log.PerformedBy,
             log.Action.StartsWith("Geri alındı") ? "is-undo" : "is-done")));
    }
    else
    {
        // Kayıt tablosundan önceki siparişler: siparişteki alanlardan
        if (Model.DispatchedAt is DateTime dispatchedAt)
            events.Add((dispatchedAt, "Yola çıktı", Model.DispatchedBy, "is-done"));
        if (Model.DeliveredAt is DateTime deliveredAt)
            events.Add((deliveredAt, "Teslim edildi", Model.DeliveredBy, "is-done"));
    }

    events = events.OrderBy(e => e.At).ToList();

    // Henüz gerçekleşmemiş sıradaki adım
    string? nextStep = Model.Status switch
    {
        OrderStatus.Pending => "PayTR bildirimi bekleniyor",
        OrderStatus.Failed => null,
        _ => Model.DeliveryStatus switch
        {
            DeliveryStatus.Waiting => "Yola çıkması bekleniyor",
            DeliveryStatus.OnTheWay => "Teslim edilmesi bekleniyor",
            _ => null
        }
    };

    int? totalMinutes = Model.PaidAt is DateTime p && Model.DeliveredAt is DateTime d
        ? (int)Math.Round((d - p).TotalMinutes)
        : null;
}
@functions {
    static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                          .Take(2)
                          .Select(p => char.ToUpper(p[0], new System.Globalization.CultureInfo("tr-TR"))));
}

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="bo">

            <section class="bo-hero">
                <div>
                    <p class="bo-eyebrow">Sipariş</p>
                    <div class="bo-hero-row">
                        <span class="bo-hero-no">#@Model.OrderNo.Substring(0, 8).ToUpperInvariant()</span>
                        <span class="bo-pill is-@Model.Status.ToString().ToLower()">@Model.Status.ToTurkish()</span>
                        @if (Model.Status == OrderStatus.Paid)
                        {
                            @* YENİ: teslimat durumu *@
                            <span class="bo-pill is-@Model.DeliveryStatus.ToString().ToLower()">@Model.DeliveryStatus.ToTurkish()</span>
                        }
                    </div>
                    <div class="bo-hero-meta">
                        <span><i class='bx bx-calendar'></i> @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</span>
                        <span><i class='bx bx-barcode'></i> <span class="mono">@Model.OrderNo</span></span>
                    </div>
                </div>
                <div class="bo-hero-actions">
                    <a href="mailto:@Model.Email" class="bo-btn is-ghost"><i class='bx bx-envelope'></i> Müşteriye yaz</a>
                    <a href="/Admin/Delivery/Index" class="bo-btn is-ghost"><i class='bx bx-cycling'></i> Sipariş takibi</a>
                    <a href="/Admin/Order/Index" class="bo-btn"><i class='bx bx-arrow-back'></i> Siparişler</a>
                </div>
            </section>

            <div class="bo-grid">

                @* SOL: ürünler + kanıt çizelgesi *@
                <div class="bo-stack">
                    <section class="bo-section">
                        <h2 class="bo-section-title"><i class='bx bx-package'></i> Ürünler <span class="count">@Model.OrderItems.Sum(x => x.Quantity) adet</span></h2>
                        <ul class="bo-items">
                            @foreach (var item in Model.OrderItems)
                            {
                                <li class="bo-item">
                                    <img src="@item.ImageUrl" alt="">
                                    <div>
                                        <div class="name">@item.ProductName <span class="bo-qty">@item.Quantity adet</span></div>
                                        <div class="meta">@(item.VariantName ?? "Standart"), birim @item.UnitPrice.ToString("N2") ₺</div>
                                    </div>
                                    <div class="total">@item.LineTotal.ToString("N2") ₺</div>
                                </li>
                            }
                        </ul>
                    </section>

                    <section class="bo-section is-strong">
                        <h2 class="bo-section-title"><i class='bx bx-shield-quarter'></i> Sipariş geçmişi <span class="count">kanıt kaydı</span></h2>
                        <ol class="bo-timeline">
                            @foreach (var e in events)
                            {
                                <li class="@e.Css">
                                    <span class="dot"></span>
                                    <strong>@e.Title</strong>
                                    <small>@e.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")@(e.By is null ? "" : $" · {e.By}")</small>
                                </li>
                            }
                            @if (Model.Status == OrderStatus.Failed)
                            {
                                <li class="is-fail">
                                    <span class="dot"></span>
                                    <strong>Ödeme başarısız</strong>
                                    <small>@Model.StatusMessage</small>
                                </li>
                            }
                            @if (nextStep is not null)
                            {
                                <li class="is-current">
                                    <span class="dot"></span>
                                    <strong>@nextStep</strong>
                                </li>
                            }
                        </ol>

                        @if (totalMinutes is int minutes)
                        {
                            <p class="bo-evidence @(minutes > 40 ? "is-late" : "")">
                                <i class='bx bx-timer'></i> Ödemeden teslime <strong>@minutes dakika</strong>
                            </p>
                        }
                    </section>
                </div>

                @* SAĞ: müşteri + ödeme *@
                <div class="bo-stack">
                    <section class="bo-section">
                        <h2 class="bo-section-title"><i class='bx bx-user'></i> Müşteri</h2>
                        <div class="bo-person is-lg">
                            <span class="bo-avatar">@Initials(Model.FullName)</span>
                            <div>
                                <strong>@Model.FullName</strong>
                                <small>Hesap: @Model.AppUserFullName</small>
                            </div>
                        </div>
                        <ul class="bo-info">
                            <li><i class='bx bx-envelope'></i><div><small>E-posta</small><a href="mailto:@Model.Email">@Model.Email</a></div></li>
                            <li><i class='bx bx-phone'></i><div><small>Telefon</small><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></div></li>
                            <li><i class='bx bx-map'></i><div><small>Teslimat adresi</small><span>@Model.Address</span></div></li>
                            @if (!string.IsNullOrWhiteSpace(Model.Note))
                            {
                                <li><i class='bx bx-note'></i><div><small>Sipariş notu</small><span>@Model.Note</span></div></li>
                            }
                        </ul>
                    </section>

                    <section class="bo-section">
                        <h2 class="bo-section-title"><i class='bx bx-credit-card'></i> Ödeme</h2>
                        <ul class="bo-receipt">
                            <li><span>Ara toplam</span><span>@Model.TotalPrice.ToString("N2") ₺</span></li>
                            @if (Model.CouponPrice > 0)
                            {
                                <li><span>İndirim (@Model.CouponCode)</span><span>−@Model.CouponPrice.ToString("N2") ₺</span></li>
                            }
                            <li><span>Kargo</span><span>@(Model.ShippingPrice == 0 ? "Ücretsiz" : Model.ShippingPrice.ToString("N2") + " ₺")</span></li>
                            @if (installmentFee > 0)
                            {
                                <li><span>Vade farkı</span><span>@installmentFee.ToString("N2") ₺</span></li>
                            }
                            <li><span>Ödeme şekli</span><span>@(Model.InstallmentCount == 0 ? "Tek çekim" : $"{Model.InstallmentCount} taksit ({Model.CardBrand})")</span></li>
                            <li class="is-total"><span>Ödenen</span><span>@Model.PaidPrice.ToString("N2") ₺</span></li>
                        </ul>
                    </section>
                </div>

            </div>
        </div>
    </div>
</div>
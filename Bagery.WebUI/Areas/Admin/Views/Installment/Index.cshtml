@{
    ViewData["Title"] = "Taksit Oranları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // diğer admin sayfalarındaki gibi
}

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-2">PayTR taksit oranları</h5>
                <p class="text-muted mb-3">
                    Oranlar PayTR'den alınıp veritabanına kaydedilir. Ödeme sayfasındaki taksit seçenekleri bu kayıtları kullanır.
                    PayTR oranları değiştiğinde yeniden güncelleyin.
                </p>
                <button type="button" id="updateRatesBtn" class="btn btn-primary">Taksit oranlarını güncelle</button>
                <div id="updateRatesResult" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('updateRatesBtn').addEventListener('click', async function () {
        const btn = this;
        const resultBox = document.getElementById('updateRatesResult');

        btn.disabled = true; // PayTR cevap verene kadar tekrar basılmasın
        resultBox.className = 'mt-3';
        resultBox.textContent = "PayTR'den oranlar alınıyor...";

        let data = null;
        try {
            const response = await fetch('/Admin/Installment/UpdateRates', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' } // hata olursa JSON gelsin (Adım 4.1)
            });
            data = await response.json();
        } catch { /* JSON gelmediyse aşağıda genel mesaj gösterilir */ }

        btn.disabled = false;

        if (!data) {
            resultBox.className = 'mt-3 alert alert-danger';
            resultBox.textContent = 'Beklenmeyen bir hata oluştu. Visual Studio Output penceresine bakın.';
            return;
        }

        resultBox.className = 'mt-3 alert ' + (data.success ? 'alert-success' : 'alert-danger');
        resultBox.textContent = data.message;
    });
</script>
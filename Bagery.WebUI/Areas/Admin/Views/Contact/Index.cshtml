@model List<GetContactsWithSocialMediaQueryResult>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<style>
    .ct-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

        .ct-head h5 {
            margin: 0 0 3px;
            font-weight: 600;
        }

        .ct-head p {
            margin: 0;
            font-size: 13px;
            opacity: .6;
        }

    /* Kayıt kartı */
    .ct-card {
        position: relative;
        border: 1px solid rgba(128,128,128,.18);
        border-radius: 16px;
        background: inherit;
        margin-bottom: 18px;
        overflow: hidden;
        transition: border-color .2s ease;
    }

        .ct-card:hover {
            border-color: rgba(128,128,128,.35);
        }

        .ct-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: rgba(128,128,128,.25);
        }

        .ct-card.is-active::before {
            background: #4caf7d;
        }

    .ct-top {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 20px;
        padding: 22px 24px;
    }

    .ct-fields {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 18px 28px;
        flex: 1;
        min-width: 0;
    }

    .ct-field .lbl {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .07em;
        text-transform: uppercase;
        opacity: .45;
        margin-bottom: 5px;
    }

    .ct-field .val {
        font-size: 14px;
        word-break: break-word;
        line-height: 1.45;
    }

    .ct-field a {
        color: inherit;
        text-decoration: none;
    }

        .ct-field a:hover {
            text-decoration: underline;
        }

    /* Durum rozeti */
    .ct-state {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: .04em;
        padding: 5px 12px;
        border-radius: 999px;
        border: 1px solid rgba(128,128,128,.3);
        white-space: nowrap;
    }

        .ct-state.on {
            border-color: rgba(76,175,125,.45);
            color: #4caf7d;
        }

    .ct-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
        opacity: .8;
    }

    .ct-state.on .ct-dot {
        box-shadow: 0 0 0 3px rgba(76,175,125,.18);
    }

    /* Sosyal medya bölümü */
    .ct-social {
        padding: 18px 24px 20px;
        border-top: 1px dashed rgba(128,128,128,.22);
    }

    .ct-social-lbl {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .07em;
        text-transform: uppercase;
        opacity: .45;
        margin-bottom: 12px;
    }

    .ct-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .ct-chip {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 6px 8px 6px 10px;
        border: 1px solid rgba(128,128,128,.25);
        border-radius: 999px;
        font-size: 13px;
        transition: border-color .2s ease, background-color .2s ease;
    }

        .ct-chip:hover {
            border-color: rgba(128,128,128,.5);
            background: rgba(128,128,128,.06);
        }

        .ct-chip img {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            object-fit: cover;
        }

        .ct-chip > a.name {
            color: inherit;
            text-decoration: none;
        }

            .ct-chip > a.name:hover {
                text-decoration: underline;
            }

        .ct-chip .tools {
            display: flex;
            gap: 2px;
            padding-left: 8px;
            margin-left: 1px;
            border-left: 1px solid rgba(128,128,128,.25);
        }

            .ct-chip .tools a {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                opacity: .55;
                transition: opacity .15s ease, background-color .15s ease;
            }

                .ct-chip .tools a:hover {
                    opacity: 1;
                    background: rgba(128,128,128,.15);
                }

        .ct-chip.add {
            border-style: dashed;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            opacity: .7;
            padding: 6px 14px;
        }

            .ct-chip.add:hover {
                opacity: 1;
                border-color: rgba(76,175,125,.6);
                color: #4caf7d;
            }

    .ct-empty-social {
        font-size: 13px;
        opacity: .5;
        font-style: italic;
    }

    /* Aksiyonlar */
    .ct-actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
    }

        .ct-actions .btn {
            border-radius: 9px;
            font-size: 13px;
            padding: 7px 14px;
        }

    /* Boş durum */
    .ct-empty {
        text-align: center;
        padding: 70px 20px;
        border: 1px dashed rgba(128,128,128,.3);
        border-radius: 16px;
    }

        .ct-empty ion-icon {
            font-size: 42px;
            opacity: .3;
            margin-bottom: 12px;
        }
</style>

<div class="page-content-wrapper">
    <div class="page-content">

        <div class="ct-head">
            <div>
                <h5>İletişim Bilgileri</h5>
                <p>Sitede görünen iletişim kaydı ve bağlı sosyal medya hesapları.</p>
            </div>
            <a href="/Admin/Contact/CreateContact" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <ion-icon name="add-outline"></ion-icon> Yeni Kayıt
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                count++;
                var isActive = count == 1;

                <div class="ct-card @(isActive ? "is-active" : "")">

                    <div class="ct-top">
                        <div class="ct-fields">

                            <div class="ct-field">
                                <div class="lbl"><ion-icon name="mail-outline"></ion-icon> E-posta</div>
                                <div class="val">
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <a href="mailto:@item.Email">@item.Email</a>
                                    }
                                    else
                                    {
                                        <span class="opacity-50">—</span>
                                    }
                                </div>
                            </div>

                            <div class="ct-field">
                                <div class="lbl"><ion-icon name="call-outline"></ion-icon> Telefon</div>
                                <div class="val">
                                    @if (!string.IsNullOrWhiteSpace(item.PhoneNumber))
                                    {
                                        <a href="tel:@item.PhoneNumber">@item.PhoneNumber</a>
                                    }
                                    else
                                    {
                                        <span class="opacity-50">—</span>
                                    }
                                </div>
                            </div>

                            <div class="ct-field">
                                <div class="lbl"><ion-icon name="time-outline"></ion-icon> Çalışma Saatleri</div>
                                <div class="val">@item.OpeningHour <span class="opacity-50">—</span> @item.ClosingHour</div>
                            </div>

                            <div class="ct-field" style="grid-column: 1 / -1;">
                                <div class="lbl"><ion-icon name="location-outline"></ion-icon> Adres</div>
                                <div class="val">@(string.IsNullOrWhiteSpace(item.Address) ? "—" : item.Address)</div>
                            </div>

                        </div>

                        <div class="d-flex flex-column align-items-end gap-3">
                            <span class="ct-state @(isActive ? "on" : "")">
                                <span class="ct-dot"></span>
                                @(isActive ? "Sitede Aktif" : "Pasif Kayıt")
                            </span>
                            <div class="ct-actions">
                                <a href="/Admin/Contact/UpdateContact/@item.Id" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                                    <ion-icon name="create-outline"></ion-icon> Düzenle
                                </a>
                                <button onclick="confirmDelete('/Admin/Contact/DeleteContact/@item.Id')"
                                        class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                    <ion-icon name="trash-outline"></ion-icon> Sil
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="ct-social">
                        <div class="ct-social-lbl">Sosyal Medya Hesapları</div>
                        <div class="ct-chips">

                            @if (item.ContactSocialMedias != null && item.ContactSocialMedias.Any())
                            {
                                foreach (var sm in item.ContactSocialMedias)
                                {
                                    <div class="ct-chip">
                                        <img src="@sm.IconUrl" alt="@sm.SocialMediaName"
                                             onerror="this.src='/images/default-social.png'" />
                                        <a href="@sm.SocialMediaUrl" target="_blank" rel="noopener"
                                           class="name" title="Linki aç">@sm.SocialMediaName</a>
                                        <div class="tools">
                                            <a href="/Admin/ContactSocialMedia/UpdateContactSocialMedia/@sm.Id" title="Güncelle">
                                                <ion-icon name="create-outline"></ion-icon>
                                            </a>
                                            <a href="javascript:void(0);" class="text-danger"
                                               onclick="confirmDelete('/Admin/ContactSocialMedia/DeleteContactSocialMedia/@sm.Id')" title="Sil">
                                                <ion-icon name="close-outline"></ion-icon>
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="ct-empty-social">Henüz hesap eklenmemiş.</span>
                            }

                            <a href="/Admin/ContactSocialMedia/CreateContactSocialMedia/@item.Id" class="ct-chip add">
                                <ion-icon name="add-outline"></ion-icon> Hesap Ekle
                            </a>

                        </div>
                    </div>

                </div>
            }
        }
        else
        {
            <div class="ct-empty">
                <ion-icon name="call-outline"></ion-icon>
                <p class="mb-3 opacity-75">Henüz iletişim kaydı eklenmemiş.</p>
                <a href="/Admin/Contact/CreateContact" class="btn btn-primary btn-sm">İlk kaydı oluştur</a>
            </div>
        }

    </div>
</div>

<script>
    function confirmDelete(deleteUrl) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlem geri alınamaz.",
            icon: "warning",
            showCancelButton: true,
            reverseButtons: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Evet, sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.showLoading();
                window.location.href = deleteUrl;
            }
        });
    }
</script>
@model List<GetClientsQueryResult>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<style>
    .table thead th {
        background-color: rgba(255, 255, 255, 0.05);
        border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }
</style>

<div class="page-content-wrapper">
    <div class="page-content">

        <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
            <div class="breadcrumb-title pe-3">Müşterilerimiz</div>
            <div class="ps-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 p-0 align-items-center">
                        <li class="breadcrumb-item">
                            <a href="javascript:;"><ion-icon name="home-outline"></ion-icon></a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Marka Listesi</li>
                    </ol>
                </nav>
            </div>
            <div class="ms-auto">
                <a href="/Admin/Client/CreateClient" class="btn btn-success px-4 d-flex align-items-center gap-2">
                    <i class="bx bx-plus"></i> Yeni Ekle
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h5 class="mb-0">Marka Detayları</h5>
                        <p class="text-muted small mb-0 mt-1">Toplam @(Model?.Count ?? 0) kayıt listeleniyor.</p>
                    </div>
                </div>

                @if (Model == null || !Model.Any())
                {
                    <div class="text-center p-5 border border-dashed rounded-3">
                        <i class="bx bx-buildings" style="font-size: 3rem; opacity: 0.4;"></i>
                        <h6 class="mt-3 mb-1">Henüz kayıt eklenmemiş</h6>
                        <p class="text-muted small mb-3">İlk markanızı ekleyerek başlayın.</p>
                        <a href="/Admin/Client/CreateClient" class="btn btn-success px-4">
                            <i class="bx bx-plus"></i> Yeni Ekle
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Logo</th>
                                    <th>Marka Adı</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>
                                            <img src="@item.ClientImageUrl" class="rounded shadow-sm"
                                                 style="width: 110px; height: 70px; object-fit: contain;" alt="@item.Name">
                                        </td>
                                        <td class="fw-semibold">@item.Name</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <a href="/Admin/Client/UpdateClient/@item.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bx bx-edit"></i> Güncelle
                                                </a>
                                                <button type="button" onclick="deleteItem('@item.Id')" class="btn btn-sm btn-outline-danger">
                                                    <i class="bx bx-trash"></i> Sil
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>

    </div>
</div>

<script>
    function deleteItem(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Evet, sil!",
            cancelButtonText: "İptal",
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Admin/Client/DeleteClient/" + id;
            }
        });
    }
</script>
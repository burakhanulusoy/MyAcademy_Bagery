@model CreateClientCommand
@{
    ViewData["Title"] = "CreateClient";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .form-control[type="file"]::file-selector-button {
        background-color: rgba(255, 255, 255, 0.08);
        color: inherit;
        border: 0;
        border-inline-end: 1px solid rgba(255, 255, 255, 0.15);
        padding: 0.375rem 1rem;
        margin-inline-end: 0.75rem;
        transition: background-color 0.15s ease;
    }

        .form-control[type="file"]::file-selector-button:hover {
            background-color: rgba(255, 255, 255, 0.15);
        }
</style>

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Yeni Marka Ekle</h6>
            </div>
            <div class="card-body">
                <form enctype="multipart/form-data" method="post" id="createItemForm">

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Marka Adı</label>
                        <input class="form-control" type="text" placeholder="Marka adını yazınız..." asp-for="Name" />
                        <span class="badge bg-danger text-wrap text-start mt-1 p-2" asp-validation-for="Name"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Logo Görseli</label>
                        <input class="form-control" type="file" asp-for="ClientImage" accept="image/*" onchange="previewImage(this)" />
                        <span class="badge bg-danger text-wrap text-start mt-1 p-2" asp-validation-for="ClientImage"></span>
                    </div>

                    <div class="mb-3" id="previewBox" style="display:none;">
                        <label class="form-label">Önizleme</label>
                        <div>
                            <img id="preview" class="rounded border shadow-sm"
                                 style="width: 160px; height: 100px; object-fit: contain;" alt="">
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="button" onclick="confirmCreate()" class="btn btn-success px-5">
                            <i class="bx bx-save"></i> Kaydet
                        </button>
                        <a href="/Admin/Client/Index" class="btn btn-outline-secondary px-5">
                            <i class="bx bx-x"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById("preview").src = e.target.result;
                document.getElementById("previewBox").style.display = "block";
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function confirmCreate() {
        var form = document.getElementById("createItemForm");
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        Swal.fire({
            title: "Kaydetmek istediğinize emin misiniz?",
            text: "Yeni marka sisteme eklenecektir.",
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#198754",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Evet, Ekle!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
    }
</script>
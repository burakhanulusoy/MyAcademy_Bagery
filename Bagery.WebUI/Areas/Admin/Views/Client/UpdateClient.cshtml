@model UpdateClientCommand
@{
    ViewData["Title"] = "UpdateClient";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .form-control[type="file"]::file-selector-button {
        background-color: rgba(255, 255, 255, 0.08);
        color: inherit;
        border: 0;
        border-inline-end: 1px solid rgba(255, 255, 255, 0.15);
        padding: 0.375rem 1rem;
        margin-inline-end: 0.75rem;
        transition: background-color 0.15s ease;
    }

        .form-control[type="file"]::file-selector-button:hover {
            background-color: rgba(255, 255, 255, 0.15);
        }
</style>

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Marka Güncelle</h6>
            </div>
            <div class="card-body">
                <form enctype="multipart/form-data" method="post" id="updateItemForm">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ClientImageUrl" />

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Marka Adı</label>
                        <input class="form-control" type="text" placeholder="Marka adını yazınız..." asp-for="Name" />
                        <span class="badge bg-danger text-wrap text-start mt-1 p-2" asp-validation-for="Name"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mevcut Görsel</label>
                        <div>
                            <img id="preview" src="@Model.ClientImageUrl" class="rounded border shadow-sm"
                                 style="width: 160px; height: 100px; object-fit: contain;" alt="">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Yeni Görsel Seçin</label>
                        <input class="form-control" type="file" asp-for="ClientImage" accept="image/*" onchange="previewImage(this)" />
                        <div class="form-text">Görseli değiştirmek istemiyorsanız boş bırakın.</div>
                        <span class="badge bg-danger text-wrap text-start mt-1 p-2" asp-validation-for="ClientImage"></span>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="button" onclick="confirmUpdate()" class="btn btn-primary px-5">
                            <i class="bx bx-save"></i> Güncelle
                        </button>
                        <a href="/Admin/Client/Index" class="btn btn-outline-secondary px-5">
                            <i class="bx bx-x"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById("preview").src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function confirmUpdate() {
        var form = document.getElementById("updateItemForm");
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        Swal.fire({
            title: "Güncellemek istediğinize emin misiniz?",
            text: "Mevcut kayıt güncellenecektir.",
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#0d6efd",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Evet, Güncelle!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
    }
</script>
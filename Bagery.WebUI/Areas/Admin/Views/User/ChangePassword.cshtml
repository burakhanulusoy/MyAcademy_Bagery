@model ChangePasswordCommand
@{
    ViewData["Title"] = "Şifre Değiştir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .pw-wrap {
        max-width: 460px;
        margin: 0 auto;
        padding: 48px 0;
    }

    .pw-card {
        border: 1px solid rgba(128,128,128,.18);
        border-radius: 16px;
        overflow: hidden;
        background: inherit;
    }

    .pw-head {
        padding: 28px 32px 24px;
        border-bottom: 1px solid rgba(128,128,128,.15);
    }

        .pw-head .pw-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(128,128,128,.12);
            font-size: 20px;
            margin-bottom: 14px;
        }

        .pw-head h5 {
            margin: 0 0 4px;
            font-weight: 600;
        }

        .pw-head p {
            margin: 0;
            font-size: 13px;
            opacity: .65;
        }

    .pw-body {
        padding: 28px 32px 32px;
    }

        .pw-body .form-control {
            border-radius: 10px;
            border: 1px solid rgba(128,128,128,.25);
            background: transparent;
            color: inherit;
            padding: 14px 16px;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .pw-body .form-control:focus {
                border-color: rgba(128,128,128,.55);
                box-shadow: 0 0 0 4px rgba(128,128,128,.10);
                background: transparent;
                color: inherit;
            }

        .pw-body .form-floating > label {
            color: inherit;
            opacity: .6;
        }

    .pw-strength {
        height: 4px;
        border-radius: 4px;
        background: rgba(128,128,128,.18);
        overflow: hidden;
        margin: -6px 2px 18px;
    }

        .pw-strength span {
            display: block;
            height: 100%;
            width: 0;
            transition: width .3s ease, background-color .3s ease;
        }

    .pw-actions {
        display: grid;
        gap: 10px;
        margin-top: 6px;
    }

        .pw-actions .btn {
            border-radius: 10px;
            padding: 12px 20px;
            font-weight: 500;
        }
</style>

<div class="pw-wrap">
    <div class="pw-card">

        <div class="pw-head">
            <div class="pw-icon"><ion-icon name="lock-closed-outline"></ion-icon></div>
            <h5>Şifrenizi Değiştirin</h5>
            <p>Güvenliğiniz için en az 8 karakter, harf ve rakam karışımı kullanın.</p>
        </div>

        <div class="pw-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger border-0 rounded-3 small"></div>
            }

            <form asp-action="ChangePassword" method="post">

                <div class="form-floating mb-3">
                    <input asp-for="NowPassword" type="password" class="form-control" placeholder="Mevcut Şifre" />
                    <label asp-for="NowPassword">Mevcut Şifre</label>
                </div>

                <div class="form-floating mb-2">
                    <input asp-for="NewPassword" type="password" class="form-control" id="newPassword" placeholder="Yeni Şifre" />
                    <label asp-for="NewPassword">Yeni Şifre</label>
                </div>
                <div class="pw-strength"><span id="pwBar"></span></div>

                <div class="form-floating mb-4">
                    <input asp-for="NewConfirmPassword" type="password" class="form-control" placeholder="Yeni Şifre (Tekrar)" />
                    <label asp-for="NewConfirmPassword">Yeni Şifre (Tekrar)</label>
                </div>

                <div class="pw-actions">
                    <button type="submit" class="btn btn-primary">Şifreyi Güncelle</button>
                    <a asp-controller="User" asp-action="UpdateUser" class="btn btn-link text-decoration-none">
                        Vazgeç
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const field = document.getElementById("newPassword");
        const bar   = document.getElementById("pwBar");
        if (!field || !bar) return;

        field.addEventListener("input", function () {
            const v = field.value;
            let score = 0;
            if (v.length >= 8)            score++;
            if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
            if (/\d/.test(v))             score++;
            if (/[^A-Za-z0-9]/.test(v))   score++;

            const levels = [
                { w: "0%",   c: "transparent" },
                { w: "25%",  c: "#e05252" },
                { w: "50%",  c: "#e0a052" },
                { w: "75%",  c: "#c9c452" },
                { w: "100%", c: "#4caf7d" }
            ];
            bar.style.width           = levels[score].w;
            bar.style.backgroundColor = levels[score].c;
        });
    });
</script>
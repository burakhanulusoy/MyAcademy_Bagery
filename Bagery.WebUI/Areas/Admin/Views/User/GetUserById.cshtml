@using Bagery.WebUI.Enums
@using Bagery.WebUI.MediatorPattern.Results.UserResults
@model GetAdminUserDetailQueryResult
@{
    ViewData["Title"] = "Kullanıcı Profili";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var avatar = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "https://ui-avatars.com/api/?size=160&background=random&name=" + Uri.EscapeDataString(Model.FullName)
        : Model.ImageUrl;

    var isWriter = Model.Roles.Contains("Writer");
}
@functions {
    static string RoleClass(string role) => role switch
    {
        "Admin" => "is-admin",
        "Writer" => "is-writer",
        "Waiter" => "is-waiter",
        _ => "is-user"
    };

    static string RoleText(string role) => role switch
    {
        "Admin" => "Admin",
        "Writer" => "Yazar",
        "Waiter" => "Garson",
        "User" => "Üye",
        _ => role
    };
}

<link href="~/css/bagery-admin-users.css" rel="stylesheet">

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="bd">

            <div class="bd-grid">
                <section class="span-12 bd-hero" style="padding: 28px 32px">
                    <div class="au-hero">
                        <span class="au-hero-avatar"><img src="@avatar" alt=""></span>
                        <div style="min-width: 0">
                            <p class="bd-eyebrow">@(string.IsNullOrWhiteSpace(Model.Job) ? "Kullanıcı" : Model.Job)</p>
                            <h1>@Model.FullName</h1>
                            <div>
                                @if (Model.Roles.Any())
                                {
                                    foreach (var role in Model.Roles)
                                    {
                                        <span class="au-role @RoleClass(role)">@RoleText(role)</span>
                                    }
                                }
                                else
                                {
                                    <span class="au-role is-none">Rol atanmamış</span>
                                }
                                @if (!Model.EmailConfirmed)
                                {
                                    <span class="au-role is-none">E-posta onaysız</span>
                                }
                            </div>
                            <div class="au-hero-contact">
                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <span><i class='bx bx-envelope'></i> <a href="mailto:@Model.Email">@Model.Email</a></span>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                {
                                    <span><i class='bx bx-phone'></i> <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></span>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Address))
                                {
                                    <span><i class='bx bx-map'></i> @Model.Address</span>
                                }
                            </div>
                        </div>
                        <div style="margin-left: auto; display: flex; flex-wrap: wrap; gap: 10px">
                            <a href="/Admin/User/AssignRole/@Model.Id" class="au-chip"><i class='bx bx-key'></i> Rol işlemleri</a>
                            <a href="/Admin/User/Index" class="au-chip"><i class='bx bx-arrow-back'></i> Listeye dön</a>
                            <button type="button" class="au-chip" onclick="confirmDelete('@Model.Id')"><i class='bx bx-trash'></i> Sil</button>
                        </div>
                    </div>
                </section>
            </div>

            @* Göstergeler *@
            <div class="au-stats" style="grid-template-columns: repeat(4, minmax(0, 1fr))">
                <div class="au-stat" style="--tone: var(--c1)"><small>Ödenen sipariş</small><strong>@Model.PaidOrders</strong></div>
                <div class="au-stat" style="--tone: var(--c4)"><small>Toplam harcama</small><strong>@Model.TotalSpent.ToString("N2") ₺</strong></div>
                <div class="au-stat" style="--tone: var(--c3)"><small>Blog</small><strong>@Model.BlogCount</strong></div>
                <div class="au-stat" style="--tone: var(--c2)"><small>Yazdığı yorum</small><strong>@Model.CommentsWritten</strong></div>
            </div>

            <div class="bd-grid">

                @* Son siparişler *@
                <section class="span-7 bd-card">
                    <div class="bd-card-head">
                        <div>
                            <h2 class="bd-card-title">Son siparişleri</h2>
                            <p class="bd-card-sub">Ortalama sepet @Model.AverageBasket.ToString("N2") ₺ · @Model.PendingOrders bekleyen · @Model.FailedOrders başarısız</p>
                        </div>
                    </div>

                    @if (!Model.Orders.Any())
                    {
                        <p class="bd-sub">Bu kullanıcı hiç sipariş vermemiş.</p>
                    }
                    else
                    {
                        <ul class="au-list">
                            @foreach (var order in Model.Orders)
                            {
                                <li>
                                    <div class="main">
                                        <strong>
                                            <a href="/Admin/Order/Detail?orderNo=@order.OrderNo">#@order.OrderNo.Substring(0, 8).ToUpperInvariant()</a>
                                        </strong>
                                        <small>
                                            @order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @order.ItemCount ürün
                                            @if (order.Status == OrderStatus.Paid)
                                            {
                                                <text>· @order.DeliveryStatus.ToTurkish()</text>
                                            }
                                        </small>
                                    </div>
                                    <div class="side">
                                        <span class="bd-pill is-@order.Status.ToString().ToLower()">@order.Status.ToTurkish()</span>
                                        <div>@order.PaidPrice.ToString("N2") ₺</div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>

                @* Sosyal medya + hakkında *@
                <section class="span-5 bd-card">
                    <div class="bd-card-head"><h2 class="bd-card-title">Profil bilgileri</h2></div>

                    <p class="au-quote" style="margin-bottom: 18px">
                        @(string.IsNullOrWhiteSpace(Model.AboutMe) ? "Kullanıcı hakkında bilgi girmemiş." : Model.AboutMe)
                    </p>

                    <div class="au-social">
                        @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                        {
                            <a href="@Model.InstagramUrl" target="_blank" rel="noopener"><i class='bx bxl-instagram'></i> Instagram</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.TwitterUrl))
                        {
                            <a href="@Model.TwitterUrl" target="_blank" rel="noopener"><i class='bx bxl-twitter'></i> X / Twitter</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                        {
                            <a href="@Model.FacebookUrl" target="_blank" rel="noopener"><i class='bx bxl-facebook'></i> Facebook</a>
                        }
                        @if (string.IsNullOrWhiteSpace(Model.InstagramUrl) && string.IsNullOrWhiteSpace(Model.TwitterUrl) && string.IsNullOrWhiteSpace(Model.FacebookUrl))
                        {
                            <span class="bd-sub">Sosyal medya bilgisi yok.</span>
                        }
                    </div>
                </section>

                @* Yazarsa blogları *@
                @if (isWriter || Model.BlogCount > 0)
                {
                    <section class="span-7 bd-card">
                        <div class="bd-card-head">
                            <div>
                                <h2 class="bd-card-title">Blogları</h2>
                                <p class="bd-card-sub">@Model.BlogCount blog · bloglarına @Model.CommentsReceived yorum gelmiş</p>
                            </div>
                            <a href="/Admin/Blog/Index" class="bd-card-link">Bloglar <i class='bx bx-right-arrow-alt'></i></a>
                        </div>

                        @if (!Model.Blogs.Any())
                        {
                            <p class="bd-sub">Bu yazar henüz blog yazmamış.</p>
                        }
                        else
                        {
                            <ul class="au-list">
                                @foreach (var blog in Model.Blogs)
                                {
                                    <li>
                                        <div class="main">
                                            <strong><a href="/Blog/Detail/@blog.Id" target="_blank" rel="noopener">@blog.Title</a></strong>
                                            <small>@blog.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                                        </div>
                                        <div class="side">@blog.CommentCount yorum</div>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                @* Yazdığı yorumlar *@
                <section class="@(isWriter || Model.BlogCount > 0 ? "span-5" : "span-12") bd-card">
                    <div class="bd-card-head">
                        <div>
                            <h2 class="bd-card-title">Son yorumları</h2>
                            <p class="bd-card-sub">Toplam @Model.CommentsWritten yorum</p>
                        </div>
                    </div>

                    @if (!Model.Comments.Any())
                    {
                        <p class="bd-sub">Bu kullanıcı hiç yorum yazmamış.</p>
                    }
                    else
                    {
                        <ul class="au-list">
                            @foreach (var comment in Model.Comments)
                            {
                                <li style="display: block">
                                    <div class="main">
                                        <strong><a href="/Blog/Detail/@comment.BlogId" target="_blank" rel="noopener">@comment.BlogTitle</a></strong>
                                        <small>@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                    </div>
                                    <p class="au-quote">@comment.Content</p>
                                </li>
                            }
                        </ul>
                    }
                </section>

            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmDelete(userId) {
        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu kullanıcı silinecek.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Evet, sil',
            cancelButtonText: 'İptal'
        }).then((result) => {
            if (!result.isConfirmed) return;

            fetch('/Admin/User/RemoveUser/' + userId, { method: 'GET' })
                .then(response => {
                    if (response.ok) {
                        Swal.fire({ title: 'Silindi', text: 'Kullanıcı silindi.', icon: 'success' })
                            .then(() => window.location.href = '/Admin/User/Index');
                    } else {
                        Swal.fire('Hata', 'Silme işlemi başarısız oldu.', 'error');
                    }
                })
                .catch(() => Swal.fire('Hata', 'Sunucuya ulaşılamadı.', 'error'));
        });
    }
</script>
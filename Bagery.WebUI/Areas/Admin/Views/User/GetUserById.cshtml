@model Bagery.WebUI.MediatorPattern.Results.UserResults.GetUserByIdQueryResult
@{
    ViewData["Title"] = "Kullanıcı Profili";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var avatar = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "https://ui-avatars.com/api/?size=128&background=random&name=" + Uri.EscapeDataString(Model.FullName ?? "?")
        : Model.ImageUrl;
}

<div class="page-content-wrapper">
    <div class="page-content">

        <div class="d-flex align-items-center justify-content-between mb-4">
            <h5 class="mb-0">Kullanıcı Profili</h5>
            <a href="/Admin/User/Index" class="btn btn-sm btn-outline-secondary">
                <ion-icon name="arrow-back-outline"></ion-icon> Listeye Dön
            </a>
        </div>

        <div class="row g-4">

            <div class="col-12 col-lg-8">
                <div class="card radius-10">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                            <img src="@avatar" class="rounded-circle" width="72" height="72"
                                 style="object-fit: cover;" alt="">
                            <div class="flex-grow-1">
                                <h4 class="mb-1">@Model.FullName</h4>
                                <p class="mb-2 text-muted small">
                                    @(string.IsNullOrWhiteSpace(Model.Job) ? "Meslek belirtilmemiş" : Model.Job)
                                </p>
                                <div>
                                    @if (Model.Roles != null && Model.Roles.Any())
                                    {
                                        foreach (var role in Model.Roles)
                                        {
                                            <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle me-1">@role</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Rol atanmamış</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-sm-6">
                                <div class="text-muted small">E-posta</div>
                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="text-muted small">Adres</div>
                                <span>@(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)</span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a href="/Admin/User/AssignRole/@Model.Id" class="btn btn-sm btn-outline-warning">
                                <ion-icon name="key-outline"></ion-icon> Rol İşlemleri
                            </a>
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="btn btn-sm btn-outline-primary">
                                    <ion-icon name="mail-outline"></ion-icon> Mail Gönder
                                </a>
                            }
                            <button type="button" onclick="confirmDelete('@Model.Id')" class="btn btn-sm btn-outline-danger ms-auto">
                                <ion-icon name="trash-outline"></ion-icon> Sil
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card radius-10 mt-4">
                    <div class="card-body">
                        <h6 class="mb-2">Hakkımda</h6>
                        <p class="mb-0 text-muted">
                            @(string.IsNullOrWhiteSpace(Model.AboutMe) ? "Kullanıcı henüz bilgi girmemiş." : Model.AboutMe)
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card radius-10">
                    <div class="card-body">
                        <h6 class="mb-3">Sosyal Medya</h6>

                        <div class="d-flex align-items-center mb-3">
                            <ion-icon name="logo-facebook" class="me-2 fs-5 text-primary"></ion-icon>
                            @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                            {
                                <a href="@Model.FacebookUrl" target="_blank" class="text-decoration-none">Facebook</a>
                            }
                            else
                            {
                                <span class="text-muted">Belirtilmemiş</span>
                            }
                        </div>

                        <div class="d-flex align-items-center mb-3">
                            <ion-icon name="logo-twitter" class="me-2 fs-5 text-info"></ion-icon>
                            @if (!string.IsNullOrWhiteSpace(Model.TwitterUrl))
                            {
                                <a href="@Model.TwitterUrl" target="_blank" class="text-decoration-none">Twitter</a>
                            }
                            else
                            {
                                <span class="text-muted">Belirtilmemiş</span>
                            }
                        </div>

                        <div class="d-flex align-items-center">
                            <ion-icon name="logo-instagram" class="me-2 fs-5 text-danger"></ion-icon>
                            @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                            {
                                <a href="@Model.InstagramUrl" target="_blank" class="text-decoration-none">Instagram</a>
                            }
                            else
                            {
                                <span class="text-muted">Belirtilmemiş</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmDelete(userId) {
        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu kullanıcı kalıcı olarak silinecek.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Evet, sil',
            cancelButtonText: 'İptal'
        }).then((result) => {
            if (!result.isConfirmed) return;

            fetch('/Admin/User/RemoveUser/' + userId, { method: 'GET' })
                .then(response => {
                    if (response.ok) {
                        Swal.fire({ title: 'Silindi', text: 'Kullanıcı başarıyla silindi.', icon: 'success' })
                            .then(() => window.location.href = '/Admin/User/Index');
                    } else {
                        Swal.fire('Hata', 'Silme işlemi başarısız oldu.', 'error');
                    }
                })
                .catch(() => Swal.fire('Hata', 'Sunucuya ulaşılamadı.', 'error'));
        });
    }
</script>
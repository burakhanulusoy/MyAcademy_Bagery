@model PagedList<GetUsersQueryResult>
@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var customOption = PagedListRenderOptions.Bootstrap4PageNumbersPlusPrevAndNext;
    customOption.LinkToPreviousPageFormat = "« Önceki";
    customOption.LinkToNextPageFormat = "Sonraki »";
    var placeholder = "https://ui-avatars.com/api/?background=random&name=";
}

<div class="page-content-wrapper">
    <div class="page-content">

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h5 class="mb-1">Kullanıcılar</h5>
                <p class="mb-0 text-muted small">Sisteme kayıtlı @Model.TotalItemCount kişi</p>
            </div>
            <div class="input-group" style="max-width: 320px;">
                <span class="input-group-text"><ion-icon name="search-outline"></ion-icon></span>
                <input type="text" id="globalSearchInput" class="form-control"
                       placeholder="İsim veya e-posta ara..."
                       value="@ViewData["CurrentSearch"]">
            </div>
        </div>

        <div class="card radius-10">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Ad Soyad</th>
                            <th>E-posta</th>
                            <th>Meslek</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrWhiteSpace(user.ImageUrl) ? placeholder + Uri.EscapeDataString(user.FullName ?? "?") : user.ImageUrl)"
                                             class="rounded-circle" width="40" height="40"
                                             style="object-fit: cover;" alt="">
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@user.FullName</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(user.Email))
                                        {
                                            <a href="mailto:@user.Email" class="text-decoration-none">@user.Email</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-muted">@(string.IsNullOrWhiteSpace(user.Job) ? "—" : user.Job)</td>
                                    <td class="text-end">
                                        <a href="/Admin/User/GetUserById/@user.Id" class="btn btn-sm btn-outline-primary">
                                            İncele
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    Arama kriterlerine uygun kullanıcı bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-center mt-4">
            <pager asp-action="Index" asp-controller="User" asp-area="Admin"
                   list="@Model" options="@customOption"
                   asp-route-search="@ViewData["CurrentSearch"]"></pager>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("globalSearchInput");
        const current = '@Html.Raw(ViewData["CurrentSearch"] ?? "")';
        let timer;

        input.addEventListener('keyup', function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                const term = input.value.trim();
                if (term !== current) {
                    window.location.href = '@Url.Action("Index", "User", new { area = "Admin" })?search=' + encodeURIComponent(term);
                }
            }, 500);
        });

        if (input.value.length > 0) {
            input.focus();
            const v = input.value;
            input.value = '';
            input.value = v;
        }
    });
</script>
@model GetProductByIdQueryResult
@{
    ViewData["Title"] = "Ürün Detayı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var stats = (GetProductSalesStatsQueryResult)ViewBag.Stats;
    var maxMonth = stats.Months.Count == 0 ? 0 : stats.Months.Max(m => m.Quantity);
    var images = new[] { Model.MainImageUrl, Model.ImageUrl1, Model.ImageUrl2 }
                 .Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
}
@functions {
    // style="height: 62%" -> CSS noktalı ister, Türkçe virgül bozar
    static string Pct(int value, int max) =>
        max <= 0 ? "3%" : Math.Max(3, value * 100 / max).ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";
}

<link href="~/css/bagery-admin-products.css" rel="stylesheet">

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="bd">

            <header class="bd-head">
                <div>
                    <p class="bd-eyebrow">@(Model.Category?.CategoryName ?? "Ürün")</p>
                    <h1 class="bd-title">@Model.ProductName</h1>
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 8px">
                    <a href="/Admin/ProductVariant/CreateVariantByProductId/@Model.Id" class="ap-btn is-ghost" style="height: 44px"><i class='bx bx-plus'></i> Seçenek ekle</a>
                    <a href="/Admin/Product/UpdateProduct/@Model.Id" class="ap-btn" style="height: 44px"><i class='bx bx-edit'></i> Güncelle</a>
                    <a href="/Admin/Product/Index" class="ap-btn is-ghost" style="height: 44px"><i class='bx bx-arrow-back'></i> Ürünler</a>
                </div>
            </header>

            <div class="bd-grid">

                @* SOL: görseller *@
                <section class="span-5">
                    <div class="ap-gallery-main">
                        <img id="apMainImage" src="@images.FirstOrDefault()" alt="@Model.ProductName">
                    </div>
                    @if (images.Count > 1)
                    {
                        <div class="ap-thumbs">
                            @foreach (var (image, index) in images.Select((x, i) => (x, i)))
                            {
                                <button type="button" class="ap-thumb @(index == 0 ? "is-active" : "")" data-image="@image">
                                    <img src="@image" alt="">
                                </button>
                            }
                        </div>
                    }
                </section>

                @* SAĞ: bilgiler *@
                <section class="span-7 bd-card">
                    <div class="ap-price-big">@Model.Price.ToString("N2") ₺</div>
                    <p class="bd-card-sub" style="margin-top: 4px">Sitedeki satış fiyatı (seçenek farkları hariç)</p>

                    <p style="margin: 18px 0 0; line-height: 1.7">@Model.Description</p>

                    <h3 class="bd-card-title" style="margin: 22px 0 10px; font-size: 16px">Seçenekler</h3>
                    @if (Model.ProductVariants is null || !Model.ProductVariants.Any())
                    {
                        <p class="bd-sub">Bu ürünün seçeneği yok, sadece standart haliyle satılıyor.</p>
                    }
                    else
                    {
                        <ul class="ap-variants">
                            @foreach (var variant in Model.ProductVariants)
                            {
                                <li class="@(variant.IsAvailable ? "" : "is-off")">
                                    <span>
                                        @variant.OptionName
                                        @if (!variant.IsAvailable)
                                        {
                                            <text>· satışta değil</text>
                                        }
                                    </span>
                                    <b>
                                        @(variant.AdditionalPrice > 0 ? "+" + variant.AdditionalPrice.ToString("N2") + " ₺" : "fark yok")
                                        @if (variant.AdditionalPrice > 0)
                                        {
                                            <text>(@((Model.Price + variant.AdditionalPrice).ToString("N2")) ₺)</text>
                                        }
                                    </b>
                                </li>
                            }
                        </ul>
                        <a href="/Admin/ProductVariant/GetVariantsByPorductId/@Model.Id" class="bd-card-link" style="display: inline-flex; margin-top: 10px">
                            Seçenekleri yönet <i class='bx bx-right-arrow-alt'></i>
                        </a>
                    }
                </section>
            </div>

            @* Gerçek satış verisi *@
            <div class="bd-grid">
                <section class="span-7 bd-card">
                    <div class="bd-card-head">
                        <div>
                            <h2 class="bd-card-title">Satış performansı</h2>
                            <p class="bd-card-sub">Sadece ödemesi onaylanan siparişler</p>
                        </div>
                        <a href="/Admin/Order/Index" class="bd-card-link">Siparişler <i class='bx bx-right-arrow-alt'></i></a>
                    </div>

                    <div class="ap-tools" style="margin: 0 0 18px">
                        <div class="ad-stat" style="--tone: var(--c1); flex: 1"><small>Satılan adet</small><strong>@stats.SoldQuantity</strong></div>
                        <div class="ad-stat" style="--tone: var(--c4); flex: 1"><small>Ciro</small><strong>@stats.Revenue.ToString("N2") ₺</strong></div>
                        <div class="ad-stat" style="--tone: var(--c3); flex: 1"><small>Sipariş</small><strong>@stats.OrderCount</strong></div>
                    </div>

                    <h3 class="bd-card-title" style="font-size: 15px; margin-bottom: 12px">Son 6 ay</h3>
                    @if (maxMonth == 0)
                    {
                        <p class="bd-sub">Son 6 ayda bu üründen satış olmamış.</p>
                    }
                    else
                    {
                        <div class="ap-bars">
                            @foreach (var month in stats.Months)
                            {
                                <div class="ap-bar" title="@month.Label: @month.Quantity adet">
                                    <b>@month.Quantity</b>
                                    <div class="fill" style="height: @Pct(month.Quantity, maxMonth)"></div>
                                    <span>@month.Label</span>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="span-5 bd-card">
                    <div class="bd-card-head"><h2 class="bd-card-title">Hazırlanış</h2></div>
                    <p style="line-height: 1.7; margin: 0 0 20px">
                        @(string.IsNullOrWhiteSpace(Model.PreperationDescription) ? "Hazırlanış bilgisi girilmemiş." : Model.PreperationDescription)
                    </p>

                    <ul class="bo-info" style="margin-bottom: 20px">
                        <li><i class='bx bx-category'></i><div><small>Kategori</small><span>@(Model.Category?.CategoryName ?? "-")</span></div></li>
                        <li><i class='bx bx-time-five'></i><div><small>Son satış</small><span>@(stats.LastSoldAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Henüz satılmadı")</span></div></li>
                        <li><i class='bx bx-barcode'></i><div><small>Ürün no</small><span class="mono">@Model.Id.ToString()[..8].ToUpperInvariant()</span></div></li>
                    </ul>

                    <div style="display: flex; gap: 8px">
                        <a href="/Product/Detail/@Model.Id" target="_blank" rel="noopener" class="ap-btn is-ghost"><i class='bx bx-show'></i> Sitede gör</a>
                        <button type="button" class="ap-btn is-danger" onclick="confirmDelete('@Model.Id')"><i class='bx bx-trash'></i> Sil</button>
                    </div>
                </section>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Küçük görsele tıklayınca büyük görsel değişsin
    document.querySelectorAll('.ap-thumb').forEach(function (thumb) {
        thumb.addEventListener('click', function () {
            document.getElementById('apMainImage').src = thumb.dataset.image;
            document.querySelectorAll('.ap-thumb').forEach(t => t.classList.remove('is-active'));
            thumb.classList.add('is-active');
        });
    });

    function confirmDelete(productId) {
        Swal.fire({
            title: 'Ürün silinsin mi?',
            text: 'Ürün siteden kaldırılır. Geçmiş siparişler etkilenmez.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Evet, sil',
            cancelButtonText: 'İptal'
        }).then((result) => {
            if (result.isConfirmed) window.location.href = '/Admin/Product/DeleteProduct/' + productId;
        });
    }
</script>
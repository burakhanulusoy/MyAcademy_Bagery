@using Bagery.WebUI.MediatorPattern.Results.CategoryResults
@model PagedList<GetProductsQueryResult>
@{
    ViewData["Title"] = "Ürünler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var search = ViewData["Search"] as string;
    var categoryId = ViewData["CategoryId"] as Guid?;
    var sort = ViewData["Sort"] as string;
    var categories = (List<GetCategoriesQueryResult>)ViewBag.CategoryList;

    var options = PagedListRenderOptions.Bootstrap4PageNumbersPlusPrevAndNext;
    options.LinkToPreviousPageFormat = "« Önceki";
    options.LinkToNextPageFormat = "Sonraki »";
}
@functions {
    string ChipClass(Guid? id) => (ViewData["CategoryId"] as Guid?) == id ? "ap-chip is-active" : "ap-chip";
}

<link href="~/css/bagery-admin-products.css" rel="stylesheet">

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="bd">

            <header class="bd-head">
                <div>
                    <p class="bd-eyebrow">Site Yönetimi</p>
                    <h1 class="bd-title">Ürünler</h1>
                    <p class="bd-sub">
                        @ViewBag.TotalCount ürün
                        @if (ViewBag.FilteredCount != ViewBag.TotalCount)
                        {
                            <text>· süzülmüş: @ViewBag.FilteredCount</text>
                        }
                    </p>
                </div>
                <a href="/Admin/Product/CreateProduct" class="ap-btn" style="height: 44px; padding: 0 22px">
                    <i class='bx bx-plus-circle'></i> Yeni ürün ekle
                </a>
            </header>

            <div class="ap-tools">
                @* Arama: normal form, Enter ile arar *@
                <form method="get" asp-action="Index" class="ap-search">
                    <i class='bx bx-search'></i>
                    <input type="search" name="search" value="@search" placeholder="Ürün adı ya da açıklama ara..." autocomplete="off">
                    <input type="hidden" name="categoryId" value="@categoryId">
                    <input type="hidden" name="sort" value="@sort">
                </form>

                <nav class="ap-chips" aria-label="Kategori süzme">
                    <a class="@ChipClass(null)" href="@Url.Action("Index", new { search, sort })">Tümü</a>
                    @foreach (var category in categories)
                    {
                        <a class="@ChipClass(category.Id)" href="@Url.Action("Index", new { search, sort, categoryId = category.Id })">@category.CategoryName</a>
                    }
                </nav>

                @* Sıralama: seçince form kendiliğinden gönderilir *@
                <form method="get" asp-action="Index">
                    <input type="hidden" name="search" value="@search">
                    <input type="hidden" name="categoryId" value="@categoryId">
                    <select name="sort" class="ap-sort" onchange="this.form.submit()" aria-label="Sıralama">
                        <option value="" selected="@(string.IsNullOrEmpty(sort))">Varsayılan sıra</option>
                        <option value="name" selected="@(sort == "name")">İsme göre (A-Z)</option>
                        <option value="price-asc" selected="@(sort == "price-asc")">Fiyat: artan</option>
                        <option value="price-desc" selected="@(sort == "price-desc")">Fiyat: azalan</option>
                    </select>
                </form>
            </div>

            @if (!Model.Any())
            {
                <div class="bd-card">
                    <div class="ap-empty">
                        <i class='bx bx-package'></i>
                        Aramana uyan ürün bulunamadı.
                    </div>
                </div>
            }
            else
            {
                <div class="ap-grid">
                    @foreach (var product in Model)
                    {
                        <article class="ap-card">
                            <a class="ap-card-img" href="/Admin/Product/ProductDetail/@product.Id">
                                <img src="@product.MainImageUrl" alt="@product.ProductName" loading="lazy">
                                @if (product.Category is not null)
                                {
                                    <span class="ap-card-cat">@product.Category.CategoryName</span>
                                }
                            </a>
                            <div class="ap-card-body">
                                <h3>@product.ProductName</h3>
                                <p class="ap-card-desc">@product.Description</p>
                                <div class="ap-card-price">@product.Price.ToString("N2") ₺</div>
                                <div class="ap-card-actions">
                                    <a href="/Admin/Product/ProductDetail/@product.Id" class="ap-btn">İncele</a>
                                    <a href="/Admin/Product/UpdateProduct/@product.Id" class="ap-btn is-ghost" title="Düzenle"><i class='bx bx-edit'></i></a>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <pager asp-action="Index" asp-controller="Product" asp-area="Admin"
                           list="@Model" options="@options"
                           asp-route-search="@search" asp-route-categoryId="@categoryId" asp-route-sort="@sort"></pager>
                </div>
            }

        </div>
    </div>
</div>
@model CreateProductCommand
@{
    ViewData["Title"] = "Yeni Ürün";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="~/css/bagery-admin-products.css" rel="stylesheet">

<div class="page-content-wrapper">
    <div class="page-content">
        <div class="bd">

            <header class="bd-head">
                <div>
                    <p class="bd-eyebrow">Site Yönetimi</p>
                    <h1 class="bd-title">Yeni ürün ekle</h1>
                    <p class="bd-sub">Soldaki bilgileri doldur, sağdan görselleri seç.</p>
                </div>
                <a href="/Admin/Product/Index" class="ap-btn is-ghost" style="height: 44px"><i class='bx bx-arrow-back'></i> Ürünler</a>
            </header>

            <form enctype="multipart/form-data" method="post" id="productForm">
                <div class="ap-form-grid">

                    <div class="bd-card">
                        <div class="ap-field">
                            <label asp-for="ProductName">Ürün adı</label>
                            <input type="text" asp-for="ProductName" placeholder="Ör. San Sebastian Cheesecake" />
                            <span class="badge bg-danger text-wrap text-start p-2" asp-validation-for="ProductName"></span>
                        </div>

                        <div class="ap-field">
                            <label asp-for="CategoryId">Kategori</label>
                            <select asp-for="CategoryId" asp-items="@ViewBag.Categories" required>
                                <option value="">Kategori seçiniz</option>
                            </select>
                            <span class="badge bg-danger text-wrap text-start p-2" asp-validation-for="CategoryId"></span>
                        </div>

                        <div class="ap-field">
                            <label asp-for="Price">Fiyat (₺)</label>
                            <input type="number" step="0.01" min="0" asp-for="Price" placeholder="0,00" />
                            <span class="hint">Seçenek farkları ürün seçeneklerinde ayrıca tanımlanır.</span>
                            <span class="badge bg-danger text-wrap text-start p-2" asp-validation-for="Price"></span>
                        </div>

                        <div class="ap-field">
                            <label asp-for="Description">Ürün açıklaması</label>
                            <textarea asp-for="Description" rows="4" placeholder="Müşterinin ürün sayfasında göreceği açıklama..."></textarea>
                            <span class="badge bg-danger text-wrap text-start p-2" asp-validation-for="Description"></span>
                        </div>

                        <div class="ap-field">
                            <label asp-for="PreperationDescription">Hazırlanış açıklaması</label>
                            <textarea asp-for="PreperationDescription" rows="4" placeholder="Ürün sayfasındaki 'Ürün Hazırlanışı' sekmesinde görünür..."></textarea>
                            <span class="badge bg-danger text-wrap text-start p-2" asp-validation-for="PreperationDescription"></span>
                        </div>
                    </div>

                    <aside class="bd-card">
                        <h2 class="bd-card-title" style="margin-bottom: 14px">Görseller</h2>

                        <div class="ap-drops">
                            <div class="is-main">
                                <label class="ap-drop">
                                    <img data-preview alt="" hidden>
                                    <span class="placeholder"><i class='bx bx-image-add'></i> Ana görsel</span>
                                    <input type="file" accept="image/*" asp-for="mainFile" />
                                </label>
                                <span class="badge bg-danger text-wrap text-start p-2" asp-validation-for="mainFile"></span>
                            </div>
                            <div>
                                <label class="ap-drop">
                                    <img data-preview alt="" hidden>
                                    <span class="placeholder"><i class='bx bx-image-add'></i> 1. görsel</span>
                                    <input type="file" accept="image/*" asp-for="File1" />
                                </label>
                            </div>
                            <div>
                                <label class="ap-drop">
                                    <img data-preview alt="" hidden>
                                    <span class="placeholder"><i class='bx bx-image-add'></i> 2. görsel</span>
                                    <input type="file" accept="image/*" asp-for="File2" />
                                </label>
                            </div>
                        </div>

                        <button type="button" onclick="confirmSave()" class="ap-btn" style="width: 100%; height: 46px; margin-top: 18px">
                            <i class='bx bx-save'></i> Ürünü kaydet
                        </button>
                        <a href="/Admin/Product/Index" class="ap-btn is-ghost" style="width: 100%; height: 46px; margin-top: 10px">İptal</a>
                    </aside>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    // Görsel seçilince anında önizleme
    document.querySelectorAll('.ap-drop input').forEach(function (input) {
        input.addEventListener('change', function () {
            const file = input.files[0];
            if (!file) return;
            const drop = input.closest('.ap-drop');
            const preview = drop.querySelector('[data-preview]');
            preview.src = URL.createObjectURL(file);
            preview.hidden = false;
            drop.classList.add('has-image');
        });
    });

    function confirmSave() {
        const form = document.getElementById('productForm');
        if (!form.checkValidity()) { form.reportValidity(); return; }

        Swal.fire({
            title: 'Ürün kaydedilsin mi?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Evet, kaydet',
            cancelButtonText: 'İptal'
        }).then((result) => { if (result.isConfirmed) form.submit(); });
    }
</script>